    value: '{0:SimpleNumber}'
  - key: POKER_PAYTABLE_PAYOUT_TITLE
    value: '{0}'
  - key: CONTENTS_GAME_TITLE
    value: Keno Mega Wheel
  - key: PAYTABLE_BET_INFO
    value: '<size=24><color=#00eaff>Bet Per Card: 100</color></size>'
  - key: PAYTABLE_WAY_INFO
    value: <size=24><color=#00eaff>100 Play Bet</color></size>
  - key: PAYTABLE_PAGE_TITLE_2
    value: <style=title><size=32>How to Play</style>
  - key: PAYTABLE_SYMBOL_DESCRIPTION_2
    value: "<size=22>- Player can play Keno Mega Wheel once bet is set up.\r\n- Before
      playing Keno Mega Wheel, one chooses 2-10 numbers from 1 to 80.\r\n-  Once clicking
      the \"PLAY\" button, 20 balls with random numbers from 1 to 80 are drawn.\r\n-
      If the numbers of dropped balls match with the numbers player chose, then player
      wins.\r\n- Depending on the number of matching numbers, win pay varies.\r </size>"
  - key: PAYTABLE_PAGE_TITLE_3
    value: <style=title><size=32>Payout Table</style>
  - key: PAYTABLE_SYMBOL_DESCRIPTION_3
    value: Number of Spots
  - key: PAYTABLE_SYMBOL_DESCRIPTION_3_1
    value: Hit
  - key: PAYTABLE_PAGE_TITLE_4_1
    value: '<style=title><size=32>SPIN OF FORTUNE WHEEL TRIGGER

      </style>'
  - key: PAYTABLE_SYMBOL_DESCRIPTION_4_1
    value: "<size=20>- Before balls with numbers are drawn, 3 random numbers from
      1 to 80, except the numbers \n    player already chose, are automatically and
      randomly selected. \r\n- After 20 balls with random numbers are dropped, if
      ALL numbers of Special Spots match with \n   the numbers of dropped balls, then
      Spin of Fortune Wheel Bonus Game is triggered.\r</size>"
  - key: PAYTABLE_PAGE_TITLE_4_2
    value: '<style=title><size=32>SPIN OF FORTUNE WHEEL

      </style>'
  - key: PAYTABLE_SYMBOL_DESCRIPTION_4_2
    value: "<size=20>- Wheel Spin awards 1 spin and Wheel consists of Multiplier wedges
      and one Jackpot wedge.\r\n- Once the Wheel stops, it points the winning wedge.\r\n-
      If Jackpot wedge is won, then award that Jackpot.\r\n- If Multiplier wedge is
      won, then award the Multiplier to the player's bet.\r</size>"
  - key: PAYTABLE_PAYOUT_FORMAT
    value: '<b><size=32>5 <style=coinColor>{2:CommaNumber}</style>

      4 <style=coinColor>{1:CommaNumber}</style>

      3 <style=coinColor>{0:CommaNumber}</style></size></b>'
