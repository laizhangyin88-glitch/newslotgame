  m_RaycastTarget: 0
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<size=18\x03>- When Gold Rush Bonus Game is triggered, the numbers player
    chose get locked and 10 spins are awarded.\n- During Gold Rush Bonus Game, player
    cannot change the numbers.\n- During Gold Rush Bonus Game, every spin, 1-3 random
    numbers on the board turn to Dynamites. \n- Each winning Dynamite(s) awards additional
    2-5 numbers on the board except where the numbers from \n    20 balls already
    occupy.\n- When Dynamite(s) explodes and awards extra numbers, duplicate numbers
    cannot be selected.\n- Once there is no remaining spins, Gold Rush Bonus Game
    ends.</size>"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 5316d286fa94a894888ee12767189de0, type: 2}
