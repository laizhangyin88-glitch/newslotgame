--- !u!114 &2124940328761598800
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 6678272385526563782}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 0
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<size=22>- Jackpot Bonus Games has two sets of Game Area.\n\n- Upper Area
    is where Star Symbols are stacked, showing \n   players progression.\n         -
    Mini Line: consists of 6 Green Star Spots where \n           Green Star Symbols
    are collected\n         - Grand Line: consists of 6 Yellow Star Spots where \n
    \          Yellow Star Symbols are collected\n         - Major Line: consists
    of 6 Red Star Spots where \n           Red Star Symbols are collected\n\n- Bottom
    Area is where Star Symbols appear.\n         - 1st Spot: only Green Star Symbols
    appear\n         - 2nd Spot: only Yellow Star Symbols appear\n         - 3rd Spot:
    only Red Star Symbols appear\n\n- For the first 5 Star Spots of each Line, Star
    Symbols \n  appear only with Coin Values.\n\n- For the 6th Star Spot of each Line,
    the Jackpot Star Spot, \n  Star Symbols appear with respective Jackpot.\n\n- Once
    all 6 Star Spots of a Line collected for the first time, \n   Star Symbols appear
    with Multipliers only. \n\n- Player can win additional free spins, depending on
    the\n   number of +1 Spin Symbols landing on reels.\n\n- Once there is no remaining
    Free Spins, player wins the\n   sum of values collected with multipliers, if any,
    and \n   Jackpot Bonus Games ends.\n</size>"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 02fa081458a33134885e014015614825, type: 2}
