  m_RaycastTarget: 0
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<size=21\n\n>- Player bets on every spot.\n\n- Win the total sum of all
    value symbols that appear on the spots.\r\n\n- Symbol value range varies according
    to the player bet level.\n\n- Star Symbols have Coin Values of 0.1 - 20x the Total
    Bet during \n   the Base Games.\r\n         - Red Star Symbols have Coin Values
    of 4x or less the Total\n            Bet.\n         - Yellow Star Symbols have
    Coin Values of 5x or more the \n            Total Bet.\r\n</size>"
  m_isRightToLeft: 0
