  - key: PAYTABLE_BET_INFO
    value: "<size=24><color=#00eaff>Base Bet: 50\r\n</color></size>"
  - key: PAYTABLE_WAY_INFO
    value: '<size=24><color=#00eaff>Bucks Pays

      </color></size>'
  - key: PAYTABLE_SYMBOL_NAME_8
    value: <style=title><size=32><b>SCATTER</style>
  - key: PAYTABLE_SYMBOL_NAME_9
    value: <style=title><size=32><b>BONUS</style>
  - key: PAYTABLE_SYMBOL_DESCRIPTION_8
    value: <size=18>3 Free Games symbols on reels 2, 3, and 4 triggers Free Games.
  - key: PAYTABLE_SYMBOL_DESCRIPTION_9
    value: <size=17>Bonus symbols on reels 1, 3 and 5 triggers the                           feature.
  - key: PAYTABLE_TITLE_PAGE_2_1
    value: '<style=title><size=32><b>BUCKS PAYS

      </size></style>'
  - key: PAYTABLE_PAGE_DESCRIPTION_2_1
    value: "<size=21\n\n>- Player bets on every spot.\n\n- Win the total sum of all
      value symbols that appear on the spots.\r\n\n- Symbol value range varies according
      to the player bet level.\n\n- Star Symbols have Coin Values of 0.1 - 20x the
      Total Bet during \n   the Base Games.\r\n         - Red Star Symbols have Coin
      Values of 4x or less the Total\n            Bet.\n         - Yellow Star Symbols
      have Coin Values of 5x or more the \n            Total Bet.\r\n</size>"
  - key: PAYTABLE_TITLE_PAGE_2_2
    value: '<style=title><size=32><b>SCATTER SYMBOL

      </size></style>'
  - key: PAYTABLE_PAGE_DESCRIPTION_2_2
    value: "<size=21>- 5 or more than Scatter Symbols on any spot triggers\n   Jackpot
      Bonus.\r\n\n- Scatter Symbols randomly determine the number of\n   Free Spins
      from 1 to 5.\r\n\n- Player enters the Jackpot Bonus Games with the sum of\n
      \  Free Spins on Scatters.\n\n- Enjoy up to 75 spins and win big!\r\n\r</size>"
  - key: PAYTABLE_TITLE_PAGE_3_1
    value: '<style=title><size=32><b>JACKPOT BONUS GAMES

      </size></style>'
  - key: PAYTABLE_PAGE_DESCRIPTION_3_1
    value: "<size=22>- Jackpot Bonus Games has two sets of Game Area.\n\n- Upper Area
      is where Star Symbols are stacked, showing \n   players progression.\n         -
      Mini Line: consists of 6 Green Star Spots where \n           Green Star Symbols
      are collected\n         - Grand Line: consists of 6 Yellow Star Spots where
      \n           Yellow Star Symbols are collected\n         - Major Line: consists
      of 6 Red Star Spots where \n           Red Star Symbols are collected\n\n- Bottom
      Area is where Star Symbols appear.\n         - 1st Spot: only Green Star Symbols
      appear\n         - 2nd Spot: only Yellow Star Symbols appear\n         - 3rd
      Spot: only Red Star Symbols appear\n\n- For the first 5 Star Spots of each Line,
      Star Symbols \n  appear only with Coin Values.\n\n- For the 6th Star Spot of
      each Line, the Jackpot Star Spot, \n  Star Symbols appear with respective Jackpot.\n\n-
      Once all 6 Star Spots of a Line collected for the first time, \n   Star Symbols
      appear with Multipliers only. \n\n- Player can win additional free spins, depending
      on the\n   number of +1 Spin Symbols landing on reels.\n\n- Once there is no
      remaining Free Spins, player wins the\n   sum of values collected with multipliers,
      if any, and \n   Jackpot Bonus Games ends.\n</size>"
