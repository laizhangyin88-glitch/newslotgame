  m_RaycastTarget: 0
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<size=20>\n-  User may select the Bingo Game when Choose Your Bonus is
    triggered.\n-  A 5x5 bingo card appears with 25 spots of randomly assigned numbers.\n-
    \ Mr. Goose randomly draws an egg.\n-  Corresponding eggs with identical numbers
    turn gold and reveal if they are\n   a credit prize or a multiplier.\n-  A bingo
    is won when there are 5 or more gold eggs in a straight line.\n-  Each winning
    bingo line awards: (Total Scatter Wins from base spin that triggered\n   the bonus
    + sum of credit values on the line) x (sum of multipliers on the line)."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 5316d286fa94a894888ee12767189de0, type: 2}
