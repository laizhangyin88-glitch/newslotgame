  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 0
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<size=20>\n-  During Base Games, 5 or more Scatter symbols in any position
    triggers a Scatter Win.\n-  Each Scatter symbol awards a coin value ranging from
    1 to 8 times the Total Bet.\n-  Total Scatter Wins is the sum of all Scatter symbols
    that appeared and triggered\n   the Bonus feature.\n-  In either Choose Your Bonus
    game, total win becomes a factor of the Total Scatter Wins\n   from Base Game
    spin that triggered the Bonus.\n        -  Free Games: Each Wild appearing in
    Free Games awards the Total Scatter Win\n           amount from Base Games.\n
    \       -  Bingo Game: Total Scatter Wins is added to calculate any Bingo line
    wins."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 5316d286fa94a894888ee12767189de0, type: 2}
  m_sharedMaterial: {fileID: 21000010116884160, guid: 5316d286fa94a894888ee12767189de0,
