      m_Calls: []
  m_text: '- <indent=1em>Each time player gets       anywhere on reels, it will be
    collected at the progression bar above the reels.</indent>

    - <indent=1em>Once
    all       are collected, <style=coinColor>OUTBACK BEAUTY FREE GAMES</style> is
    triggered.</indent>

    - <indent=1em>Special Symbol        can appear anywhere
    on reels and when it lands on a reel,           consumes one       from the progression
    bar, triggering <style=coinColor>SLOT-IN-SLOT FEATURE</style>.</indent>'
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 5316d286fa94a894888ee12767189de0, type: 2}
