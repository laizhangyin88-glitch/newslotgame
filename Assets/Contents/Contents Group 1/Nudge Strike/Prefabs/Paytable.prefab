  m_RaycastTarget: 0
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<size=18>- Except Wild Symbol, Multiplier appears as a Sub-Symbol with
    any other\n    symbols.\r\n- Multiplier Sub-Symbol comes in 3 types, X2, X3 or
    X5 and it can take one\n    of the three multipliers.\r\n- Multiplier Sub-Symbol
    is applied to the 3 of a Kind Wins.\r\n- Multiple Multiplier Sub-Symbols are
    added to each other and applied to\n    the 3 of a kind wins.\r\n    - For example,
    X2 and X3 are part of a win, then X5 is applied to the win.\r\n</size>"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 5316d286fa94a894888ee12767189de0, type: 2}
