  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<size=18>- Nudge Strike is a Multi Slot Game, consisting of 8 3x3 Reel
    Set Games.\n- Each Slot Game is independent from each other.\n   - Each spin,
    the total sum of the wins from 8 Slot Games is awarded.\n- Player bets all 8
    Slot Games, every spin.\n- At the very bottom, there is a button for Turbo Mode.\r\n-
    Turbo Mode is a mode that stops all 3 reels at once per Slot.\n    Also, Turbo
    Mode can be turned on/off at a player's discretion during \n    any spin like
    auto spin or regular spin.</size>"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 5316d286fa94a894888ee12767189de0, type: 2}
