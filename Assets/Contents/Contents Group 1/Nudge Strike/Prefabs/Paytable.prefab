  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<size=18>- Wild Symbol appears with an arrow with random direction, either
    upward\n    or downward.\n- Depending on the direction of an arrow on such Wild
    Symbol, Wild Nudge\n    occurs.\n    - If an arrow points upward, then Wild Symbol
    nudges upward.\n    - If an arrow points downward, then Wild Symbol nudges downward.\n-
    Wild Nudge can occur twice at most.\n    - Wild Nudge continues until Wild Symbol
    touches down the top or\n        bottom spot, then Nudge ends.\n- On any Slot
    Game, 3 Wild Symbols on Win Line #1  awards Jackpot.\n- At a spin, up to 8 Jackpots
    can be awarded. \n</size>"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 5316d286fa94a894888ee12767189de0, type: 2}
