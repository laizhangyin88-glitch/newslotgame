--- !u!114 &4203649827799978387
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2267819969713256878}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 0
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<size=18>\n- 4 or more Bucks Symbols anywhere on reels triggers Flamin'
    Hot Link\n    Bonus.\n- In Flamin' Hot Link Bonus, Bucks Symbol and Mystery Symbol
    \n    can appear.\n- Flamin' Hot Link Bonus consists of 8x5 reelsets with upper
    4x5\n    locked.\n- Unlock Count on a row is the required amount of symbols to
    collect,\n    to unlock such row.\n    - When Flamin' Hot Link Bonus is triggered,
    count the triggering\n        Bucks Symbols and deduct the same amount from the
    Unlock\n        Count.\n- In locked rows, symbols do appear but are excluded
    for Unlock Count.\n- If a row is unlocked and one or more symbols exist, then
    count such\n    symbols and deduct them from the Unlock Count.\n- Flamin' Hot
    Link Bonus ends when there is no remaining spin.\n- At the end, Mystery Symbol
    spins and determines the prize.\n    - Mystery Symbol can award Mini, Minor,
    Major, Mega Jackpot or\n       Credit Value.\n- Fully filled 40 spots awards
    Grand Jackpot.\n</size>"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 5316d286fa94a894888ee12767189de0, type: 2}
  m_sharedMaterial: {fileID: 21000010116884160, guid: 5316d286fa94a894888ee12767189de0,
