    m_PersistentCalls:
      m_Calls: []
  m_text: "<size=20>\n- If Cannon Bonus triggered during Free Games or Mega Free Games,\n
    \ Gold Cannon Bonus is randomly triggered.  \n\n- When Gold Cannon Bonus triggered,
    random number of Cannons become Gold Cannons. \n\n- Each Gold Cannon shoots 1
    or 2 2x Multiplier Wilds.\n\n- If the spot is already a Wild or              ,
    then the spot becomes 3x Multiplier Wild. \n\n- If Multiplier Wild is already
    on the spot, then increase the multiplier by two. \n\n- Multiplier varies up to
    x5. \n\n- Gold Cannons return to regular Cannons after Cannon Bonus.\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 5316d286fa94a894888ee12767189de0, type: 2}
  m_sharedMaterial: {fileID: 21000010116884160, guid: 5316d286fa94a894888ee12767189de0,
