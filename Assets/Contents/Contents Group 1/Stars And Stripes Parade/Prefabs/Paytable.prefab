  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<size=20>- The map is divided into 9 regions.\n\n- Collect               in
    Base Games and trigger Map Bonus.\n\n-During Map Bonus, pick one of the closed
    region and reveal the prize. \n\n- There are 3 prizes available: Credit, Jackpot
    and Free Games.\n\n- Map Level varies from 1 to 7. \n\n- With all regions open,
    player earns one Gold Cannon for Mega Free Games. \n\n- After level-up, trigger
    Mega Free Games and the map is reset after Mega Free Games. \n\n- Prizes of Map
    Bonus are awarded, based on Map Bet.\n\n- Map Bet refers to the average of the
    bets when collecting each                  .   "
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 5316d286fa94a894888ee12767189de0, type: 2}
  m_sharedMaterial: {fileID: 21000010116884160, guid: 5316d286fa94a894888ee12767189de0,
