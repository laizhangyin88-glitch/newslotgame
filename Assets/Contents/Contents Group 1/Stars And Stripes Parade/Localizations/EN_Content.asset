  - key: PAYTABLE_SYMBOL_NAME_11
    value: <style=title><size=32>SCATTER</style>
  - key: PAYTABLE_SYMBOL_NAME_0
    value: <style=title><size=32>CANNON & WILD</style>
  - key: PAYTABLE_SYMBOL_DESCRIPTION_11
    value: '<size=18>3 <style=coinColor>10 Free Games</style>

      Appears on reels <style=coinColor>1, 3, 5</style> only.'
  - key: PAYTABLE_SYMBOL_DESCRIPTION_0
    value: '<size=18>6  <style=coinColor>500</style>

      5  <style=coinColor>125</style>

      4  <style=coinColor>50</style>

      3  <style=coinColor>20</style>'
  - key: PAYTABLE_SYMBOL_DESCRIPTION_1
    value: "<size=18>\n-  3 or more Cannons in Base Games\n   triggers Cannon Bonus.\n-
      \ One or more Cannon in Free Games\n   triggers Cannon Bonus.\n-  Cannon can
      act as Wild.\n-  Cannon appears on reels 2, 4, 6 only.\n-  Wild substitutes
      for all symbols except\n   Scatter."
  - key: PAYTABLE_SYMBOL_DESCRIPTION_10
    value: '<size=18>Scatter Pay is multiplied by Total Bet.

      3 or more Scatters triggers Free Games.'
  - key: PAYTABLE_SCATTER_SYMBOL_PAYOUT_FORMAT
    value: '<b><size=22>6 <style=coinColor>{3:CommaNumber}</style>

      <size=22>5 <style=coinColor>{2:CommaNumber}</style>

      4 <style=coinColor>{1:CommaNumber}</style>

      3 <style=coinColor>{0:CommaNumber}</style></size></b>'
  - key: PAYTABLE_SYMBOL_PAYOUT_FORMAT
    value: '<b><size=22>6 <style=coinColor>{3:CommaNumber}</style>

      <size=22>5 <style=coinColor>{2:CommaNumber}</style>

      4 <style=coinColor>{1:CommaNumber}</style>

      3 <style=coinColor>{0:CommaNumber}</style></size></b>'
  - key: PAYTABLE_SPECIAL_SYMBOL_PAYOUT_FORMAT
    value: '<b><size=22>6 <style=coinColor>{3:CommaNumber}</style>

      <size=22>5 <style=coinColor>{2:CommaNumber}</style>

      4 <style=coinColor>{1:CommaNumber}</style>

      3 <style=coinColor>{0:CommaNumber}</style></size></b>'
  - key: PAYTABLE_TITLE_PEARLS_BONUS
    value: <style=title><size=42>COLLECT THE PEARLS BONUS</size></style>
  - key: PAYTABLE_DESCRIPTION_PEARLS_BONUS
    value: "<size=24>- 6 or more Pearl symbols triggers Collect the Pearls Bonus.\n-
      When triggered, user is awarded the sum total of credit values received \n  on
      Pearl symbols.\n- Initial Pearl symbols get locked while remaining spots spin
      3 times for free. \n- Receiving one or more Pearls in the empty spots re-sets
      number of\n  free spins to 3. \n- When bonus ends, combine all credit value
      on Pearl symbols.\n- 15 Pearls awards Grand Jackpot!"
  - key: PAYTABLE_TITLE_FREE_GAMES_BONUS
    value: <style=title><size=42>Free Games</size></style>
  - key: PAYTABLE_DESCRIPTION_FREE_GAMES_BONUS
    value: "<size=20>- 3                in Base Games triggers 10 spins of Free Games.\n\n-
      One or more               in Free Games triggers Cannon Bonus. \n\n- Cannons
      appeared in Cannon Bonus are accumulated throughout the Free Games. \n\n- When
      Cannon Bonus triggered, accumulated Cannons shoot Extra Wilds as well.\n\n-
      3                in Free Games awards additional 3 spins."
  - key: PAYTABLE_TITLE_CANNON_BONUS
    value: '<style=title><size=42>CANNON BONUS

      </size></style>'
  - key: PAYTABLE_DESCRIPTION_CANNON_BONUS
    value: "<size=20>- 3 or More             triggers Cannon Bonus.\n\n- The number
      of Cannons added is the same as that of           triggering Cannon Bonus.\n\n-
      Each Cannon shoots 1 or 2 Extra Wilds onto the Reel Set.\n\n- If there is already
      a Wild or            on the spot, then the spot becomes 2x Multiplier Wild.\n\n-
      If Wild is added to existing Multiplier Wild, then increase the Multiplier by
      one.\n\n- Multiplier varies up to x5.\n\n- If Multiplier Wild is a part of Win,
      then apply the Multiplier to Win pay.\n\n- If more than one Multiplier Wilds
      are part of Win, then add the Multipliers\n  and apply the sum of the Multipliers
      to the Win pay.\n\n- Cannons disappear after Cannon Bonus."
  - key: PAYTABLE_WAY_INFO
    value: <size=24><color=#00eaff>76 LINES</color></size>
  - key: PAYTABLE_BET_INFO
    value: '<size=24><color=#00eaff>Bet Per Line: 1</color></size>'
  - key: PAYTABLE_TITLE_LINES
    value: <style=title><size=42>LINES</size></style>
  - key: PAYTABLE_TITLE_GOLD_CANNON
    value: "<style=title><size=42>GOLD CANNON BONUS\r\n</size></style>"
  - key: PAYTABLE_DESCRIPTION_GOLD_CANNON
    value: "<size=20>\n- If Cannon Bonus triggered during Free Games or Mega Free
      Games,\n  Gold Cannon Bonus is randomly triggered.  \n\n- When Gold Cannon Bonus
      triggered, random number of Cannons become Gold Cannons. \n\n- Each Gold Cannon
      shoots 1 or 2 2x Multiplier Wilds.\n\n- If the spot is already a Wild or              ,
      then the spot becomes 3x Multiplier Wild. \n\n- If Multiplier Wild is already
      on the spot, then increase the multiplier by two. \n\n- Multiplier varies up
      to x5. \n\n- Gold Cannons return to regular Cannons after Cannon Bonus.\n"
  - key: PAYTABLE_TITLE_MAP BONUS
    value: '<style=title><size=42>MAP BONUS

      </size></style>'
  - key: PAYTABLE_DESCRIPTION_MAP BONUS
    value: "<size=20>- The map is divided into 9 regions.\n\n- Collect               in
      Base Games and trigger Map Bonus.\n\n-During Map Bonus, pick one of the closed
      region and reveal the prize. \n\n- There are 3 prizes available: Credit, Jackpot
      and Free Games.\n\n- Map Level varies from 1 to 7. \n\n- With all regions open,
      player earns one Gold Cannon for Mega Free Games. \n\n- After level-up, trigger
      Mega Free Games and the map is reset after Mega Free Games. \n\n- Prizes of
      Map Bonus are awarded, based on Map Bet.\n\n- Map Bet refers to the average
      of the bets when collecting each                  .   "
  - key: PAYTABLE_DESCRIPTION_MAP BONUS_1
    value: <size=20><b>Open the whole U.S.A. map and trigger Mega Free Games!</b>
  - key: PAYTABLE_TITLE_MEGA FREE GAMES
    value: '<style=title><size=42>MEGA FREE GAMES

      </size></style>'
  - key: PAYTABLE_DESCRIPTION_MEGA FREE GAMES
    value: "<size=20>- Mega Free Games awards 10 Free Spins.\n\n- When entering Mega
      Free Games, Gold Cannons are added depending on player's Map Level\n  and they
      stay after Cannon Bonus. \n\n- Same as Free Games, in Mega Free Games, both
      Cannon Bonus and Gold Cannon Bonus\n  may be triggered.\n\n- Accumulated Cannons
      shoot Extra Wilds when Cannon Bonus triggered.\n\n- 3               awards 3
      more spins.\n"
