  m_RaycastTarget: 0
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<size=21>-  Collect            for each symbol that is part of a line win
    during Base Games. Collecting enough                \n             awards Mega
    Free Games.\n-  Each Mega Free Game triggers 10 free spins and allows the player
    to select one re-spin bonus to be \n   triggered by default whenever a Bonus symbol
    appears. The chosen event will be triggered each \n   time, in addition to any
    other re-spin bonus/es that are triggered randomly.\n-  Mega Free Games begins
    with re-spin bonus gauges already filled with 2 Bonus symbols. Event\n    gauges
    re-set with 2 Bonus symbols once the respective re-spin bonus is triggered and
    completed."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 5316d286fa94a894888ee12767189de0, type: 2}
  m_sharedMaterial: {fileID: 21000010116884160, guid: 5316d286fa94a894888ee12767189de0,
