  - key: PAYTABLE_TITLE_PAGE_1_2
    value: '<style=title><size=32><b>WILD

      </size></style>'
  - key: PAYTABLE_DESCRIPTION_PAGE_1_2_1
    value: '<b><size=21><style=coinColor>20</style>

      </size></b>'
  - key: PAYTABLE_DESCRIPTION_PAGE_1_2_2
    value: '<size=21>Wild substitutes for all symbols except Scatter symbol.

      </size>'
  - key: PAYTABLE_TITLE_PAGE_2_1
    value: '<style=title><size=32><b>FULL SCREEN JACKPOT

      </size></style>'
  - key: PAYTABLE_PAGE_DESCRIPTION_2_1
    value: '<size=21>

      <b>9</b>  <style=coinColor>500 x Total Bet or <b>GRAND JACKPOT</b></style>

      <b>9</b>  <style=coinColor>300 x Total Bet or <b>MEGA JACKPOT</b></style>

      <b>9</b>  <style=coinColor>100 x Total Bet or <b>MAJOR JACKPOT</b></style>

      <b>9</b>  <style=coinColor>50 x Total Bet or <b>MINOR JACKPOT</b></style>

      <b>9</b>  <style=coinColor>50 x Total Bet or <b>MINOR JACKPOT</b></style>

      <b>9</b>  <style=coinColor>20 x Total Bet or <b>MINI JACKPOT</b></style>

      <b>9</b>  <style=coinColor>20 x Total Bet or <b>MINI JACKPOT</b></style>

      </size>'
  - key: PAYTABLE_PAGE_DESCRIPTION_2_2
    value: "<size=21>-  When 9 Wild, Seven, or identical Fruit symbols create a Full\n
      \  Screen, relevant Full Screen Jackpot is awarded instead of 8 \n   line pays.\n\n-
      \ Except Grand Jackpot, Full Screen Jackpot is not valid when\n   Wild is part
      of Full Screen unless 9 Wilds create a Full Screen.\n</size>"
  - key: PAYTABLE_TITLE_PAGE_3_1
    value: '<style=title><size=32><b>FULL SCREEN PAY

      </size></style>'
  - key: PAYTABLE_PAGE_DESCRIPTION_3_1_1
    value: '<size=21>

      <b>9</b>  <style=coinColor>15 x Total Bet</style>

      <b>9</b>  <style=coinColor>12 x Total Bet</style>

      <b>9</b>  <style=coinColor>10 x Total Bet</style>

      <b>9</b>  <style=coinColor>8 x Total Bet</style>

      <b>9</b>  <style=coinColor>4 x Total Bet</style>

      </size>'
  - key: PAYTABLE_PAGE_DESCRIPTION_3_1_2
    value: "<size=21>-  When 9 BARs, or Any BAR or Any Fruit symbols creates a\n   Full
      Screen, relevant Full Screen Pay is awarded instead of 8 \n   line pays.\r\n\n-
      \ Full Screen Pay is not valid when Wild is part of Full Screen.\n</size>"
  - key: PAYTABLE_TITLE_PAGE_3_2
    value: '<style=title><size=32><b>FREE GAMES

      </size></style>'
  - key: PAYTABLE_PAGE_DESCRIPTION_3_2
    value: "<size=21>-  Regardless of pay line, 5 or more                  triggers
      Free Games.\r\n\n-  All BAR symbols are removed from the Free Games reels.\r\n\n-
      \ During Free Games, regardless of pay line, when 5 or more\n                 awards
      additional Free Games.\r\n\n</size>"
