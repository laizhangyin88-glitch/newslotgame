  - key: PAYTABLE_TITLE_PAGE_1_1
    value: '<style=title><size=32><b>SCATTER

      </size></style>'
  - key: PAYTABLE_DESCRIPTION_PAGE_1_1
    value: '<size=21>

      <b>9</b>  <style=coinColor>100 x Total Bet + 20 Free Games</style>

      <b>8</b>  <style=coinColor>50 x Total Bet + 15 Free Games</style>

      <b>7</b>  <style=coinColor>30 x Total Bet + 12 Free Games</style>

      <b>6</b>  <style=coinColor>10 x Total Bet + 9 Free Games</style>

      <b>5</b>  <style=coinColor>5 x Total Bet + 7 Free Games</style>

