  - key: PAYTABLE_SYMBOL_NAME_0
    value: <style=title><size=32><color=#ff64d5>WILD</size></style></color>
  - key: PAYTABLE_SYMBOL_DESCRIPTION_0
    value: '<size=19>Appears on reels <b>2</b>, <b>3</b>, <b>4</b> and <b>5</b>

      and substitutes all symbols except                .'
  - key: PAYTABLE_SYMBOL_NAME_1
    value: <style=title><size=32><color=#ff64d5>SCATTER</size></style></color>
  - key: PAYTABLE_SYMBOL_DESCRIPTION_1
    value: '<size=19><b>3 Scatters</b> anywhere on reels triggers

      <b><style=coinColor>Mini Pick Bonus Game</style></b> where player can get

      either <b><style=coinColor>Colossal Delight Free Games</style></b> or

      <b><style=coinColor>Sweet Flavour Free Games</style></b>.'
  - key: PAYTABLE_TITLE_PAGE_1
    value: <style=title><size=32><color=#ff64d5>BUBBLE FEATURE</size></style></color>
  - key: PAYTABLE_DESCRIPTION_PAGE_1
    value: "<size=19>-One or more              can appear randomly in any spin at
      the bottom of reels.\n        -Only one bubble can appear per reel each spin.\n-Each
      spin, it moves up by one position along the reel.\n-<b><style=coinColor>Bubble
      Feature</style></b> is triggered if a bubble lands on              . In this
      case, player will get a prize\n written on the bubble.\n        -Bubbles can
      award <b>Coin Prize</b> or <b>Jackpot</b>."
  - key: PAYTABLE_SYMBOL_PAYOUT_FORMAT
    value: '<b><size=24>5 <style=coinColor>{2:CommaNumber}</style>

      4 <style=coinColor>{1:CommaNumber}</style>

      3 <style=coinColor>{0:CommaNumber}</style></size></b>'
  - key: PAYTABLE_TITLE_PAGE_2
    value: <style=title><size=32><color=#ff64d5>COLOSSAL DELIGHT FREE GAMES</size></style></color>
  - key: PAYTABLE_DESCRIPTION_PAGE_2
    value: "<size=19>-Through <b><style=coinColor>Mini Pick Bonus Game</style></b>,
      <b><style=coinColor>Colossal Delight Free Games</style></b> can be triggered.\n-During
      <b><style=coinColor>Colossal Delight Free Games</style></b>, one or more                         can
      appear randomly in any spin\n at the bottom of reels.\n        -Only one bubble
      can appear per reel each spin.\n-If              lands on              , then
      reelset will be expended up to <b>8x5</b>.\n-During <b><style=coinColor>Colossal
      Delight Free Games</style></b>, bubbles appear in <b>1x1</b>, <b>2x2</b> or
      <b>3x3</b> size.\n-No re-trigger allowed."
  - key: PAYTABLE_TITLE_PAGE_3
    value: <style=title><size=32><color=#ff64d5>SWEET FLAVOUR FREE GAMES</size></style></color>
  - key: PAYTABLE_DESCRIPTION_PAGE_3
    value: '<size=19>-Through <b><style=coinColor>Mini Pick Bonus Game</style></b>,
      <b><style=coinColor>Sweet Flavour Free Games</style></b> can be triggered.

      -During <b><style=coinColor>Sweet Flavour Free Games</style></b>, there <b>4</b>
      slot zones in total and only one is unlocked.

      -Every time when player gets              landing on              , new slot
      zone will be unlocked.

      -After all arrays are unlocked, each triggering              awards <b>3</b>
      additional Free Games.

      -During <b><style=coinColor>Sweet Flavour Free Games</style></b>, bubbles appear
      in <b>1x1</b> size.'
