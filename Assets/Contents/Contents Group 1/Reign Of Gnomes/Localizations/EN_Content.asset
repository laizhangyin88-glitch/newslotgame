  - key: PAYTABLE_SYMBOL_NAME_12
    value: <style=title><size=32>SCATTER
  - key: PAYTABLE_SYMBOL_NAME_0
    value: <style=title><size=32>WILD
  - key: PAYTABLE_SYMBOL_DESCRIPTION_12
    value: '<size=18>- 3 or more triggers Free Games.

      - Wins are multiplied by Total Bet.'
  - key: PAYTABLE_SYMBOL_DESCRIPTION_0
    value: "<size=18>Wild substitutes for all symbols \nexcept Scatter and appears
      on\nreels 2, 3, and 4 only."
  - key: PAYTABLE_SCATTER_SYMBOL_PAYOUT_FORMAT
    value: '<b><size=24>5 <style=coinColor>{2:CommaNumber}</style>

      4 <style=coinColor>{1:CommaNumber}</style>

      3 <style=coinColor>{0:CommaNumber}</style></size></b>'
  - key: PAYTABLE_SPECIAL_SYMBOL_PAYOUT_FORMAT
    value: '<b><size=24>5 <style=coinColor>{3:CommaNumber}</style>

      4 <style=coinColor>{2:CommaNumber}</style>

      3 <style=coinColor>{1:CommaNumber}</style>

      2 <style=coinColor>{0:CommaNumber}</style></size></b>'
  - key: PAYTABLE_ROYAL_SYMBOL_PAYOUT_FORMAT
    value: '<b><size=24>5 <style=coinColor>{2:CommaNumber}</style>

      4 <style=coinColor>{1:CommaNumber}</style>

      3 <style=coinColor>{0:CommaNumber}</style></size></b>'
  - key: PAYTABLE_TITLE_FREE_GAMES
    value: <style=title><size=42>FREE GAMES
  - key: PAYTABLE_DESCRIPTION_FREE_GAMES
    value: "<size=24>- 3 or more Scatters triggers the Dragon Spins Free Games.\n-
      In Free Games, the <style=highlight 1>Golden Wheel Bonus</style> is triggered
      with every spin.\n- The resulting bonus/feature is applied to one spin only.\n-
      The Wheel Bonus bonuses/features are:\n   - Ice Diamonds\n   - Spin to Win\n
      \  - Extra Wilds\n   - Multipliers 3x, 5x, or 6x"
  - key: PAYTABLE_TITLE_DIAMOND_BONUS
    value: <style=title><size=42>ICE DIAMONDS BONUS
  - key: PAYTABLE_DESCRIPTION_DIAMOND_BONUS
    value: '<size=24>- Crack the colored stones to find diamonds.

      - The more diamonds you find, the bigger the reward!

      - Failing to find the diamonds twice ends the bonus.'
  - key: PAYTABLE_TITLE_SPIN_TO_WIN_BONUS
    value: <style=title><size=42>SPIN TO WIN BONUS
  - key: PAYTABLE_DESCRIPTION_SPIN_TO_WIN_BONUS
    value: '<size=24>- Receive free spins until you have a win!

      - First spin begins with x1 Multiplier, and every spin, the Multiplier increases.'
  - key: PAYTABLE_TITLE_EXTRA_WILDS
    value: <style=title><size=42>EXTRA WILDS FEATURE
  - key: PAYTABLE_DESCRIPTION_EXTRA_WILDS
    value: <size=24>- Wild symbols are randomly added to reels 2, 3, and/or 4.
  - key: PAYTABLE_TITLE_MULTIPLIER
    value: <style=title><size=42>MULTIPLIER FEATURE
  - key: PAYTABLE_DESCRIPTION_MULTIPLIER
    value: <size=24>- x3, x5, or x6 Multiplier is applied to the respective spin's
      win.
  - key: PAYTABLE_TITLE_JACKPOTS
    value: <style=title><size=42>GRAND & MEGA JACKPOTS</size></style>
  - key: PAYTABLE_DESCRIPTION_JACKPOTS
    value: '<size=24>- Each spin provides the user an opportunity to win the Jackpot.

      - After each spin, either a GRAND or MEGA JACKPOT may be awarded.'
  - key: PAYTABLE_WAY_INFO
    value: <size=24><color=#00eaff>243 WAYS</color></size>
  - key: PAYTABLE_BET_INFO
    value: '<size=24><color=#00eaff>Base Bet: 40</color></size>'
  - key: CONTENTS_GAME_TITLE
    value: Reign Of Gnomes
