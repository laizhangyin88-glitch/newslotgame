    m_PersistentCalls:
      m_Calls: []
  m_text: '<size=20>

    - Whenever              appears, there is a chance the
    <b><color=purple>Stampede</color> Free Games</b> may be triggered.

    - Whenever             
    appears, there is a chance the <b><color=red>Gold</color> Free Games</b> may
    be triggered.

    - Whenever              appears, there is a chance the <b><color=green>Jackpot</color>
    Free Games</b> may be triggered.

    - If only <b><color=purple>Stampede</color>
    Free Games</b> is triggered in the spin, the <b><color=purple>Stampede</color>
    Free Games</b> is awarded.

    - If only <b><color=red>Gold</color> Free Games</b>
    is triggered in the spin, the <b><color=red>Gold</color> Free Games</b> is awarded.

    -
    If only <b><color=green>Jackpot</color> Free Games</b> is triggered in the spin,
    the <b><color=green>Jackpot</color> Free Games</b> is awarded.

    - If only
    <b><color=purple>Stampede</color> Free Games</b> and <b><color=red>Gold</color>
    Free Games</b> are triggered in the same spin, the <b><color=purple>Stampede</color>
    <color=red>Gold</color> Free Games</b> is awarded.

    - If only <b><color=purple>Stampede</color>
    Free Games</b> and <b><color=green>Jackpot</color> Free Games</b> are triggered
    in the same spin, the <b><color=purple>Stampede</color> <color=green>Jackpot</color>
    Free Games</b> is awarded.

    - If only <b><color=red>Gold</color> Free Games</b>
    and <b><color=green>Jackpot</color> Free Games</b> are triggered in the same
    spin, the <b><color=red>Gold</color> <color=green>Jackpot</color> Free Games</b>
    is awarded.

    - If <b><color=purple>Stampede</color> Free Games</b>, <b><color=red>Gold</color>
    Free Games</b> and <b><color=green>Jackpot</color> Free Games </b>are triggered
    in the same spin, the <b><color=purple>Stampede</color> <color=red>Gold</color>
    <color=green>Jackpot</color> Free Games</b> is awarded.

    </size>


'
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 5316d286fa94a894888ee12767189de0, type: 2}
