  - key: PAYTABLE_SYMBOL_NAME_12
    value: <style=title><size=32>SCATTER
  - key: PAYTABLE_SYMBOL_NAME_0
    value: <style=title><size=32>WILD
  - key: PAYTABLE_SYMBOL_NAME_FREE_SPIN
    value: '<style=title><size=32>WILD &

      +1 FREE SPIN'
  - key: PAYTABLE_SYMBOL_DESCRIPTION_12
    value: "<size=16>3 or more Scatters \ntriggers Free Games."
  - key: PAYTABLE_SYMBOL_DESCRIPTION_0
    value: "<size=16>- Wild substitutes for all\n  symbols except Scatter.\n- Appears
      on reels 1, 2,\n  4, and 5 only."
  - key: PAYTABLE_SYMBOL_DESCRIPTION_FREE_SPIN
    value: "<size=16>- Appears in Free Games on reel 3 only.\n- Rewards one additional
      free spin \n  per symbol."
  - key: PAYTABLE_SYMBOL_PAYOUT_FORMAT
    value: '<b><size=24>5 <style=coinColor>{2:CommaNumber}</style>

      4 <style=coinColor>{1:CommaNumber}</style>

      3 <style=coinColor>{0:CommaNumber}</style></size></b>'
  - key: PAYTABLE_TITLE_MAGIC_WILD
    value: <style=title><size=42>MAGIC WILD FLIP FEATURE</size></style>
  - key: PAYTABLE_DESCRIPTION_MAGIC_WILD
    value: "<size=24>- Full Wilds on reels 1 and/or 2 flips over to reels 4 and/or
      5 and vice versa.\n    - Full Wilds on reel 1 flips and copies over to reel
      5.\n    - Full Wilds on reel 2 flips and copies over to reel 4.\n    - Full
      Wilds on reel 4 flips and copies over to reel 2.\n    - Full Wilds on reel 5
      flips and copies over to reel 1.\n- Scatters underneath Full Wilds become sub-symbols
      to act as both \n  Scatter and Wild."
  - key: PAYTABLE_TITLE_FREE_GAMES
    value: <style=title><size=42>FREE GAMES BONUS</size></style>
  - key: PAYTABLE_DESCRIPTION_FREE_GAMES
    value: '<size=24>- 3 or more Scatters in any position triggers Free Games.

      - There is no Free Games re-trigger.'
  - key: PAYTABLE_TITLE_WILD_NUDGE
    value: <style=title><size=42>WILD NUDGE FEATURE</size></style>
  - key: PAYTABLE_DESCRIPTION_WILD_NUDGE
    value: '<size=24>- During Free Games, receiving 1 or 2 Wilds triggers the Nudge
      feature.

      - Reel will nudge up or down to create a full reel of Wilds.

      - Full Wilds in reels 1, 2, 4, or 5 triggers the Magic Wild Flip Feature.'
  - key: PAYTABLE_TITLE_ADD_FREE_GAMES
    value: <style=title><size=42>ADD FREE GAMES FEATURE</size></style>
  - key: PAYTABLE_DESCRIPTION_ADD_FREE_GAMES
    value: '<size=24>- Rose symbols appear on reel 3 in Free Games only.

      - Each Rose symbol rewards 1 additional Free Game and also acts as Wild.'
  - key: PAYTABLE_WAY_INFO
    value: <size=24><color=#00eaff>30 LINES</color></size>
  - key: PAYTABLE_BET_INFO
    value: '<size=24><color=#00eaff>Bet Per Line: 1</color></size>'
  - key: PAYTABLE_TITLE_LINES
    value: <style=title><size=42>LINES</size></style>
  - key: PAYTABLE_TITLE_JACKPOTS
    value: <style=title><size=42>GRAND & MEGA JACKPOTS</size></style>
  - key: PAYTABLE_DESCRIPTION_JACKPOTS
    value: '<size=24>- Each spin provides the user an opportunity to win the Jackpot.

      - After each spin, either a GRAND or MEGA JACKPOT may be awarded.'
  - key: CONTENTS_GAME_TITLE
    value: Twins Of Magic
  - key: PAYTABLE_TITLE_EXTRA_BET
    value: <style=title><size=42>EXTRA BET</size></style>
  - key: PAYTABLE_DESCRIPTION_EXTRA_BET
    value: "<size=24>- 50% of Line Bet is added as Extra Bet to enable more Rose symbols
      in Free\n   Games.</size>"
