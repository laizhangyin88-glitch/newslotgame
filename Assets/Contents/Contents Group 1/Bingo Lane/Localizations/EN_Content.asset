    value: <size=30>WINS FREE SPINS</size>
  - key: PAYTABLE_TITLE_PAGE_5
    value: <size=60>BONUS</size>
  - key: PAYTABLE_TITLE_PAGE_5_1
    value: <size=30>SPECIAL WILDS</size>
