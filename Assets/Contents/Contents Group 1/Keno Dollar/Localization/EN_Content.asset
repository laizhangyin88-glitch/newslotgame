    value: '{1}'
  - key: POKER_PAYTABLE_PAYOUT
    value: '{0:SimpleNumber}'
  - key: POKER_PAYTABLE_PAYOUT_TITLE
    value: '{0}'
  - key: CONTENTS_GAME_TITLE
    value: "\bKeno Dollar"
  - key: PAYTABLE_BET_INFO
    value: '<size=24><color=#00eaff>Bet Per Card: 100</color></size>'
  - key: PAYTABLE_WAY_INFO
    value: <size=24><color=#00eaff>100 Play Bet</color></size>
  - key: PAYTABLE_PAYOUT_FORMAT
    value: '<b><size=32>5 <style=coinColor>{2:CommaNumber}</style>

      4 <style=coinColor>{1:CommaNumber}</style>

      3 <style=coinColor>{0:CommaNumber}</style></size></b>'
  - key: PAYTABLE_PAGE_TITLE_1
    value: <style=title><size=32>How to Play</style>
  - key: PAYTABLE_SYMBOL_DESCRIPTION_1
    value: "<size=22>- Player can play Keno Dollar once bet is set up.\n- Before playing
      Keno Dollar, one chooses 10 numbers from 1 to 80.\n- Once clicking PLAY button,
      20 balls with random numbers from 1 to 80 are drawn. \n- If the numbers of dropped
      balls match with 10 numbers player chose, then player wins.\n- Depending on
      the number of matching numbers, win pay varies. </size>"
  - key: PAYTABLE_PAGE_TITLE_2
    value: <style=title><size=32>Payout Table</style>
  - key: PAYTABLE_SYMBOL_DESCRIPTION_2
    value: Hit
  - key: PAYTABLE_PAGE_TITLE_3
    value: <style=title><size=32>COLLECT DOLLARS FEATURE</style>
  - key: PAYTABLE_SYMBOL_DESCRIPTION_3
    value: "<size=22>- Once game begins, except the numbers player picked, 5 numbers
      are randomly \n    selected as Dollar Symbols.\n- After 20 balls are drawn,
      if all 5 Dollar Symbols are part of the winning numbers, then \n   Dollar Bonus
      is triggered.\n- If not all 5 Dollar Symbols make wins, then the amount of winning
      Dollar Symbols\n    is collected at the Collect Gauge.\n- When Collect Guage
      is fully filled, Dollar Bonus is triggered and Collect Guage gets reset.\n-
      Progress of the Collect Gauge is saved by each bet level.\n </size>"
  - key: PAYTABLE_PAGE_TITLE_4
    value: "<style=title><size=32>DOLLAR BONUS FEATURE\r</style>"
  - key: PAYTABLE_SYMBOL_DESCRIPTION_4
    value: "<size=20>- Dollar Bonus is triggered if all 5 Dollar Symbols are part
      of the winning numbers or when the\n    Collect Gauge is full.\n- 10 initial
      Free Games are awarded in Dollar Bonus.\n- When Dollar Bonus is triggered, player's
      numbers get reset and 20 random numbers between \n    1 and 80 are automatically
      selected as Dollar Symbols.\n- When Free Games is triggered, 20 Dollar Symbols
      are selected and each game, 20 random \n    numbers from 1 to 80 are drawn.\n-
      If there are matching Dollar Symbols with the 20 numbers drawn, the amount of
      matching \n   Dollar Symbols is collected at the Dollar Bonus Gauge.\n- As the
      amount of collected Dollar Symbols increase, Dollar Bonus reward gets bigger
      and \n   additional Free Games can be awarded along the way.\n- When the Dollar
      Bonus Gauge is full, the Top Bonus reward is awarded, and Dollar Bonus ends.\n-
      When there is no remaining Free Games, Dollar Bonus ends, and the reward is
      awarded\n   depending on the progress of the Dollar Bonus Gauge. </size>"
  - key: PAYTABLE_PAGE_TITLE_5
    value: "<style=title><size=32>JACKPOT\r</style>"
  - key: PAYTABLE_SYMBOL_DESCRIPTION_5
    value: <size=21>- During Dollar Bonus, if the Dollar Bonus Gauge is full, Jackpot
      is awarded.</size>
