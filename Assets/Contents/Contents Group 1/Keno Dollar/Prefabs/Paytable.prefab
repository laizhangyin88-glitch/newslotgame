  m_RaycastTarget: 0
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<size=22>- Once game begins, except the numbers player picked, 5 numbers
    are randomly \n    selected as Dollar Symbols.\r\n- After 20 balls are drawn,
    if all 5 Dollar Symbols are part of the winning numbers, then \n   Dollar Bonus
    is triggered.\r\n- If not all 5 Dollar Symbols make wins, then the amount of winning
    Dollar Symbols\n    is collected at the Collect Gauge.\r\n- When Collect Guage
    is fully filled, Dollar Bonus is triggered and Collect Guage gets reset.\n- Progress
    of the Collect Gauge is saved by each bet level.\r </size>"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 5316d286fa94a894888ee12767189de0, type: 2}
