  m_RaycastTarget: 0
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<size=20>- Dollar Bonus is triggered if all 5 Dollar Symbols are part of
    the winning numbers or when the\n    Collect Gauge is full.\n- 10 initial Free
    Games are awarded in Dollar Bonus.\n- When Dollar Bonus is triggered, player's
    numbers get reset and 20 random numbers between \n    1 and 80 are automatically
    selected as Dollar Symbols.\n- When Free Games is triggered, 20 Dollar Symbols
    are selected and each game, 20 random \n    numbers from 1 to 80 are drawn.\n-
    If there are matching Dollar Symbols with the 20 numbers drawn, the amount of
    matching \n   Dollar Symbols is collected at the Dollar Bonus Gauge.\n- As the
    amount of collected Dollar Symbols increase, Dollar Bonus reward gets bigger and
    \n   additional Free Games can be awarded along the way.\n- When the Dollar Bonus
    Gauge is full, the Top Bonus reward is awarded, and Dollar Bonus ends.\n- When
    there is no remaining Free Games, Dollar Bonus ends, and the reward is awarded\n
    \  depending on the progress of the Dollar Bonus Gauge. </size>"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 5316d286fa94a894888ee12767189de0, type: 2}
