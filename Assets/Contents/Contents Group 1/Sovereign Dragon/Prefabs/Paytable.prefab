  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "- 6 or more Re-Spin symbols anywhere on reels \n   trigger Drop and Lock
    Feature.\n- All spots become independent and Re-Spin \n   symbol (          or        
    ) or blank can appear.\n- Once all reels stop, ALL Re-Spin symbols drop \n  
    down to the bottom as much as possible.\n- A full row of Re-Spin symbols creates
    a win and \n   the prizes of Re-Spin symbols on this row are \n   awarded and
    then this row gets emptied.\n- Whenever there is a win, spin counter gets reset.\n-         
    Re-Spin symbols on a win row are collected \n   to unlock the locked area up
    to 7x5.\n- Each unlocked row adds Jackpot Re-Spin \n   symbols to reel strips
    by order from Mini to\n    Mega.\n- Re-Spin symbols that are not part of any
    win \n   rows, get dropped down and locked until \n   they make a win row."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 5316d286fa94a894888ee12767189de0, type: 2}
  m_sharedMaterial: {fileID: 21000010116884160, guid: 5316d286fa94a894888ee12767189de0,
