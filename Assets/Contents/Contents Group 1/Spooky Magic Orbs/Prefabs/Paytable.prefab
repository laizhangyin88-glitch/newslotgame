--- !u!114 &6661009996178409276
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1990648959027731735}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 0
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<size=22>- There is an <b>Expanding Symbol</b>           on reels.\n\n-
    Only <b>1</b>           can appear per reel per spin and           \n   on a
    reel expands that reel by <b>1</b> spot.\n\n- When a reel expands to the fullest,
    award the prize\n   on the <b>Orb</b> of the very same reel.\n\n- There is a
    line of <b>5 Orbs</b> above the reels and each <b>Orb</b>\n   can display one
    of the followings:</size><size=20>\n       - <b>Random Jackpot Orb</b>          
    triggers a <b>Wheel of Jackpots</b>\n          and awards one of the four <b>Jackpots</b>\n      
    - <b>Cash Prize Orbs</b>           or           \n       - <b>Free Games Orb</b>          
    triggers <b><color=#ffb400>Spooky Night\n        Free Games</color></b></size>\n\n<size=22>-
    Each spin, <b>Orbs</b> move from left to right by <b>1</b> position\n   and once
    an <b>Orb</b> of a reel is won, that reel gets reset\n   while other reels remain
    as expanded.</size>"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: f98dbaf2afe1ec543b8bbb9acc75753a, type: 2}
