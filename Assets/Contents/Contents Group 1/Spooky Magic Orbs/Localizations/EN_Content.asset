  - key: PAYTABLE_WAY_INFO
    value: <size=24><color=#00eaff></size>243 WAYS - UP TO 32768 WAYS</size>
  - key: PAYTABLE_BET_INFO
    value: '<size=24><color=#00eaff>BASE BET: 80</size>'
  - key: PAYTABLE_TITLE_1
    value: <b><style=title><size=32>WILD</style></b>
  - key: PAYTABLE_DESCRIPTION_1
    value: '<size=24>Appears on reels <b>2</b>, <b>3</b> and <b>4</b> reels

      and
      substitutes for all symbols

      except        .</size>'
  - key: PAYTABLE_TITLE_2
    value: <b><style=title><size=32>SCATTER</style></b>
  - key: PAYTABLE_DESCRIPTION_2
    value: '<size=24><b>3 FULL Scatters</b>

      on reels <b>2</b>, <b>3</b> and
      <b>4</b> triggers

      <b><color=#ffb400>Spooky Night Free Games</color></b>.</size>'
  - key: PAYTABLE_SYMBOL_PAYOUT_FORMAT
    value: '<b><size=24>5 <color=#ffb400>{2:CommaNumber}</color>

      4 <color=#ffb400>{1:CommaNumber}</color>

      3
      <color=#ffb400>{0:CommaNumber}</color></size></b>'
  - key: PAYTABLE_TITLE_3
    value: <b><style=title><size=32>EXPAND FEATURE</style></b>
  - key: PAYTABLE_DESCRIPTION_3
    value: "<size=22>- There is an <b>Expanding Symbol</b>           on reels.\n\n-
      Only <b>1</b>           can appear per reel per spin and           \n   on
      a reel expands that reel by <b>1</b> spot.\n\n- When a reel expands to the
      fullest, award the prize\n   on the <b>Orb</b> of the very same reel.\n\n-
      There is a line of <b>5 Orbs</b> above the reels and each <b>Orb</b>\n   can
      display one of the followings:</size><size=20>\n       - <b>Random Jackpot
      Orb</b>           triggers a <b>Wheel of Jackpots</b>\n          and awards
      one of the four <b>Jackpots</b>\n       - <b>Cash Prize Orbs</b>          
      or           \n       - <b>Free Games Orb</b>           triggers <b><color=#ffb400>Spooky
      Night\n        Free Games</color></b></size>\n\n<size=22>- Each spin, <b>Orbs</b>
      move from left to right by <b>1</b> position\n   and once an <b>Orb</b> of
      a reel is won, that reel gets reset\n   while other reels remain as expanded.</size>"
  - key: PAYTABLE_TITLE_4
    value: <b><style=title><size=32>SPOOKY NIGHT FREE GAMES</style></b>
  - key: PAYTABLE_DESCRIPTION_4
    value: "<size=22>- <b>3 FULL</b>           on reels <b>2</b>, <b>3</b> and <b>4</b>
      <b>OR</b> winning a\n   <b>Free Games Orb</b>           triggers <b>Spooky
      Night\n   Free Games</b>.\n\n- As in <b>Base Game</b>,           appears in
      <b>Spooky Night\n   Free Games</b>.\n\n- When a reel expands to the fullest,
      award the prize\n   on the <b>Orb</b> of the very same reel.\n\n- In <b>Spooky
      Night Free Games</b>, there is a line of <b>5 Orbs</b>\n   above the reels
      and each <b>Orb</b> can display one\n   of the followings:</size><size=20>\n      
      - <b>Random Jackpot Orb</b>           triggers a <b>Wheel of Jackpots</b>\n         
      and awards one of the four <b>Jackpots</b>\n       - <b>Cash Prize Orbs</b>          
      or           \n       - <b>End of Free Games Orb</b>           ends <b>Free
      Games</b></size>\n\n<size=22>- <b>Spooky Night Free Games</b> continues until
      any reel hits\n   <b>End of Free Games Orb</b>           .\n\n- Each spin,
      <b>Orbs</b> move from left to right by <b>1</b> position\n   and once an <b>Orb</b>
      of a reel is won, that reel gets reset\n   while other reels remain as expanded.\n\n-
      No Re-Trigger.</size>"
