    m_PersistentCalls:
      m_Calls: []
  m_text: '- 3 Scatters on reels 1, 3 and 5 triggers Fire Storm Free Games.

    - Each Scatter awards extra Free Game.

    - During Fire Storm Free Games, only Fire Wild and Scatter appear on reel 1.

    - At the end of Mystery Re-Spin, a Special Wheel appears and awards a multiplier
    to the wins collected throughout the Mystery Re-Spin.

    - Fire Blast Re-Spin and Frozen Wild Re-Spin are not possible to trigger during
    Fire Strom Free Games.'
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 5316d286fa94a894888ee12767189de0, type: 2}
  m_sharedMaterial: {fileID: 21000010116884160, guid: 5316d286fa94a894888ee12767189de0,
