  - key: PAYTABLE_SYMBOL_NAME_11
    value: <style=title><size=32><b>SCATTER</style>
  - key: PAYTABLE_SYMBOL_NAME_0
    value: <style=title><size=32><b>WILD</style>
  - key: PAYTABLE_SYMBOL_DESCRIPTION_11_0
    value: '<b><size=32>5 <style=coinColor>10</style>

      4 <style=coinColor>5</style>

      3 <style=coinColor>1</style></size></b>'
  - key: PAYTABLE_SYMBOL_DESCRIPTION_11_1
    value: "<size=18>3 or more Scatters in any position\ntriggers Free Games.\r\nScatter
      Pays are multiplied by the\nTotal Bet\r\n</size>"
  - key: PAYTABLE_TITLE_PAGE_2_1
    value: <style=title><size=32><b>FREE GAME</size></style>
  - key: PAYTABLE_PAGE_DESCRIPTION_2_1
    value: "<size=20>- 3 or more Scatters in any position triggers Free Games.\r\n-
      Free Games proceeds with 2 separate reel sets.\r\n- 10 free spins are given,
      and there is no Free Game retrigger."
  - key: PAYTABLE_TITLE_PAGE_2_2
    value: <style=title><size=32><b>SPECIAL FRAMES & HOUSES</size></style>
  - key: PAYTABLE_PAGE_DESCRIPTION_2_2
    value: "<size=18>- Whenever a Scatter or Copy symbol appears, the spot turns into
      a \n   special frame and gets locked in place until Free Games end.\n\n- Whenever
      a Scatter or Copy symbol appears on an existing special\n   frame, the frame
      gets upgraded in the order of a Hay frame, Wooden\n   frame, and Golden Brick
      frame. \n\n- Once the spot is a Golden Brick special frame, it may not be upgraded\n
      \  any further. \n\n- When Free Games end, all special frames turn to respective
      houses.\n   then award coin amounts depending on the house type.\n\n- Only Golden
      Brick House awards Jackpots."
  - key: PAYTABLE_TITLE_PAGE_3_1
    value: <style=title><size=32><b>COPY FEATURE</size></style>
  - key: PAYTABLE_PAGE_DESCRIPTION_3_2
    value: "<size=20>- Copy symbols appear during Free Games.\n\n- Whenever a Copy
      symbol appears, it creates a special frame in\n   that position, or upgrades
      the pre-existing special frame by\n   one level. \n\n- In addition, it copies
      the same frame to the identical spot on\n   the other reel set.\n\n- Copy feature
      will only happen if doing so upgrades the value\n   of the identical spot on
      the other reel set. "
  - key: PAYTABLE_TITLE_LINES
    value: <style=title><size=42>LINES</size></style>
  - key: PAYTABLE_SYMBOL_PAYOUT_FORMAT
    value: '<b><size=25>5 <style=coinColor>{2:CommaNumber}</style>

      4 <style=coinColor>{1:CommaNumber}</style>

      3 <style=coinColor>{0:CommaNumber}</style></size></b>'
  - key: PAYTABLE_SPECIAL_SYMBOL_PAYOUT_FORMAT
    value: '<b><size=30>5 <style=coinColor>{2:CommaNumber}</style>

      4 <style=coinColor>{1:CommaNumber}</style>

      3 <style=coinColor>{0:CommaNumber}</style></size></b>'
