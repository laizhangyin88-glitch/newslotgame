  m_RaycastTarget: 0
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<size=18>- Whenever a Scatter or Copy symbol appears, the spot turns into
    a \n   special frame and gets locked in place until Free Games end.\n\n- Whenever
    a Scatter or Copy symbol appears on an existing special\n   frame, the frame gets
    upgraded in the order of a Hay frame, Wooden\n   frame, and Golden Brick frame.
    \n\n- Once the spot is a Golden Brick special frame, it may not be upgraded\n
    \  any further. \n\n- When Free Games end, all special frames turn to respective
    houses.\n   then award coin amounts depending on the house type.\n\n- Only Golden
    Brick House awards Coins or Jackpots"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 712bca31c60ef6d4d8eed34c4a6bc83a, type: 2}
