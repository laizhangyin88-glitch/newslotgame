  - key: PAYTABLE_SYMBOL_NAME_12
    value: <style=title><size=32>SCATTER</style>
  - key: PAYTABLE_SYMBOL_DESCRIPTION_0
    value: '<size=24> Appears on reels

      3, 4, and 5 only.'
  - key: PAYTABLE_SCATTER_SYMBOL_PAYOUT_FORMAT
    value: '<b><size=24>5 <style=coinColor>{2:CommaNumber}</style>

      4 <style=coinColor>{1:CommaNumber}</style>

      3 <style=coinColor>{0:CommaNumber}</style></size></b>'
  - key: PAYTABLE_SPECIAL_SYMBOL_PAYOUT_FORMAT
    value: '<b><size=24>5 <style=coinColor>{2:CommaNumber}</style>

      4 <style=coinColor>{1:CommaNumber}</style>

      3 <style=coinColor>{0:CommaNumber}</style></size></b>'
  - key: PAYTABLE_ROYAL_SYMBOL_PAYOUT_FORMAT
    value: '<b><size=24>5 <style=coinColor>{2:CommaNumber}</style>

      4 <style=coinColor>{1:CommaNumber}</style>

      3 <style=coinColor>{0:CommaNumber}</style></size></b>'
  - key: PAYTABLE_TITLE_FREE_GAMES
    value: <style=title><size=42>FREE GAMES</size></style>
  - key: PAYTABLE_DESCRIPTION_FREE_GAMES_12
    value: '<size=24>- 3 or more Scatters triggers 10 Free Games.

      - During Free Games, Scatters appear on reels 1, 3 and 5 only'
  - key: PAYTABLE_DESCRIPTION_FREE_GAMES_1
    value: '<size=24>- Wild is sticky during Free Games and appears on reels 2 and
      4 only.

      - Wild remains locked until end of Free Games.'
  - key: PAYTABLE_DESCRIPTION_FREE_GAMES_2
    value: "<size=24>- Is Multiplier Wild and appears on reel 3 only during Free Games.\n-
      Begins as x2 multiplier and doubles whenever it fills reel 3. \n- Multiplier
      will go from x2 to x4 to x8 and remain at x8."
  - key: PAYTABLE_TITLE_JACKPOTS
    value: <style=title><size=42>GRAND & MEGA JACKPOTS</size></style>
  - key: PAYTABLE_DESCRIPTION_JACKPOTS
    value: '<size=24>- Each spin provides the user an opportunity to win the Jackpot.

      - After each spin, either a GRAND or MEGA JACKPOT may be awarded.

      - Jackpots are available for qualifying bets only.'
  - key: PAYTABLE_WAY_INFO
    value: <size=24><color=#00eaff>40 LINES</color></size>
  - key: PAYTABLE_BET_INFO
    value: '<size=24><color=#00eaff>Bet Per Line: 1</color></size>'
  - key: PAYTABLE_TITLE_LINES
    value: <style=title><size=42>LINES</size></style>
  - key: PAYTABLE_SYMBOL_DESCRIPTION_11
    value: "3 or more Scatters \ntriggers Free Games"
  - key: PAYTABLE_SYMBOL_DESCRIPTION_0
    value: "Wild substitutes for all symbols \nexcept Scatter."
  - key: PAYTABLE_DESCRIPTION_PAGE_2_1
    value: "<size=24><line-height=100%>- Wicked Magic bonus is triggered randomly
      during reel spin.\n- If triggered, at least <color=yellow>5</color> Wilds appear
      on the reel.\n- Wild symbols can appear anywhere on the reel with equal\n  probability.\n"
  - key: PAYTABLE_DESCRIPTION_PAGE_2_2
    value: "<size=24>- 3 or more Scatters triggers Free Games.<line-height=70%>\n<size=22>
      \       - <color=yellow>3</color> Scatters triggers <color=yellow>5</color>
      Free Games.\n        - <color=yellow>4</color> Scatters triggers <color=yellow>7</color>
      Free Games.\n        - <color=yellow>5</color> Scatters triggers <color=yellow>10</color>
      Free Games.\n<line-height=10%>\n<line-height=100%><size=26>- All Wilds get locked
      and each awards <color=yellow>1</color> additional spin.\n- Wilds remain locked
      until Free Games end."
  - key: PAYTABLE_TITLE_PAGE_2_1
    value: <style=title><size=42>WICKED MAGIC
  - key: PAYTABLE_TITLE_PAGE_2_2
    value: <style=title><size=42>FREE GAMES
  - key: CONTENTS_GAME_TITLE
    value: Wicked Witch
