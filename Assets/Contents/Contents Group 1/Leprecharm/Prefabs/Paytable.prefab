  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<size=19>- Before spinning the Rainbow Wheel, pick coin items for a chance
    to upgrade the Wheel by at most 3 times.\n\n- 3 available upgrade stages are:
    \n\t- Multiplier Upgrade: Boosts all multipliers on the Rainbow Wheel\n\t- Jackpot
    Upgrade: Increases the trigger probability of each Jackpot on the Rainbow Wheel\n\t-
    Add Wheel Markers: Adds additional Wheel Markers to the Rainbow Wheel\n\n- At
    any time, picking the \u201CNext\u201D coin will bring user to a new upgrade stage.\n-
    At any time, picking the \u201CLeprechaun\u201D coin will end the Wheel Bonus.\n"
  m_isRightToLeft: 0
