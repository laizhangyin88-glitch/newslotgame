    value: <style=title><size=32>SCATTER</style>
  - key: PAYTABLE_SYMBOL_NAME_0
    value: <style=title><size=32>WILD</style>
  - key: PAYTABLE_SYMBOL_DESCRIPTION_11
    value: <size=18>8 or more Scatters in any position triggers Free Games.
  - key: PAYTABLE_SYMBOL_DESCRIPTION_0
    value: "<size=17>Wild Symbols can substitute for all symbols except \nScatter
      Symbols and appears on reels 2, 3, 4 and 5  only."
  - key: PAYTABLE_SYMBOL_DESCRIPTION_10
    value: '<size=18>Scatter Pay is multiplied by Total Bet.

      3 or more Scatters triggers Free Games.'
  - key: PAYTABLE_SCATTER_SYMBOL_PAYOUT_FORMAT
    value: '<b><size=22>5 <style=coinColor>{2:CommaNumber}</style>

      4 <style=coinColor>{1:CommaNumber}</style>

      3 <style=coinColor>{0:CommaNumber}</style></size></b>'
  - key: PAYTABLE_SYMBOL_PAYOUT_FORMAT
    value: '<b><size=22>5 <style=coinColor>{3:CommaNumber}</style>

      4 <style=coinColor>{2:CommaNumber}</style>

      3 <style=coinColor>{1:CommaNumber}</style>

      2 <style=coinColor>{0:CommaNumber}</style></size></b>'
  - key: PAYTABLE_SPECIAL_SYMBOL_PAYOUT_FORMAT
    value: '<b><size=24>5 <style=coinColor>{3:CommaNumber}</style>

      4 <style=coinColor>{2:CommaNumber}</style>

      3 <style=coinColor>{1:CommaNumber}</style>

      2 <style=coinColor>{0:CommaNumber}</style></size></b>'
  - key: PAYTABLE_TITLE_PEARLS_BONUS
    value: <style=title><size=42>COLLECT THE PEARLS BONUS</size></style>
  - key: PAYTABLE_DESCRIPTION_PEARLS_BONUS
    value: "<size=24>- 6 or more Pearl symbols triggers Collect the Pearls Bonus.\n-
      When triggered, user is awarded the sum total of credit values received \n  on
      Pearl symbols.\n- Initial Pearl symbols get locked while remaining spots spin
      3 times for free. \n- Receiving one or more Pearls in the empty spots re-sets
      number of\n  free spins to 3. \n- When bonus ends, combine all credit value
      on Pearl symbols.\n- 15 Pearls awards Grand Jackpot!"
  - key: PAYTABLE_TITLE_FREE_GAMES_BONUS
    value: <style=title><size=42>Free Games</size></style>
  - key: PAYTABLE_DESCRIPTION_FREE_GAMES_BONUS
    value: "<size=20>- During Base Games, 8 or more Scatter Symbols in any position
      triggers Free Games.\r\n- When Scatter Symbols appears as Super Symbols during
      Base Games, then award Free Games.\r\n- During Free Games, every spin comes
      in as Super Spins.\r\n- When Scatter Symbols appear as Super Symbols during
      Free Games, award extra Free Spins."
  - key: PAYTABLE_TITLE_JACKPOTS
    value: "<style=title><size=42>Super Spin Feature\r\n</size></style>"
  - key: PAYTABLE_DESCRIPTION_JACKPOTS
    value: "<size=20>- Super Spin Feature is randomly triggered during Base Games.\n-
      4x4 sized Super Symbols appear on reels 2, 3, 4 and 5 during Super Spin Feature.\r\n-
      When Scatter Symbols appear as Super Symbols during Super Spin Feature in Base
      Games, \n   then award Free Games."
  - key: PAYTABLE_WAY_INFO
    value: <size=24><color=#00eaff>50 LINES</color></size>
  - key: PAYTABLE_BET_INFO
    value: '<size=24><color=#00eaff>Bet Per Line: 1</color></size>'
  - key: PAYTABLE_TITLE_LINES
    value: <style=title><size=42>LINES</size></style>
  - key: CONTENTS_GAME_TITLE
    value: Super Panda
