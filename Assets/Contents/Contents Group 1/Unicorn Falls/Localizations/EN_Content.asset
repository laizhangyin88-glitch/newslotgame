  - key: PAYTABLE_SYMBOL_NAME_0
    value: <style=title><size=32>WILD</style>
  - key: PAYTABLE_SYMBOL_NAME_11
    value: <style=title><size=32>SCATTER</style>
  - key: PAYTABLE_SYMBOL_PAYOUT_FORMAT
    value: '<b><size=24>5 <style=coinColor>{2:CommaNumber}</style>

      4 <style=coinColor>{1:CommaNumber}</style>

      3 <style=coinColor>{0:CommaNumber}</style></size></b>'
  - key: PAYTABLE_SPECIAL_SYMBOL_PAYOUT_FORMAT
    value: '<b><size=24>5 <style=coinColor>{3:CommaNumber}</style>

      4 <style=coinColor>{2:CommaNumber}</style>

      3 <style=coinColor>{1:CommaNumber}</style>

      2 <style=coinColor>{0:CommaNumber}</style></size></b>'
  - key: PAYTABLE_TITLE_PAGE_1
    value: <style=title><size=42>GAME RULES</style>
  - key: PAYTABLE_DESCRIPTION_PAGE_1
    value: "<size=24>All wins pay LEFT to RIGHT on adjacent reels, beginning with
      leftmost reel, \nexcept scatters. All wins are paid on lines played, except
      scatters, which are \nadded to line wins. Highest win paid on any played line,
      except scatters. \nTotal Wager is minimum bet (25) multiplied by Coins.\n\nAll
      wins are multiplied by the number of coins bet per line, except Scatters. \nAll
      symbols in winning combinations will be removed and new symbols will \ncascade
      into the empty spaces. Lines are re-evaluated for symbols in winning \ncombinations
      and values are added to the meter. Reels continue to cascade \nuntil no winning
      symbol combinations are created as result of the cascading \nreels. Each successful
      cascade will increase the win multiplier by 1 to a max of 5."
  - key: PAYTABLE_TITLE_PAGE_2_1
    value: <style=title><size=42>SUBSTITUTION PAYS</style>
  - key: PAYTABLE_TITLE_PAGE_2_2
    value: <style=title><size=42>SCATTER PAYS</style>
  - key: PAYTABLE_DESCRIPTION_PAGE_2_1
    value: "<size=24>WILDS substitute for all symbols, except\nSCATTERS. When one
      or more WILDS \nsubstitute in a win, highest win is paid."
  - key: PAYTABLE_DESCRIPTION_PAGE_2_2
    value: '<size=24>SCATTERS pays in any position.

      SCATTER wins are multiplied by total bet.'
  - key: PAYTABLE_TITLE_PAGE_4
    value: <style=title><size=42>BONUS</style>
  - key: PAYTABLE_DESCRIPTION_PAGE_4
    value: "<size=24>Unicorn Cascade Free Spins are triggered with 4 successful Cascades.
      \nOn the 5th Cascade (4 successful winning cascades) the player is awarded \n8
      free spins. Each consecutive cascade will add 2 more free spins. \nFree Spins
      will begin with a win multiplier of 2 and each successful cascade \nwill increase
      the win multiplier by 2 to max of 10. \nFree Spins can be re-triggered with
      4 or more successful cascades."
  - key: PAYTABLE_TITLE_LINES
    value: <style=title><size=42>LINES</size></style>
  - key: PAYTABLE_WAY_INFO
    value: <size=24><color=#00eaff>25 LINES</color></size>
  - key: PAYTABLE_BET_INFO
    value: '<size=24><color=#00eaff>Bet Per Line: 1</color></size>'
  - key: CONTENTS_GAME_TITLE
    value: Unicorn Falls
