  - key: PAYTABLE_TITLE_RICH_HITS_JACKPOT
    value: <style=title><size=42>RICH HITS JACKPOT</size></style>
  - key: PAYTABLE_DESCRIPTION_RICH_HITS_JACKPOT
    value: "<size=24>- Rich Hits is Scatter and also awards progressives.\n- Progressives
      are awarded for 5 to 9 Rich Hits symbols\n  when played at qualifying bets."
  - key: PAYTABLE_DESCRIPTION_RICH_HITS_AWARDS
    value: '<size=24>Any 9+ RICH HITS symbols awards <style=coinColor><b>500x total
      bet</b></style>

      Any 8 RICH HITS symbols awards  <style=coinColor><b>400x
      total bet</b></style>

      Any 7 RICH HITS symbols awards  <style=coinColor><b>300x
      total bet</b></style>

      Any 6 RICH HITS symbols awards  <style=coinColor><b>200x
      total bet</b></style>

      Any 5 RICH HITS symbols awards  <style=coinColor><b>100x
      total bet</b></style>

      Any 4 RICH HITS symbols awards  <style=coinColor><b>50x
      total bet</b></style>

      Any 3 RICH HITS symbols awards  <style=coinColor><b>10x
      total bet</b></style>'
  - key: PAYTABLE_TITLE_FREE_GAMES
    value: <style=title><size=42>FREE GAMES</size></style>
  - key: PAYTABLE_DESCRIPTION_FREE_GAMES
    value: '<size=24>- 3 Free Games symbols in reels 1, 3 and 5 triggers 15 Free
      Games.

      - During Free Games, Wild acts as both the Wild and Rich Hits
      symbols.</size>'
  - key: PAYTABLE_TITLE_WHEEL_BONUS
    value: <style=title><size=42>WHEEL BONUS</size></style>
  - key: PAYTABLE_DESCRIPTION_WHEEL_BONUS
    value: "<size=24>- 3 Wheel Bonus symbols in reels 2, 3 and 4 starts the Wheel
      Bonus.\n- Collect credit or Rich Hits symbols on the Wheel. \n- Receive Scatter
      pay or progressives for Rich Hit symbols collected.</size>"
  - key: PAYTABLE_WAY_INFO
    value: <size=24><color=#00eaff>30 LINES</color></size>
  - key: PAYTABLE_BET_INFO
    value: '<size=24><color=#00eaff>Bet Per Line: 1</color></size>'
  - key: BUTTON_FREE_SPIN_START
