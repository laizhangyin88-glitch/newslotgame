  - key: PAYTABLE_SYMBOL_DESCRIPTION_9_0
    value: <size=24>3 Scatters pay 1x total bet
  - key: PAYTABLE_SYMBOL_DESCRIPTION_9_1
    value: '<size=24>Scatter appears on reels

      2, 3,and 4 only.'
  - key: PAYTABLE_ROYAL_SYMBOL_PAYOUT_FORMAT
    value: '<b><size=24>5 <style=coinColor>{2:CommaNumber}</style>

      4 <style=coinColor>{1:CommaNumber}</style>

      3 <style=coinColor>{0:CommaNumber}</style></size></b>'
  - key: PAYTABLE_SPECIAL_SYMBOL_PAYOUT_FORMAT
    value: '<b><size=24>5 <style=coinColor>{2:CommaNumber}</style>

      4 <style=coinColor>{1:CommaNumber}</style>

      3 <style=coinColor>{0:CommaNumber}</style></size></b>'
  - key: PAYTABLE_TITLE_RICH_HITS_JACKPOT
    value: <style=title><size=42>RICH HITS JACKPOT</size></style>
  - key: PAYTABLE_DESCRIPTION_RICH_HITS_JACKPOT
    value: '<size=24>- Rich Hits is Scatter and also awards progressives.

      - Progressives are awarded for 5 to 9 Rich Hits symbols.'
  - key: PAYTABLE_DESCRIPTION_RICH_HITS_AWARDS
    value: '<size=24>Any 9+ RICH HITS symbols awards <style=coinColor><b>1000x total
      bet</b></style>

      Any 8 RICH HITS symbols awards  <style=coinColor><b>500x total bet</b></style>

      Any 7 RICH HITS symbols awards  <style=coinColor><b>75x total bet</b></style>

      Any 6 RICH HITS symbols awards  <style=coinColor><b>30x total bet</b></style>

      Any 5 RICH HITS symbols awards  <style=coinColor><b>8x total bet</b></style>

      Any 4 RICH HITS symbols awards  <style=coinColor><b>3x total bet</b></style>

      Any 3 RICH HITS symbols awards  <style=coinColor><b>1x total bet</b></style>'
  - key: PAYTABLE_TITLE_FREE_GAMES
    value: <style=title><size=42>FREE GAMES</size></style>
  - key: PAYTABLE_DESCRIPTION_FREE_GAMES_0
    value: "<size=24>- 3 Scatters on reels 2, 3 and 4 starts the Free Games bonus
      feature.\n- Select 3 matching '?'buttons to determine the number of free games
      awarded.\n- You may also select <style=coinColor>RICH SPINS, RICH WILD, RICH
      STACKS,</style> or a combination of \n  them. The selected feature will enhance
      your free games. \n- More than 1 feature can be selected and awarded."
  - key: PAYTABLE_DESCRIPTION_FREE_GAMES_1
    value: "<size=24>- <style=coinColor>RICH SPINS:</style> If triggered, collecting
      2 Scatters awards one additional free \n  game. 3 Scatters awards the initial
      number of free games triggered.\n\n- <style=coinColor>RICH WILD:</style> All
      Wilds turn into the Rich Wild symbol, which acts as both\n  the Rich Hits and
      Wild symbol.\n\n- <style=coinColor>RICH STACKS:</style> Stacks of Rich Hits
      symbols are randomly added to reels\n  2, 3, and 4 during free games."
  - key: PAYTABLE_WAY_INFO
    value: <size=24><color=#00eaff>30 LINES</color></size>
  - key: PAYTABLE_BET_INFO
    value: '<size=24><color=#00eaff>Bet Per Line: 1</color></size>'
  - key: PAYTABLE_TITLE_LINES
    value: <style=title><size=42>LINES</size></style>
  - key: BUTTON_FREE_SPIN_START
    value: START
  - key: CONTENTS_GAME_TITLE
    value: Rich Hits Blue
