  - key: PAYTABLE_LINE_INFO
    value: <size=24><color=#00eaff>40 Lines</color></size>
  - key: PAYTABLE_BET_INFO
    value: '<size=24><color=#00eaff>Bet Per Line: 1</color></size>'
  - key: CONTENTS_GAME_TITLE
    value: Bubble Farm
  - key: BUTTON_FREE_SPIN_START
    value: START
  - key: "PAYTABLE_\bWILD"
    value: <style=title><size=32>WILD SYMBOL</size></style>
  - key: PAYTABLE_WILD_DESCRIPTION
    value: "<size=16>\n - Wild appears on all 5 reels and substitutes for all symbols
      except Bubble, \n   Bonus (pumpkin), and Scatter symbols.\n</size>"
  - key: PAYTABLE_BONUS_SYMBOL
    value: <style=title><size=32>BONUS SYMBOL</size></style>
  - key: PAYTABLE_BONUS_SYMBOL_DESCRIPTION
    value: "<size=16>\n - Bonus symbol appears on all 5 reels with credit or jackpot
      (Grand, Mega, \n   Major, Minor, Mini) amounts. \n\n - Award the bonus amount
      if a Bonus symbol overlaps with a Bubble symbol. \n\n - 6 or more Bonus symbols
      triggers the Bubble Bonus.\n\n - When the Bubble Bonus is triggered, award the
      bonus amounts \n   on all triggering Bonus symbols\n</size>"
  - key: PAYTABLE_BUBBLE_SYMBOL
    value: <style=title><size=32>BUBBLE SYMBOL</size></style>
  - key: PAYTABLE_BUBBLE_SYMBOL_DESCRIPTION
    value: "<size=16>\n - Bubble symbols appear randomly from the bottom of the screen
      and \n   move up by one position every spin.\n\n - Bonus amounts on any Bonus
      symbols that overlaps with Bubbles \n   get paid out.\n</size>"
  - key: PAYTABLE_BUBBLE_BONUS
    value: <style=title><size=32>BUBBLE BONUS</size></style>
  - key: PAYTABLE_BUBBLE_BONUS_DESCRIPTION
    value: "<size=16>\n - Only Bonus, Bubble, and Blank symbols appear.\n\n - Bubbles
      appear in 3 sizes (1x1, 2x2, 3x3).\n\n - Bubbles appear with multiplier (x1,
      x2, x3) or additional spin (+1, +2, +3) \n   awards.\n\n - Whenever a 2x2 or
      3x3 Bubble overlaps with any Bonus symbols, \n   Bonus symbols replicate and
      fill the large Bubble with a new bonus award \n   that is the sum of the original
      awards in the Bubble. \n\n- Multiplier on the overlapped Bubble is applied to
      calculate \n  the sum bonus award, and additional spins are awarded accordingly.\n</size>"
  - key: PAYTABLE_FREEGAMES
    value: <style=title><size=32>FREE GAMES</size></style>
  - key: PAYTABLE_FREEGAMES_DESCRIPTION_1
    value: "<size=16>\n 5 - 15 Free Spins\n 4 - 10 Free Spins\n 3 - 7 Free Spins\n</size>"
  - key: PAYTABLE_FREEGAMES_DESCRIPTION_2
    value: "<size=16>\n - Bubbles appear in 2 sizes (1x1, 2x2).\n\n - Whenever a 2x2
      Bubble overlaps with any Bonus symbols, \n   Bonus symbols replicate and fill
      the large Bubble with a new bonus award \n   that is the sum of the original
      awards in the Bubble.\n\n - 6 or more Bonus symbols triggers the Bubble Bonus.\n\n
      - 3 or more Scatters awards additional free spins.\n </size>"
  - key: PAYTABLE_LINES
    value: <style=title><size=32>LINES</size></style>
  - key: PAYTABLE_SYMBOL_PAYOUT_FORMAT
    value: '<b><size=24>5 <style=coinColor>{2:CommaNumber}</style>

      4 <style=coinColor>{1:CommaNumber}</style>

      3 <style=coinColor>{0:CommaNumber}</style></size></b>'
