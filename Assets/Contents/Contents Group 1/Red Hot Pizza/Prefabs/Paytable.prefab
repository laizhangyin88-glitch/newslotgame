  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 0
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<size=14.5\n>- Red-Hot Pizza Bonus has independent reel spins.\n\n- Pizza
    Symbol or Jackpot Symbol on a reel makes one piece of pizza meter above the same
    reel. \n     - Pizza Symbol: Pizza Symbol appears with random cash value on it.
    Each cash amount is accumulated on the same reel where it\n       appears. \n
    \    - Jackpot Symbol: Jackpot Symbol is accumulated on the reel whenever it appears.
    If 3 Jackpot Symbols collected, then Grand Jackpot\n       is activated. \n\n-
    Pizza has 5 pieces in total and one pizza piece is deduced each spin.\n\n- Pizza
    Symbol or Jackpot Symbol re-sets remaining pieces to 5 pizza pieces. \n\n- If
    Collect Symbol appears before all pizza pieces disappear, player wins the accumulated
    amount of Cash Values from Pizza Symbols  \n   and Jackpot if any. \n\n- If none
    of Pizza Symbols or Jackpot Symbols or Collect Symbols appears before all pizza
    pieces are gone, then accumulated cash\n   amounts and Jackpot re-set.</size>"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 9f85e618524ca104491ab4eb7da649e0, type: 2}
