  - key: CONTENTS_GAME_TITLE
    value: Sexy Showtime Chris
  - key: BUTTON_FREE_SPIN_START
    value: START
  - key: PAYTABLE_BONUS
    value: <style=title><size=32>BONUS</size></style>
  - key: PAYTABLE_BONUS_DESCRIPTION
    value: "<size=16>- 3 or more Bonus Symbols in any\n    position triggers Bonus
      Game.\n</size>"
  - key: PAYTABLE_SCATTER_PAYS
    value: <style=title><size=32>SCATTER PAYS</size></style>
  - key: PAYTABLE_SCATTER_PAYS_DESCRIPTION
    value: "<size=16>- All Symbols are Scatters.\n\n- Wins can occur in any\n   
      Position and are not limited\n    to direction or reel placement.\n</size>"
  - key: PAYTABLE_BONUS_FEATURE
    value: <style=title><size=32>CHRIS BONUS</size></style>
  - key: PAYTABLE_BONUS_FEATURE_DESCRIPTION
    value: "<size=18>\n- 3 or more Bonus Symbols triggers Chris Bonus Game with 5
      spins\n    by default.\n\n- When Coin Symbol appears, accumulate the same amount
      of Coins \n    that the Coin Symbol displays in the Multiplier Gauge.\n    
      - There are 3 types of Coin Symbols: 1 Coin, 2 Coins, and 3 Coins.\n\n- Each
      +1 Symbol awards one additional spin. \n\n- When Multiplier Gauge is fully
      filled, Grand JP is awarded. \n\n- When fail to fill Multiplier Gauge and Bonus
      Game ends,\n    the Multiplier from the Gauge will be applied to the triggering
      \n    Total Bet.\n\n- Chris Bonus Game ends when there are no remaining spins
      or\n    when Multiplier Gauge is fully filled.\n</size>"
  - key: PAYTABLE_SYMBOL_PAYOUT_FORMAT
    value: '<b><size=24>

      5 <style=coinColor>{2:CommaNumber}</style>

      4
      <style=coinColor>{1:CommaNumber}</style>

      3 <style=coinColor>{0:CommaNumber}</style>

      </size></b>'
  - key: PAYTABLE_SYMBOL_PAYOUT_FORMAT_2
    value: '<b><size=24>

      5 <style=coinColor>{1:CommaNumber}</style>

      4
      <style=coinColor>{0:CommaNumber}</style>

      </size></b>'
