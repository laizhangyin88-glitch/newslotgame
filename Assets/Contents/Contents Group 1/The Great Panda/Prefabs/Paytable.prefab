  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 0
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: '- <indent=1em>4 or more Wild Symbols anywhere on reels 2,3,4 or 5 triggers
    Re-Spin Feature.</indent>

    - <indent=1em>All triggering Wild Symbols get
    locked until Re-Spin Feature ends.</indent>

    - <indent=1em>Reel 1 is dimmed
    out but it keeps spinning until the Re-Spin Feature ends.</indent>

    - <indent=1em>Reels
    2, 3, 4, and 5 do the Re-Spin(s).</indent>

    - <indent=1em>Each Re-Spin, if
    additional Wild symbol(s) lands on the rest of the spots where triggering Wild
    Symbols do not occupy, then one more Re-Spin is awarded and gets locked.</indent>

    -
    <indent=1em>Re-Spin Feature continues until there is no extra Wild Symbols.</indent>

    -
    <indent=1em>When additional Wild Symbols do not appear, Re-Spin Feature ends,
    reel 1 stops and line wins are paid.</indent>'
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 5316d286fa94a894888ee12767189de0, type: 2}
  m_sharedMaterial: {fileID: 21000010116884160, guid: 5316d286fa94a894888ee12767189de0,
    type: 2}
  m_fontSharedMaterials: []
