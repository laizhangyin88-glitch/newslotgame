    m_PersistentCalls:
      m_Calls: []
  m_text: "<size=20>- Bucks symbols have values proportionate to the user's total
    bet.\n- Bucks symbols can trigger the Party Bonus. \n- Each party member's value
    symbol will be collected towards the Bonus Meter, which is a group\n   bonus meter.\n-
    Party Bonus is triggered when the Bonus Meter is full.\n- 1% of the all values
    are also awarded towards the user's Bonus Bet. \n- This Bonus Bet is used for
    each player in the Party Bonus.\n</size>"
