  m_RaycastTarget: 0
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<size=20>- Party Bonus is a community bonus game triggered and played collectively
    by 7 user's in \n   a single slot room.\n- Party Bonus lasts for 7 free spins
    on a 1x1 single reel with one spot.\n- The reel can land on a Diamond value symbol,
    a Diamond +1 Spin symbol, or blank. \n- Each Diamond value that appears is summed
    and later added to the Bonus Bet amount carried \n   from base game.\n- For each
    +1 spin that appears, a free spin is awarded to all 7 user's. \n- For each Diamond
    symbol that appears, all users contribute towards a group meter that \n  determines
    a bonus multiplier.  \n- Party Bonus ends when no free spins remain. \n- Accumulated
    Diamond values is summed with the initial Bonus Bet amount from base game,\n   then
    multiplied by the bonus multiplier.\n</size>"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 5316d286fa94a894888ee12767189de0, type: 2}
