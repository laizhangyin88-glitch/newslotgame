  - key: PAYTABLE_TITLE_SECOND_CHANCE
    value: <style=title><size=42>SECOND CHANCE</size></style>
  - key: PAYTABLE_DESCRIPTION_SECOND_CHANCE
    value: '<size=24>- 2 SCATTERS may trigger the Second Chance bonus.

      - User will be randomly awarded 10 Free Games or 1x Total Bet.</size>'
  - key: PAYTABLE_TITLE_FREE_GAMES
    value: <style=title><size=42>FREE GAMES</size></style>
  - key: PAYTABLE_DESCRIPTION_FREE_GAEMS
    value: '<size=24>- 3, 4, or 5 SCATTERS triggers 10, 15, or 25 Free Games respectively.

      - Free Games adds 30 RED MACAW symbols to the reels.

      - 2 or more SCATTERS during Free Games awards more Free Games!

      - WILD during Free Games will become 2X or 3X multiplier.</size>'
  - key: PAYTABLE_TITLE_MEGA_FREE_GAMES
    value: <style=title><size=42>MEGA FREE GAMES</size></style>
  - key: PAYTABLE_DESCRIPTION_MEGA_FREE_GAMES
    value: "<size=24>- MEGA SCATTER appears on reel 5 only.\n- 3, 4, or 5 SCATTERS
      with one MEGA symbol triggers 10, 15, or 25 \n  Mega Free Games.\n<style=highlight
      1>- Mega Free Games adds 60 RED MACAW symbols to the reels.\n- MEGA SCATTER
      appears on Reel 5 only during Mega Free Games.\n- MEGA SCATTER during Mega Free
      Games adds 15 RED MACAW to the reels. \n- MEGA SCATTER appears up to 5 times
      during Mega Free Games.</style>\n- 2 or more SCATTERS during Mega Free Games
      awards more Free Games!\n- WILD during Mega Free Games will become 2X or 3X
      multiplier.</size>"
  - key: PAYTABLE_WAY_INFO
    value: <size=24><color=#00eaff>1024 WAYS</color></size>
  - key: PAYTABLE_BET_INFO
    value: '<size=24><color=#00eaff>Base Bet: 50</color></size>'
  - key: BUTTON_FREE_SPIN_START
    value: START
  - key: PAYTABLE_TITLE_JACKPOTS
    value: <style=title><size=42>GRAND & MEGA JACKPOTS</size></style>
  - key: PAYTABLE_DESCRIPTION_JACKPOTS
    value: '<size=24>- Each spin provides the user an opportunity to win the Jackpot.

      - After each spin, either a GRAND or MEGA JACKPOT may be awarded.'
  - key: CONTENTS_GAME_TITLE
    value: Tropical Dreams
