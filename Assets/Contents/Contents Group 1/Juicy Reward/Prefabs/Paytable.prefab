  m_RaycastTarget: 0
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<size=24>\n- 3 identical Fruit Wilds triggers the Juicy Reward\n  Bonus.\n\n-
    Special Wild symbol substitutes for any of the\n  Fruit Wilds.\n\n- When Juicy
    Reward Bonus is triggered, player wins\n  the sum of prizes on Fruit Reward symbols
    of the\n  same Fruit kind as the triggering Fruit Wilds\n\n    - E.g. 2 Watermelon
    Wilds and one Special\n      Wild triggers the Watermelon Juicy Reward\n     
    Bonus and awards the sum of prizes on all\n      Watermelon Fruit Reward symbols
    on the\n      Fruit Reels.\n    \n   - E.g. 3 Special Wilds awards the sum of
    prizes\n     on all Fruit Reward symbols on the Fruit Reels.\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 42647afe76ab131469f51dd9dfd879fe, type: 2}
  m_sharedMaterial: {fileID: 21000010116884160, guid: 42647afe76ab131469f51dd9dfd879fe,
