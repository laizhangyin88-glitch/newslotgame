    m_PersistentCalls:
      m_Calls: []
  m_text: "<size=24>\n- Selected Fruit Feature is triggered before every\n  spin
    during Free Games.\n\n- One of the 3 Fruits is randomly selected\n  : Watermelon,
    Pineapple or Kiwi. \n\n- Chosen Fruit Wild replaces all Wilds, other than\n Special
    Wilds, on Base Reels for that spin.\n\n- Replaced Fruit Wilds are reset before
    the next\n  Free Spin."
