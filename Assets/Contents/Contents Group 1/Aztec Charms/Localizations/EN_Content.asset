  - key: PAYTABLE_TITLE_CHAMELEON_BONUS
    value: <style=title><size=42>CHAMELEON BONUS</size></style>
  - key: PAYTABLE_DESCRIPTION_CHAMELEON_BONUS
    value: "<size=24>- The very center position in the reel set is a special spot.
      \n- Chameleon Wild in the special spot triggers the Chameleon Bonus.\n- Chameleon
      changes random symbols in surrounding positions in reels\n  2, 3, and 4 to Wild.
      \n- Scatter symbol does not change to Wild.\n</size>"
  - key: PAYTABLE_TITLE_FREE_GAMES
    value: <style=title><size=42>FREE GAMES</size></style>
  - key: PAYTABLE_DESCRIPTION_FREE_GAMES
    value: "<size=24>- Scatter symbols on reels 1, 3, and 5 triggers Free Games.\n-
      During Free Games, Scatters only appear on reels 1 and 5.\n- During Free Games,
      each Scatter that lands on reels adds to the Multiplier. \n- Bad Wild appears
      on reel 3 only. 3 Bad Wilds collected ends Free Games.</size>"
  - key: PAYTABLE_WAY_INFO
    value: <size=24><color=#00eaff>30 LINES</color></size>
  - key: PAYTABLE_BET_INFO
    value: '<size=24><color=#00eaff>Bet Per Line: 1</color></size>'
  - key: BUTTON_FREE_SPIN_START
    value: START
  - key: PAYTABLE_TITLE_LINES
    value: <style=title><size=42>LINES</size></style>
  - key: PAYTABLE_TITLE_JACKPOTS
    value: <style=title><size=42>GRAND & MEGA JACKPOTS</size></style>
  - key: PAYTABLE_DESCRIPTION_JACKPOTS
    value: '<size=24>- Each spin provides the user an opportunity to win the Jackpot.

      - After each spin, either a GRAND or MEGA JACKPOT may be awarded.'
  - key: CONTENTS_GAME_TITLE
    value: Aztec Charms
