  - key: PAYTABLE_SYMBOL_NAME_0
    value: <style=title><size=32>WILD</style>
  - key: PAYTABLE_SYMBOL_DESCRIPTION_0
    value: "<size=20>Appears on reels 2, 3, and 4.\nWild multiplies the winning \nline
      pay by 2x"
  - key: PAYTABLE_SYMBOL_PAYOUT_FORMAT
    value: '<b><size=24>5 <style=coinColor>{2:CommaNumber}</style>

      4 <style=coinColor>{1:CommaNumber}</style>

      3 <style=coinColor>{0:CommaNumber}</style></size></b>'
  - key: PAYTABLE_TITLE_PAGE_2
    value: <style=title><size=42>WHEEL BONUS TRIGGER
  - key: PAYTABLE_TITLE_PAGE_3
    value: <style=title><size=42>3 POINTERS
  - key: PAYTABLE_TITLE_PAGE_4
    value: <style=title><size=42>WHEEL BONUS
  - key: PAYTABLE_DESCRIPTION_PAGE_2
    value: "<size=24>- Mystery event is randomly triggered, causing for \n   symbols
      to appear lit for one spin.\n- 3, 4, or 5 consecutive lit symbols in a horizontal
      line \n   triggers the Wheel Bonus.\n- There are 3 types of Wheel Bonus events:
      \n   1) Multipliers, 2) Random Wilds, and 3) Free Games."
  - key: PAYTABLE_DESCRIPTION_PAGE_3
    value: "<size=24> - 3, 4, and 5 consecutive lit symbols activates 1, 2, \n   and
      3 pointers respectively.\n- If the main pointer lands on a slice with an \"Extra\"
      mark, \n   an additional pointer is awarded."
  - key: PAYTABLE_DESCRIPTION_PAGE_4
    value: '<b>Multiplier</b>

      - Multiplies user''s Total Bet by the multiplier won.


      <b>Random Wilds</b>

      - Awards 1 free game with the number of Wilds added to reels.


      <b>Free Games</b>

      - Awards the number of free games.

      - During free games, more Wild symbols appear on the reels.'
  - key: PAYTABLE_TITLE_LINES
    value: <style=title><size=42>LINES</size></style>
  - key: PAYTABLE_TITLE_JACKPOTS
    value: <style=title><size=42>GRAND & MEGA JACKPOTS</size></style>
  - key: PAYTABLE_DESCRIPTION_JACKPOTS
    value: '<size=24>- Each spin provides the user an opportunity to win the Jackpot.

      - After each spin, either a GRAND or MEGA JACKPOT may be awarded.'
  - key: PAYTABLE_WAY_INFO
    value: <size=24><color=#00eaff>50 LINES</color></size>
  - key: PAYTABLE_BET_INFO
    value: '<size=24><color=#00eaff>Bet Per Line: 1</color></size>'
  - key: CONTENTS_GAME_TITLE
    value: Rio Fiesta
