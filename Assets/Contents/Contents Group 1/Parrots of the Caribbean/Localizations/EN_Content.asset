  - key: PAYTABLE_BET_INFO
    value: '<size=24><color=#00eaff>Bet Per Line: 1</color></size>'
  - key: PAYTABLE_TITLE_LINES
    value: <style=title><size=42>LINES</size></style>
  - key: PAYTABLE_TITLE_FREE_SUPERBUFFALO
    value: <style=title><size=42>SUPER BUFFALO</size></style>
  - key: PAYTABLE_DESCRIPTION_SUPERBUFFALO
    value: "<size=24>- Super Buffalo Feature is triggered randomly during reel spin.\n-
      When triggered, giant Super Buffalo symbols are added to the reels. \n- When
      Super Buffalo symbol/s land, corresponding spots will \n   become H1 Buffalo
      symbols."
  - key: PAYTABLE_TITLE_FREE
    value: <style=title><size=42>FREE GAMES</size></style>
  - key: PAYTABLE_DESCRIPTION_FREE
    value: '<size=24>- 3 or more Scatters in any position triggers Free Games.

      - In Free Games, Wild symbol appears with x2 or x3 multiplier.

      - All multipliers in a single pay line are multiplied together.'
  - key: PAYTABLE_SYMBOL_DESCRIPTION_12_FREE_COUNT
    value: '<size=24><b>5 <style=coinColor>20</style></b>

      <b>4 <style=coinColor>10</style></b>

      <b>3 <style=coinColor>2</style></size></b>'
  - key: PAYTABLE_TITLE_PAGE_2
    value: '<style=title><size=42>Pirate Plunder

      </size></style>'
  - key: PAYTABLE_DESCRIPTION_PAGE_2
    value: "<size=24>- 3 or more Treasure Scatters triggers Pirate Plunder.\n- Spin
      the double-arrowed compass and travel on the pirate map to win rewards.\n- Receiving
      2 identical numbers on the compass  rewards 1 more spin.\n- When an entire round
      is completed, receive multiplied reward amounts on the \n    next round.\n-
      Bonus ends when no more compass spins remain."
  - key: PAYTABLE_TITLE_PAGE_4
    value: "<style=title><size=42>Free Games Bonus\r\n</size></style>"
  - key: PAYTABLE_DESCRIPTION_PAGE_4
    value: "<size=24>- 3 or more Scatters triggers the Free Games Bonus.\r\n- All
      Wild symbols become locked and remain locked during Free Games.\n- Every +1
      More Spin symbol awards an additional spin in Free Games.\r"
  - key: BUY_A_BONUS_TIER_MULTIPLIER
    value: X {0}
  - key: CONTENTS_GAME_TITLE
    value: Parrots of the Caribbean
