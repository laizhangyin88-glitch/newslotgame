  - key: PAYTABLE_ROYAL_SYMBOL_PAYOUT_FORMAT
    value: '<b><size=24>5 <style=coinColor>{2:CommaNumber}</style>

      4 <style=coinColor>{1:CommaNumber}</style>

      3 <style=coinColor>{0:CommaNumber}</style></size></b>'
  - key: PAYTABLE_SPECIAL_SYMBOL_PAYOUT_FORMAT
    value: '<b><size=24>5 <style=coinColor>{2:CommaNumber}</style>

      4 <style=coinColor>{1:CommaNumber}</style>

      3 <style=coinColor>{0:CommaNumber}</style></size></b>'
  - key: PAYTABLE_TITLE_FREE_GAMES
    value: <style=title><size=42>FREE GAMES</size></style>
  - key: PAYTABLE_DESCRIPTION_FREE_GAMES
    value: "<size=24>- 3, 4, and 5 Scatter symbols awards 8, 12, and 15 Free Games
      respectively.\n- Initially, only Scatters will be shown in a Bonus Game.\n  Scatters
      received determines extra Free Games added to the intial amount \n  (up to 15
      extra).\n<style=highlight 1>- 3 SCATTERS = 8 FREE GAMES + EXTRA determined by
      BONUS GAME\n- 4 SCATTERS = 12 FREE GAMES + EXTRA determined by BONUS GAME\n-
      5 SCATTERS = 15 FREE GAMES + EXTRA determined by BONUS GAME</style>\n- During
      Free Games, each Wild will award a 2X Multiplier.\n- Multiply your winnings
      by up to 8X!</size>"
  - key: PAYTABLE_TITLE_DRAGON_SPIN
    value: <style=title><size=42>DRAGON SPIN</size></style>
  - key: PAYTABLE_DESCRIPTION_DRAGON_SPIN
    value: "<size=24>- Dragon Spin is activated when the same Dragon symbol appears
      on all \n  three spots in Reel 1.\n- All Dragon symbols on other reels will
      change to match the dragon in Reel 1.</size>"
  - key: PAYTABLE_WAY_INFO
    value: <size=24><color=#00eaff>243 WAYS</color></size>
  - key: PAYTABLE_BET_INFO
    value: '<size=24><color=#00eaff>Base Bet: 50</color></size>'
  - key: PAYTABLE_TITLE_JACKPOTS
    value: <style=title><size=42>GRAND & MEGA JACKPOTS</size></style>
  - key: PAYTABLE_DESCRIPTION_JACKPOTS
    value: '<size=24>- Each spin provides the user an opportunity to win the Jackpot.

      - After each spin, either a GRAND or MEGA JACKPOT may be awarded.'
  - key: BUTTON_FREE_SPIN_START
    value: START
  - key: CONTENTS_GAME_TITLE
    value: Dragons' Roar
