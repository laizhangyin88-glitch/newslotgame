  - key: PAYTABLE_TITLE_1
    value: <style=title><size=32><color=#f821fa>WILD</color></style></size>
  - key: PAYTABLE_TITLE_2
    value: <style=title><size=32><color=#f821fa>FANCY FREE GAMES</color></style></size>
  - key: PAYTABLE_TITLE_3
    value: <style=title><size=32><color=#f821fa>MAGNIFICENT WHEELS FEATURE</color></style></size>
  - key: PAYTABLE_DESCRIPTION_1
    value: "<size=24><b>Wild</b> appears anywhere on reels. \n<b>Wild</b> substitutes
      for all symbols \nexcept          and          .\n</size>"
  - key: PAYTABLE_DESCRIPTION_2
    value: "<size=24><b><color=#ffc000>3</color></b> or more          triggers \n<b>Fancy
      Free Games</b>.\n\nDuring <b>Fancy Free Games</b>,\n        appears on 5th reel,
      counted\nas double          symbol.\n\n<b>No re-trigger allowed</b>.\n\n<b><color=#ffc000>3</color>
      Scatters</b> - <b><color=#f821fa>15</color> Free Games</b>\n<b><color=#ffc000>4</color>
      Scatters</b> - <b><color=#f821fa>30</color> Free Games</b>\n<b><color=#ffc000>5</color>
      Scatters</b> - <b><color=#f821fa>50</color> Free Games</b>\n</size>"
  - key: PAYTABLE_DESCRIPTION_3
    value: "<size=24><b><color=#ffc000>6</color></b> or more          symbol triggers
      Magnificent Wheels Feature</b>. \nFirst wheel reveals the prize and second wheel
      reveals a multiplier for it.\n\nFor <color=#ffc000><b>6</b></color>          symbols
      - maximum multiplier up to <b><color=#f821fa>4x</b></color>\n\nFor <color=#ffc000><b>7</b></color>
      \         symbols - maximum multiplier up to <b><color=#f821fa>6x</b></color>\n\nFor
      <color=#ffc000><b>8</b></color>          symbols - maximum multiplier up to
      <b><color=#f821fa>8x</b></color>\n\nFor <color=#ffc000><b>9</b></color>          symbols
      - maximum multiplier up to <b><color=#f821fa>10x</b></color>\n\nFor <color=#ffc000><b>10</b></color>
      and more          symbols - maximum multiplier up to <b><color=#f821fa>15x</b></color>\n</size>"
  - key: PAYTABLE_TITLE_LINES
    value: <style=title><size=32><color=#f821fa>LINES</color></style></size>
