  - key: PAYTABLE_SYMBOL_NAME_0
    value: <style=title><size=32>SCATTER</style>
  - key: PAYTABLE_SYMBOL_NAME_1
    value: <style=title><size=32>WILD</style>
  - key: PAYTABLE_SYMBOL_DESCRIPTION_12
    value: <size=18>Pays leftmost to right
  - key: PAYTABLE_SYMBOL_DESCRIPTION_0
    value: '<b><size=24>5 <style=coinColor>20 Free Games</style>

      4 <style=coinColor>15 Free Games</style>

      3 <style=coinColor>10 Free Games</style></size></b>'
  - key: PAYTABLE_SCATTER_SYMBOL_PAYOUT_FORMAT
    value: '<b><size=18></style>5 <style=coinColor>50 x total bet</style>

      </style>4 <style=coinColor>10 x total bet</style>

      </style>3 <style=coinColor>5 x total bet</style></size></b>'
  - key: PAYTABLE_SYMBOL_DESCRIPTION_1
    value: "<size=20>Wild substitutes for all symbols and \nappears on reels 2 and
      4 only."
  - key: PAYTABLE_TITLE_PAGE_2
    value: <style=title><size=42>FREE GAMES</style>
  - key: PAYTABLE_TITLE_PAGE_3
    value: <style=title><size=42>MEGA FREE GAMES</style>
  - key: PAYTABLE_DESCRIPTION_PAGE_2_1
    value: "<size=20>- Before game starts, choose your play style by selecting a random
      multiplier set.\n- Chosen multiplier set can be changed at anytime during the
      game.\n- Wild substitutes for all symbols except Scatter.\n- Wild appears in
      reels 2, 3, and 4. \n- Wins with Wild randomly award Multipliers from the chosen
      set. "
  - key: PAYTABLE_DESCRIPTION_PAGE_2
    value: "<size=20>-  3 or more consecutive Scatters starting from leftmost reel
      triggers Free Games.\n\n-  During Free Games, instead of Wild, Wild Multipliers
      appear.\n\n-  On reel 2, x3 Multiplier Wilds appear. On reel 4, x5 Multiplier
      Wilds appear.\n\n-  For wins that include the Multiplier Wild, multiply the
      total win by that multiplier.\n\n-  If both x3 and x5 Multiplier Wilds are part
      of a win, the total win is multiplied by 15.\n\n-  Free Games is re-triggered
      if 3 or more Scatters appear.\n         -   5 Scatters awards 20 more free spins\n
      \        -   4 Scatters awards 15 more free spins\n         -   3 Scatters awards
      10 more free spins"
  - key: PAYTABLE_DESCRIPTION_PAGE_3
    value: "<size=20>-  Collect                 to trigger Mega Free Games.\n\n-  When
      triggered, award 10 Free Spins.\n\n-  During Mega Free Games, reel set changes
      to a 3 x 4 x 4 x 4 x 3 formation.\n\n-  All wins are multiplied by 4 in Mega
      Free Games.\n\n-  Like in Free Games, x3 Multiplier Wilds appear on reel 2,
      and x5 Multiplier Wilds\n   appear on reel 4.\n\n-  Mega Free Games is re-triggered
      when 3 or more Scatters appear.\n         -   5 Scatters awards 20 more free
      spins\n         -   4 Scatters awards 15 more free spins\n         -   3 Scatters
      awards 10 more free spins"
  - key: PAYTABLE_WAY_INFO
    value: <size=24><color=#00eaff>243 WAYS</color></size>
  - key: PAYTABLE_BET_INFO
    value: '<size=24><color=#00eaff>Base Bet: 60</color></size>'
  - key: PAYTABLE_SYMBOL_PAYOUT_FORMAT
    value: '<b><size=24>5 <style=coinColor>{2:CommaNumber}</style>

      4 <style=coinColor>{1:CommaNumber}</style>

      3 <style=coinColor>{0:CommaNumber}</style></size></b>'
  - key: PAYTABLE_SYMBOL_PAYOUT_FORMAT_2
    value: '<b><size=24>5 <style=coinColor>{3:CommaNumber}</style>

      4 <style=coinColor>{2:CommaNumber}</style>

      3 <style=coinColor>{1:CommaNumber}</style>

      2 <style=coinColor>{0:CommaNumber}</style></size></b>'
