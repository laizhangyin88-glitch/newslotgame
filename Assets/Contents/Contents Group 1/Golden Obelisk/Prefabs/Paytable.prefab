  m_RaycastTarget: 0
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<size=20>-  3 or more Scatters triggers Free Games.\r\n\n-  During Free
    Games, instead of Wild, Wild Multipliers appear..\n\r\n-  On reel 2, x3 Multiplier
    Wilds appear. On reel 4, x5 Multiplier Wilds appear.\r\n\n-  For wins that include
    the Multiplier Wild, multiply the total win by that multiplier.\r\n\n-  If both
    x3 and x5 Multiplier Wilds are part of a win, the total win is multiplied by 15.\r\n\n-
    \ Free Games is re-triggered if 3 or more Scatters appear.\r\n         -   5 Scatters
    awards 20 more free spins\r\n         -   4 Scatters awards 15 more free spins\r\n
    \        -   3 Scatters awards 10 more free spins"
