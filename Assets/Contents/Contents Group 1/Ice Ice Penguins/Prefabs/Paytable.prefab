      m_Calls: []
  m_text: '<size=22>-<indent=10>Wild symbols are collected and used to increase the
    Penguin Bonus Gauge and Bonus Bet.</indent>

    -<indent=10>The higher the bet
    level, the greater the Bonus Bet.</indent>

    -<indent=10>All players in the
    same room collect Wild symbols together towards the Penguin Bonus Gauge.</indent>

    -<indent=10>Penguin
    Bonus is triggered when the Penguin Bonus Gauge is full.</indent>

    -<indent=10>Bonus
    Bet is used during the Penguin Bonus.</indent>

    -<indent=10>During the Penguin
    Bonus, players rescue penguins in danger by connecting Ice Tiles.</indent>

    -<indent=10>Penguin
    Bonus results are different depending on the number of installed Ice Tiles, rescued
    Penguins, and found Hidden Treasures.</indent>

    </size>'
