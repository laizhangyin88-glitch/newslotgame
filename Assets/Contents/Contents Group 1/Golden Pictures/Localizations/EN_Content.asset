    value: <style=title><size=32>SCATTER</style>
  - key: PAYTABLE_SYMBOL_NAME_1
    value: <style=title><size=32>WILD</style>
  - key: PAYTABLE_SYMBOL_NAME_2
    value: <style=title><size=24>UNDER THE SPOTLIGHT BONUS</style>
  - key: PAYTABLE_SYMBOL_DESCRIPTION_0
    value: "<size=16>Scatter Pay is multiplied by Total Bet.\n3 or more Scatters triggers
      \nBest Picture Bonus."
  - key: PAYTABLE_SYMBOL_DESCRIPTION_1
    value: '<size=16>Wild substitutes for all symbols except Scatter and Spotlight
      symbols.

      Wild appears on reels 2, 3, 4, & 5 only.'
  - key: PAYTABLE_SYMBOL_DESCRIPTION_2
    value: <size=16>6 or more Spotlight symbols triggers Mystery Link Bonus.
  - key: PAYTABLE_SCATTER_SYMBOL_PAYOUT_FORMAT
    value: '<b><size=24>5 <style=coinColor>{2:CommaNumber}</style>

      4 <style=coinColor>{1:CommaNumber}</style>

      3 <style=coinColor>{0:CommaNumber}</style></size></b>'
  - key: PAYTABLE_SPECIAL_SYMBOL_PAYOUT_FORMAT
    value: '<b><size=24>5 <style=coinColor>{3:CommaNumber}</style>

      4 <style=coinColor>{2:CommaNumber}</style>

      3 <style=coinColor>{1:CommaNumber}</style>

      2 <style=coinColor>{0:CommaNumber}</style></size></b>'
  - key: PAYTABLE_SYMBOL_PAYOUT_FORMAT
    value: '<b><size=24>5 <style=coinColor>{2:CommaNumber}</style>

      4 <style=coinColor>{1:CommaNumber}</style>

      3 <style=coinColor>{0:CommaNumber}</style></size></b>'
  - key: PAYTABLE_TITLE_PAGE_2
    value: <style=title><size=42>UNDER THE SPOTLIGHT BONUS</size></style>
  - key: PAYTABLE_DESCRIPTION_PAGE_2
    value: "<size=24> - 6 or more Spotlight symbols triggers the Under the Spotlight
      Bonus.\n - When triggered, user is awarded the sum total of credit values received
      on \n   Spotlight symbols.\n - Initial Spotlight symbols get locked while remaining
      spots spin 3 times for free. \n - Receiving one or more Spotlights in the empty
      spots re-sets number of \n   free spins to 3. \n - When bonus ends, combine
      all credit value on Spotlight symbols.\n - 15 Spotlights awards Grand Jackpot!"
  - key: PAYTABLE_TITLE_PAGE_3
    value: <style=title><size=42>BEST PICTURE BONUS</size></style>
  - key: PAYTABLE_DESCRIPTION_PAGE_3
    value: "<size=24>-  3 or more Scatters in any position triggers the Best Picture
      Bonus.\n- Select a poster to determine a Bonus game.\n- 3 types of Bonus games
      are: \n  1) Under the Spotlight, 2) Free Games with added Wild symbols, \n  and
      3) both Bonuses combined.\n- During Free Games, 25, 75, or 150 Wilds will be
      randomly added to the reels. "
  - key: PAYTABLE_WAY_INFO
    value: <size=24><color=#00eaff>50 LINES</color></size>
  - key: PAYTABLE_BET_INFO
    value: '<size=24><color=#00eaff>Bet Per Line: 1</color></size>'
  - key: PAYTABLE_TITLE_LINES
    value: <style=title><size=42>LINES</size></style>
  - key: PAYTABLE_TITLE_JACKPOTS
    value: <style=title><size=42>GRAND & MEGA JACKPOTS</size></style>
  - key: PAYTABLE_DESCRIPTION_JACKPOTS
    value: '<size=24>- Each spin provides the user an opportunity to win the Jackpot.

      - After each spin, either a GRAND or MEGA JACKPOT may be awarded.

      - Jackpots are available for qualifying bets only.'
  - key: BUTTON_FREE_SPIN_START
    value: START
  - key: CONTENTS_GAME_TITLE
    value: Golden Pictures
