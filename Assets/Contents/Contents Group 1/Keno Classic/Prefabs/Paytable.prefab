  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<size=24>- Pick a set of numbers between 1 and 80. Select between 2 to
    10 different spots.\n- From there, 20 numbers are drawn randomly. \_\n- The player
    wins if numbers drawn match the numbers picked. \n- Payout is determined by the
    number of spots picked and how many of them \n  correspond to the numbers drawn
    randomly. </size>"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 5316d286fa94a894888ee12767189de0, type: 2}
