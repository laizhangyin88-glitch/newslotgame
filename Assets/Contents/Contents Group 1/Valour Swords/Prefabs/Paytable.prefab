  m_RaycastTarget: 0
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<size=20>-<b>3</b>            symbols on reels <b>2</b>, <b>3</b> and <b>4</b>
    triggers <style=coinColor><b>Way of Glory Bonus Games</b></style>.\n\n-Spin the
    wheel to get the number of steps along the trail and <style=coinColor><b>Grand
    Jackpot</b></style>!\n\n-Stops on the trail:\n     \n     1.            : Coin
    Prize and allows to spin again.\n     \n     2.           : Randomly rewards one
    of the following options.\n          <style=coinColor>-Trick of Aramis Respins</style>:
    Respins without\n          <style=coinColor>-Parthos' Bounty Respins</style>:
    Respins with Random Wilds\n          <style=coinColor>-Firmness of Athos Respins</style>:
    Respins with Random Wild Reels\n     \n     3. Three Musketeer Stops: Triggers
    relevant Free Games\n          <style=coinColor>-<b>Aramis Free Games</b></style>\n
    \         <style=coinColor>-<b>Parthos Free Games</b></style>\n          <style=coinColor>-<b>Athos
    Free Games</b></style></size>"
