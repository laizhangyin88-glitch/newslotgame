  - key: PAYTABLE_SYMBOL_NAME_1
    value: <style=title><color=#f85a20><size=32>WILD</style></size></color>
  - key: PAYTABLE_SYMBOL_PAYOUT_FORMAT
    value: '<b><size=24>5 <style=coinColor>{2:CommaNumber}</style>

      4 <style=coinColor>{1:CommaNumber}</style>

      3 <style=coinColor>{0:CommaNumber}</style></size></b>'
  - key: PAYTABLE_SYMBOL_DESCRIPTION_1
    value: "<size=20>-Appears on all reels and substitutes\n  for all symbols except</size>"
  - key: PAYTABLE_TITLE_1
    value: <style=title><color=#f85a20><size=32>QUEEN'S MISSIONS</style></size></color>
  - key: PAYTABLE_DESCRIPTION_MISSIONS
    value: "<size=20>-Completing a <style=coinColor>Mission</style> upgrades the same
      type of <style=coinColor>Free Games</style>\n  by increasing the number of free
      spins.\n\n-The more missions completed, the more spins for the <style=coinColor>Free
      Games</style>.</size>"
  - key: PAYTABLE_TITLE_2
    value: <style=title><color=#f85a20><size=32>WAY OF GLORY BONUS GAMES</size></style></color>
  - key: PAYTABLE_DESCRIPTION_1
    value: "<size=20>-<b>3</b>            symbols on reels <b>2</b>, <b>3</b> and
      <b>4</b> triggers <style=coinColor><b>Way of Glory Bonus Games</b></style>.\n\n-Spin
      the wheel to get the number of steps along the trail and <style=coinColor><b>Grand
      Jackpot</b></style>!\n\n-Stops on the trail:\n     \n     1.            : Coin
      Prize and allows to spin again.\n     \n     2.           : Randomly rewards
      one of the following options.\n          <style=coinColor>-Trick of Aramis Respins</style>:
      Respins without\n          <style=coinColor>-Porthos Bounty Respins</style>:
      Respins with Random Wilds\n          <style=coinColor>-Firmness of Athos Respins</style>:
      Respins with Random Wild Reels\n     \n     3. Three Musketeer Stops: Triggers
      relevant Free Games\n          <style=coinColor>-<b>Aramis Free Games</b></style>\n
      \         <style=coinColor>-<b>Porthos Free Games</b></style>\n          <style=coinColor>-<b>Athos
      Free Games</b></style></size>"
  - key: PAYTABLE_TITLE_3
    value: <style=title><color=#f85a20><size=32>RITZY MUSKETEERS FREE GAMES</size></style></color>
  - key: PAYTABLE_DESCRIPTION_2
    value: "<size=20>-Each Free Games can only be triggered through winning a relevant
      Musketeer Stop.\n\n-All Wilds during Free Games appear with a multiplier.\n
      \    -Aramis Free Games \u2013 Wilds appear with Multiplier <style=coinColor><b>X2</b></style>\n
      \    -Porthos Free Games \u2013 Wilds appear with Multiplier <style=coinColor><b>X3</b></style>\n
      \    -Athos Free Games \u2013 Wilds appear with Multiplier <style=coinColor><b>X4</b></style>\n\n-The
      number of spins for each Free Games depends on the number \n  of complete missions
      of the same type."
  - key: PAYTABLE_TITLE_LINES
    value: <size=32><color=#f85a20>LINES</size></color>
