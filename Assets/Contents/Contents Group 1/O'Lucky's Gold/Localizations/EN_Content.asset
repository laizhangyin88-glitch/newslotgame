  - key: CONTENTS_GAME_TITLE
    value: O'Lucky Gold
  - key: PAYTABLE_TITLE_PAGE_1
    value: <size=42>PAY TABLE
  - key: PAYTABLE_TITLE_PAGE_2
    value: <size=42>PAY LINE
  - key: PAYTABLE_SYMBOL_DESCRIPTION_1_1
    value: <size=25><color=#0d8c00><b>SCATTER</b>
  - key: PAYTABLE_DESCRIPTION_PAGE_1_1
    value: "<size=23><color=#ffe400><b>WILD</b> <size=17><color=#ffffff><b>SUBSTITUTES
      \nFOR ALL SYMBOLS\nEXCEPT <size=23><color=#0d8c00></b><b>SCATTER.</b>"
  - key: PAYTABLE_DESCRIPTION_PAGE_1_2
    value: '<size=19><color=#0d8c00><b>SCATTER</b> <size=13><color=#ffffff><b> WINS
      PAY IN ANY

      POSITION, AND ARE MULTIPLIED

      BY THE TOTAL BET.</b>'
  - key: PAYTABLE_DESCRIPTION_PAGE_1_3
    value: <b><size=19><color=#ffe400>3 <size=13><color=#ffffff>OR MORE <color=#0d8c00>SCATTER
      <color=#ffffff>TRIGGER <color=#ffe400>BONUS.</b>
  - key: PAYTABLE_SYMBOL_PAYOUT_FORMAT_0
    value: '<b><size=24>5 <style=coinColor>{3:CommaNumber}</style></b>

      <b>4 <style=coinColor>{2:CommaNumber}</style></b>

      <b>3 <style=coinColor>{1:CommaNumber}</style></size></b>

      <b>2 </b><style=coinColor><b>{0:CommaNumber}</style></size></b>'
  - key: PAYTABLE_SYMBOL_PAYOUT_FORMAT_1
    value: '<b><size=20>5 <style=coinColor>{2:CommaNumber}</style>

      4 <style=coinColor>{1:CommaNumber}</style>

      3 <style=coinColor>{0:CommaNumber}</style></size></b>'
  - key: PAYTABLE_SYMBOL_PAYOUT_FORMAT_2
    value: '<b><size=32>5 <style=coinColor>{2:CommaNumber}</style>

      4 <style=coinColor>{1:CommaNumber}</style>

      3 <style=coinColor>{0:CommaNumber}</style></size></b>'
  - key: PAGE_5_TITLE_1
    value: <size=40>O'LUCKY'S
  - key: PAGE_5_TITLE_2
    value: <size=40>FREE SPIN BONUS
  - key: PAGE_5_TITLE_3
    value: <size=20>FEATURING GROWING WILD STACKS!
  - key: PAYTABLE_DESCRIPTION_PAGE_5_1
    value: <b><size=15><color=#ffffff>LAND<size=19><color=#ffe400> 3<size=15><color=#ffffff>
      OR MORE<color=#0d8c00> SCATTERS <color=#ffffff>ANYWHERE TO WIN <size=19><color=#ffe400>10
      FREE SPINS.</size></b>
  - key: PAYTABLE_DESCRIPTION_PAGE_5_2
    value: '<b><size=15><color=#ffffff>EACH<color=#0d8c00> SCATTER<color=#ffffff>
      THAT LANDS DURING <color=#ffe400>FREE SPINS<color=#ffffff> GROWS THE <color=#ffe400>WILD

      <color=#ffffff>STACKS ON EACH REEL BY ADDING <size=19><color=#ffe400>1 <size=15><color=#ffffff>EXTRA
      <color=#ffe400>WILD <color=#ffffff>SYMBOL TO ALL

      <size=19><color=#ffe400>5 <size=15><color=#ffffff>REELS FOR THE REMAINING <color=#ffe400>FREE
      SPINS.</size></b>'
  - key: PAYTABLE_DESCRIPTION_PAGE_5_3
    value: '<b><size=19><color=#ffe400>10 <size=15><color=#ffffff>ADDITIONAL <color=#ffe400>FREE
      SPINS <color=#ffffff>ARE AWARDED FOR LANDING <size=19><color=#ffe400>3 <size=15><color=#ffffff>OR

      MORE <color=#0d8c00>SCATTERS <color=#ffffff>DURING <color=#ffe400>FREE SPINS.'
  - key: PAYTABLE_DESCRIPTION_PAGE_5_4
    value: <b><size=15><color=#ffffff>ANY ADDED <color=#ffe400>WILDS <color=#ffffff>ARE
      REMOVED AT END OF THE <color=#ffe400>FREE SPINS.
  - key: PAYTABLE_TITLE_LINES
    value: <style=title><size=42>LINES
  - key: PAYTABLE_WAY_INFO
    value: <size=24><color=#00eaff>25 LINES</color></size>
  - key: PAYTABLE_BET_INFO
    value: '<size=24><color=#00eaff>Bet Per Line: 1</color></size>'
  - key: PAYTABLE_DESCRIPTION_1
    value: '<b><size=15><color=#00dc96>ANY LINE WINS MULTIPLIED BY LINE BET.

      HIGHEST WIN PAID ON ANY LIT PAYLINE.

      LINE PAYS MUST OCCUR ON ADJACENT REELS, BEGINNING WITH THE LEFTMOST REEL.</size></b>'
