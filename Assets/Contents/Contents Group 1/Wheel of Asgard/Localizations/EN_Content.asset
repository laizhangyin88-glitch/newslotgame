  - key: PAYTABLE_TITLE_LINES
    value: <style=title><size=42>LINES
  - key: PAYTABLE_WAY_INFO
    value: <size=24><color=#00eaff>243 WAYS</color></size>
  - key: PAYTABLE_BET_INFO
    value: '<size=24><color=#00eaff>BASE BET: 100</color></size>'
  - key: PAYTABLE_SYMBOL_NAME_1
    value: <color=#f9e97d>WILD</color>
  - key: PAYTABLE_SYMBOL_DESCRIPTION_1
    value: "<color=#ffba00>Wild substitutes for all symbols except Scatter and appears
      on reels 1 and 2 only.\r\n\nIf Wild appears on reels 1 and 2, then reels 3-5
      expand to the height of 5.</color>"
  - key: PAYTABLE_SYMBOL_NAME_2
    value: <color=#f9e97d>Thor Bonus</color>
  - key: PAYTABLE_SYMBOL_DESCRIPTION_2
    value: '<color=#ffba00>Thor Symbols appear on reels 3-5 only.


      Thor Symbols display coin amounts or Jackpots.


      Thor Bonus prize is multiplied by the bet multiplier.


      Thor Bonus prize on reels 3 and 4 is coin prizes.


      Only MINI and MINOR Jackpot prizes appear on reel 5.


      If Wild appears on reel 1 and 2, reels 3-5 expand, and player wins all Thor
      Bonus prizes that appear consecutively from reel 3.</color>'
  - key: PAYTABLE_SYMBOL_NAME_3
    value: <color=#f9e97d>Scatter</color>
  - key: PAYTABLE_SYMBOL_DESCRIPTION_3
    value: <color=#ffba00>3 or more Scatters triggers Free Games.</color>
  - key: PAYTABLE_SYMBOL_NAME_4
    value: <color=#f9e97d>Thunder Wheel Bonus</color>
  - key: PAYTABLE_SYMBOL_DESCRIPTION_4
    value: '<color=#ffba00>5 of a kind with any symbol triggers Thunder Wheel Bonus.


      Thunder Wheel Bonus can be triggered in both Base and Free Games.


      Through Thunder Wheel Bonus, multipliers or Jackpots can be won.


      Winning Free Games wedge awards 15 Free Games.</color>'
  - key: PAYTABLE_SYMBOL_NAME_5
    value: <color=#f9e97d>Free Games</color>
  - key: PAYTABLE_SYMBOL_DESCRIPTION_5
    value: '<color=#ffba00>Free Games is triggered by receiving 3 or more Scatters
      in Base Game, or winning the Free Games wedge on the Wheel Bonus.

      Award 15 Free Games when Free Games triggered.

      Reel expansion is 3x3x5x5x5.Free Games can be re-triggered through Scatters
      or the Wheel Bonus.</color>'
  - key: PAYTABLE_SYMBOL_PAYOUT_1
    value: "<color=#FFFFFF>5: <color=#FFEA00>400\r</color>\n4: <color=#FFEA00>200\r</color>\n3:
      <color=#FFEA00>100\r</color>"
  - key: PAYTABLE_SYMBOL_PAYOUT_2
    value: "<color=#FFFFFF>5: <color=#FFEA00>250\r</color>\n4: <color=#FFEA00>100\r</color>\n3:
      <color=#FFEA00>50\r</color>"
  - key: PAYTABLE_SYMBOL_PAYOUT_3
    value: "<color=#FFFFFF>5: <color=#FFEA00>200\r</color>\n4: <color=#FFEA00>100\r</color>\n3:
      <color=#FFEA00>35\r</color>"
  - key: PAYTABLE_SYMBOL_PAYOUT_4
    value: "<color=#FFFFFF>5: <color=#FFEA00>200\r</color>\n4: <color=#FFEA00>100\r</color>\n3:
