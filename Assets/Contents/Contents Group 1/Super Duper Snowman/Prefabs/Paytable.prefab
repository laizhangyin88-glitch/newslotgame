      m_Calls: []
  m_text: '<size=21>-   The Snowball Feature is triggered randomly during Base Games.


    -   When triggered, the snowman throws multiple Snowball Symbols to the spinning
    reels.


    -   Snowball Symbols are locked in position and turn into Wilds after reels stop.'
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 9adfec5188f3c5e42b9b364862f5f6ca, type: 2}
  m_sharedMaterial: {fileID: 21000010116884160, guid: 9adfec5188f3c5e42b9b364862f5f6ca,
    type: 2}
