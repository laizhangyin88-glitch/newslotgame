  - key: PAYTABLE_TITLE_PAGE_1
    value: <style=title><size=42>BASE PAYS</style>
  - key: PAYTABLE_TITLE_PAGE_3
    value: <style=title><size=42>HIGH SEAS BONUS</style>
  - key: PAYTABLE_DESCRIPTION_PAGE_3
    value: "<size=22>Land 3 BONUS symbols on reels 1,3&5 to\nactivate the High Seas
      Bonus feature.\n\nFire cannons and hit enemy ships to win \nFREE SPINS and COIN
      PRIZES.\n\nIncrease your free spins MULTIPLIER\nby sinking ships.\n\nAll line
      wins are multiplied by the multiplier\nexcept for 5x WILD on a line, \nwhich
      is not multiplied."
  - key: PAYTABLE_TITLE_PAGE_4
    value: <style=title><size=42>FREE SPINS PAYS</style>
  - key: PAYTABLE_TITLE_PAGE_7
    value: <style=title><size=42>GAME RULES</style>
  - key: PAYTABLE_DESCRIPTION_PAGE_7
    value: "<size=24>All wins play LEFT to RIGHT on adjacent reels,\nbeginning with
      leftmost reel.\n\nAll wins are paid on 25 fixed lines played.\nHighest win paid
      on each line.\n\nAll wins are multiplied by the number of \ncoins bet per line.\n\nWILD
      substitutes for all symbols except BONUS."
  - key: PAYTABLE_TITLE_LINES
    value: <style=title><size=42>LINES</size></style>
  - key: PAYTABLE_WAY_INFO
    value: <size=24><color=#00eaff>25 LINES</color></size>
  - key: PAYTABLE_BET_INFO
    value: '<size=24><color=#00eaff>Bet Per Line: 1</color></size>'
  - key: CONTENTS_GAME_TITLE
    value: Coins Ahoy
