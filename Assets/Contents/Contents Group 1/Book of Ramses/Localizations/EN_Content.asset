  - key: PAYTABLE_TITLE_PAGE_2_2
    value: <style=title><size=42>FEATURE</style>
  - key: PAYTABLE_DESCRIPTION_PAGE_2_1
    value: "<size=22>- 3 or more Scatters triggers 10 Free Games with a special expanding
