  - key: PAYTABLE_BET_INFO
    value: '<size=24><color=#00eaff>BASE BET: 50</color></size>'
  - key: CONTENTS_GAME_TITLE
    value: Sexy Showtime Khal
  - key: BUTTON_FREE_SPIN_START
    value: START
  - key: PAYTABLE_BONUS
    value: <style=title><size=32>BONUS</size></style>
  - key: PAYTABLE_BONUS_DESCRIPTION
    value: "<size=16>- 5 or more Bonus Symbols \n   any where on reels triggers\n  
      Khal Bonus Game.\r</size>"
  - key: PAYTABLE_SCATTER_PAYS
    value: <style=title><size=32>SCATTER PAYS</size></style>
  - key: PAYTABLE_SCATTER_PAYS_DESCRIPTION
    value: "<size=16>- All Symbols are Scatters.\n\n- Wins can occur in any\n   
      Position and are not limited\n    to direction or reel placement.\n</size>"
  - key: PAYTABLE_BONUS_FEATURE
    value: <style=title><size=32>KHAL BONUS</size></style>
  - key: PAYTABLE_BONUS_FEATURE_DESCRIPTION
    value: "<size=18>\n- Regardless of the number of triggering Bonus Symbols, 5
      spins\n    are awarded.\r\n\n- In Khal Bonus Game, whenever there is a symbol
      win, the winning\n    symbols award pays, are removed, the remaining symbols
      are\n    cascading and it repeats until there is no win.\r\n\n- There's a Multiplier
      Gauge above the reels and any wins at a spin\n    fills one spot.\r\n\n- Multiplier
      Gauge starts with x1 and every time 3 spots are filled,\n    multiplier interger
      increases.\r\n\n- Progression of Multiplier Gauge remains until there is no\n   
      remaining spins.\r\n\n- 5 Jackpot Symbols, one per reel, awards Grand Jackpot.\n</size>"
  - key: PAYTABLE_SYMBOL_PAYOUT_FORMAT
    value: '<b><size=24>

      5 <style=coinColor>{2:CommaNumber}</style>

      4
      <style=coinColor>{1:CommaNumber}</style>

      3 <style=coinColor>{0:CommaNumber}</style>

      </size></b>'
  - key: PAYTABLE_SYMBOL_PAYOUT_FORMAT_2
    value: '<b><size=24>

      5 <style=coinColor>{1:CommaNumber}</style>

      4
      <style=coinColor>{0:CommaNumber}</style>

      </size></b>'
  - key: PAYTABLE_SYMBOL_PAYOUT_FORMAT_3
    value: '<b><size=24>

      5 <style=coinColor>{0:CommaNumber}</style>

      </size></b>'
