  - key: PAYTABLE_WAY_INFO
    value: <size=24><color=#00eaff>576 Ways</color></size>
  - key: PAYTABLE_BET_INFO
    value: '<size=24><color=#00eaff>Base Bet: 100</color></size>'
  - key: CONTENTS_GAME_TITLE
    value: Wild Hit Buffalo
  - key: BUTTON_FREE_SPIN_START
    value: START
  - key: "PAYTABLE_\bWILD"
    value: <style=title><size=32>WILD SYMBOL</size></style>
  - key: PAYTABLE_WILD_DESCRIPTION_1
    value: "<size=16>\n - Appears on reels 1 and 2 and can \n   substitute for all
      symbols except \n   Scatter.\n</size>"
  - key: PAYTABLE_WILD_DESCRIPTION_2
    value: "<size=16>\n - Wild Symbols on both reels 1 and 2 triggers Wild Hit Feature.\n</size>"
  - key: PAYTABLE_BUFFALO_SYMBOL
    value: <style=title><size=32>BUFFALO SYMBOL</size></style>
  - key: PAYTABLE_BUFFALO_SYMBOL_DESCRIPTION
    value: "<size=16>\n - Appears on reels 3-5.\n\n - Appears with Credit, Mini,
      Minor, Major or \n   Mega Jackpot.\n</size>"
  - key: PAYTABLE_WILD_HIT_FEATURE
    value: <style=title><size=32>WILD HIT FEATURE</size></style>
  - key: PAYTABLE_WILD_HIT_FEATURE_DESCRIPTION
    value: "<size=16>\n - When there are Wild Symbols on reels 1 and 2, Wild Hit
      Feature is triggered.\n\n - Consecutive Buffalo Symbols from reel 3 awards
      the prize on them.\n</size>"
  - key: PAYTABLE_SCATTER_SYMBOL
    value: <style=title><size=32>SCATTER SYMBOL</size></style>
  - key: PAYTABLE_SCATTER_SYMBOL_DESCRIPTION
    value: "<size=16>\n - Appears on all reels.\r\n - 3 or more Scatter Symbol triggers
      Wheel Bonus.\r\n</size>"
  - key: PAYTABLE_WHEEL_BONUS
    value: <style=title><size=32>WHEEL BONUS</size></style>
  - key: PAYTABLE_WHEEL_BONUS_DESCRIPTION
    value: "<size=16>\n - There are two types of Wheels; Main Wheel with Jackpots
      and Free Games \n   & Bonus Wheel with Multipliers. \n\n - Player can win as
      many Jackpots as possible until winning Free Games.\n</size>"
  - key: PAYTABLE_FREE_GAME
    value: <style=title><size=32>FREE GAME</size></style>
  - key: PAYTABLE_FREE_GAME_DESCRIPTION
    value: "<size=16>\n - Free Games is triggered through Wheel Bonus.\n\n - During
      Free Games, on reels 1 and 2, Wild appears with a multiplier \n   x2 or x3.\n\n
      - Multiplier Wilds on both reels 1 and 2 trigger Wild Hit Feature and apply
      \n   multipliers to Buffalo payouts. \n\n - 2 or moe Free Game Symbols awards
      additioonal Free Games. \n</size>"
  - key: PAYTABLE_LINES
    value: <style=title><size=32>LINES</size></style>
  - key: PAYTABLE_SYMBOL_PAYOUT_FORMAT
    value: '<b><size=24>

      5 <style=coinColor>{2:CommaNumber}</style>

      4
      <style=coinColor>{1:CommaNumber}</style>

      3 <style=coinColor>{0:CommaNumber}</style>

      </size></b>'
