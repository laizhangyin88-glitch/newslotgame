    value: <style=title><size=32>SCATTER</style>
  - key: PAYTABLE_SYMBOL_NAME_0
    value: <style=title><size=32>WILD</style>
  - key: PAYTABLE_SYMBOL_NAME_11
    value: <style=title><size=32>BONUS</style>
  - key: PAYTABLE_SYMBOL_DESCRIPTION_10
    value: "<size=16>Scatter Pay is multiplied by Total Bet.\n3 or more Scatters triggers
      \nFree Games Bonus."
  - key: PAYTABLE_SYMBOL_DESCRIPTION_0
    value: '<size=15>Wild substitutes for all symbols except Scatter and Bonus symbols.

      Wild appears on reels 2, 3, 4, & 5 only.'
  - key: PAYTABLE_SYMBOL_DESCRIPTION_11
    value: <size=18>6 or more Bonus symbols triggers Mystery Link Bonus.
  - key: PAYTABLE_SPECIAL_SYMBOL_PAYOUT_FORMAT
    value: '<b><size=24>5 <style=coinColor>{3:CommaNumber}</style>

      4 <style=coinColor>{2:CommaNumber}</style>

      3 <style=coinColor>{1:CommaNumber}</style>

      2 <style=coinColor>{0:CommaNumber}</style></size></b>'
  - key: PAYTABLE_SYMBOL_PAYOUT_FORMAT
    value: '<b><size=24>5 <style=coinColor>{2:CommaNumber}</style>

      4 <style=coinColor>{1:CommaNumber}</style>

      3 <style=coinColor>{0:CommaNumber}</style></size></b>'
  - key: PAYTABLE_TITLE_MYSTERY
    value: <style=title><size=42>MYSTERY LINK BONUS</size></style>
  - key: PAYTABLE_DESCRIPTION_MYSTERY
    value: "<size=24>- 6 or more Bonus symbols triggers the Mystery Link Bonus.\n-
      User is awarded the sum total of credit values received on Bullet Marks.\n-
      Initial Bonus symbols get locked while remaining spots spin 3 times for free.
      \n- Receiving one or more Bullet Marks in the empty spots re-sets free spins
      to 3. \n- When bonus ends, sum total credit values on Bullet Marks.\n- 15 Bullet
      Marks awards Grand Jackpot!"
  - key: PAYTABLE_TITLE_REVOLVER
    value: <style=title><size=42>REVOLVER FEATURE</size></style>
  - key: PAYTABLE_DESCRIPTION_REVOLVER
    value: "<size=24>- Revolver Feature may be triggered with random probability each
      spin.\n- Revolvers fire up to 6 Bonus symbols. \n- They may also upgrade values
      on existing Bullet Marks.\n- 6 or more Bonus symbols triggers Mystery Link Bonus."
  - key: PAYTABLE_TITLE_FREE
    value: <style=title><size=42>FREE GAMES BONUS</size></style>
  - key: PAYTABLE_DESCRIPTION_FREE
    value: '<size=24>- 3 or more Scatters triggers Free Games Bonus.

      - In Free Games, all symbols except Scatter may appear stacked.'
  - key: PAYTABLE_WAY_INFO
    value: <size=24><color=#00eaff>50 LINES</color></size>
  - key: PAYTABLE_BET_INFO
    value: '<size=24><color=#00eaff>Bet Per Line: 1</color></size>'
  - key: PAYTABLE_TITLE_LINES
    value: <style=title><size=42>LINES</size></style>
  - key: BUTTON_FREE_SPIN_START
    value: START
  - key: INGAME_LEFT_BOTTOM_RESPIN_COUNT
    value: '<b><size=42><color=#fff94f>{0} of {1}</color></size>

      <size=28>RESPINS</size></b>'
  - key: PAYTABLE_SCATTER_SYMBOL_PAYOUT_FORMAT
    value: '<b><size=24>5 <style=coinColor>{2:CommaNumber}</style>

      4 <style=coinColor>{1:CommaNumber}</style>

      3 <style=coinColor>{0:CommaNumber}</style></size></b>'
  - key: PAYTABLE_TITLE_JACKPOTS
    value: <style=title><size=42>GRAND & MEGA JACKPOTS</size></style>
  - key: PAYTABLE_DESCRIPTION_JACKPOTS
    value: '<size=20>- Each spin provides the user an opportunity to win the Jackpot.

      - After each spin, either a GRAND or MEGA JACKPOT may be awarded.

      - Jackpots are available for qualifying bets only.'
  - key: CONTENTS_GAME_TITLE
    value: Wild Saloon
