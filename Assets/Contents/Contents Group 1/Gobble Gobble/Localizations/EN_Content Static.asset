  - key: PAYTABLE_SYMBOL_DESCRIPTION_0
    value: "<size=18>Wild substitutes for all \nsymbols except Scatter.\r"
  - key: PAYTABLE_SYMBOL_DESCRIPTION_1
    value: "<size=18>Scatter appears on reels 1, 3, and 5. \v3 Scatters triggers Free
