  - key: PAYTABLE_SYMBOL_NAME_1
    value: <style=title><size=32>COLLECT</style>
  - key: PAYTABLE_DESCRIPTION_FREE
    value: '<size=15>- Free Game begins in a single slot with 30 lines.

      - Collecting 3 treats for a symbol on the Collect Board changes the corresponding
      symbol into a Wild symbol in reels 2, 3, 4 and 5.

      - The changed symbols will appear as Wild symbols until the Free Game is over.

      - The Collect Symbol appears on reel 5 only, increases the collect count then
      turns into a Wild Symbol.


'
  - key: PAYTABLE_DESCRIPTION_MEGAFREE
    value: '<size=15>- Mega Free Games begins with 4 slots with 120 lines total.

      - Collecting 3 treats for a symbol on the Collect Board changes the corresponding
      symbol into a Wild symbol in reels 2, 3, 4 and 5.

      - The changed symbols will appear as Wild symbols until the Free Game is over.

      - The Collect Symbol appears on reel 5 only, increases the collect count then
      turns into a Wild Symbol.

'
  - key: PAYTABLE_DESCRIPTION_FREE_2
    value: "<size=17>3                triggers Free Games.\n    "
  - key: PAYTABLE_DESCRIPTION_MEGAFREE_2
    value: "<size=17>3               triggers Mega  Free Games.\r"
  - key: PAYTABLE_TITLE_FREE
    value: <style=title><size=45>FREE GAMES</size></style>
  - key: PAYTABLE_TITLE_MEGAFREE
    value: <style=title><size=45>MEGA FREE GAMES</size></style>
  - key: PAYTABLE_DESCRIPTION_FORTUNE
    value: "<size=20>- 12 candies will appear. \n- Picking among 12 candies will reveal
      Mini, Minor, Mega, or Grand Jackpot Symbols at random.\r\n- Revealing 3 of the
      same Jackpot Symbols will award you the corresponding jackpot.\r"
  - key: PAYTABLE_TITLE_FORTUNE
    value: <style=title><size=45>FORTUNE CANDY FEATURE</size></style>
  - key: PAYTABLE_SYMBOL_DESCRIPTION_11
    value: '<size=16>3 Scatters triggers

      Free Games or Mega Free Games.'
  - key: PAYTABLE_SYMBOL_PAYOUT_FORMAT
    value: '<b><size=24>5 <style=coinColor>{2:CommaNumber}</style>

      4 <style=coinColor>{1:CommaNumber}</style>

      3 <style=coinColor>{0:CommaNumber}</style></size></b>'
  - key: PAYTABLE_WAY_INFO
    value: <size=24><color=#00eaff>30 LINES X 4 Slots</color></size>
  - key: PAYTABLE_WAY_INFO_2
    value: <size=24><color=#00eaff>30 LINES X 1 Slot</color></size>
  - key: PAYTABLE_BET_INFO
    value: '<size=24><color=#00eaff>Bet Per Line: 1</color></size>'
  - key: PAYTABLE_SYMBOL_DESCRIPTION_1
    value: "<size=16>Appears during Free Games or Mega Free Games on reel 5. Increases
      the collect count then turns into a Wild Symbol.\r"
  - key: PAYTABLE_SYMBOL_DESCRIPTION_0
    value: "<size=16>Wild substitutes for all symbols except Scatter and appears on
      reels 2, 3, 4 and 5 only.\r"
  - key: PAYTABLE_TITLE_LINES
    value: "<size=15>Scatter Pay is multiplied by Total Bet.   \n3 or more Scatters
      triggers Free Games Bonus."
  - key: CONTENTS_GAME_TITLE
    value: Spooky Sweets
