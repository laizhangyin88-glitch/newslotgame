  - key: PAYTABLE_DESCRIPTION_PAGE_1_1
    value: "<size=22>-<indent=10>Wild substitutes for all symbols except \n            
      ,            ,             and          .</indent>\n-<indent=10>Wild appears
      on reels 2, 3, 4 and 5 only.</indent>\n</size>"
  - key: PAYTABLE_SYMBOL_PAYOUT_FORMAT
