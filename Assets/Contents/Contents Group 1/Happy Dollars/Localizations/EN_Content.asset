    value: "<b><size=24>\n<color=#ffea00>20000</style>\n<color=#ffea00>15000</style>\n<color=#ffea00>10000</style></b>\n\r\n<size=22><color=#FFFFFF>100</color>\n<color=#FFFFFF>75</color>\n<color=#FFFFFF>50</color>\n<color=#FFFFFF>45</color>\n<color=#FFFFFF>40</color>\n<color=#FFFFFF>35</color>\n<color=#FFFFFF>30</color>\n<color=#FFFFFF>25</color>\n</size>"
  - key: PAYTABLE_NUMBER_DESCRIPTION_PAGE_2_7
    value: "<b><size=24>\n<color=#ffea00>20000</style>\n<color=#ffea00>15000</style>\n<color=#ffea00>10000</style></b>\n\r\n<size=22><color=#FFFFFF>100</color>\n<color=#FFFFFF>75</color>\n<color=#FFFFFF>20</color>\n<color=#FFFFFF>18</color>\n<color=#FFFFFF>16</color>\n<color=#FFFFFF>14</color>\n<color=#FFFFFF>12</color>\n<color=#FFFFFF>10</color>\n</size>"
  - key: PAYTABLE_NUMBER_DESCRIPTION_PAGE_2_8
