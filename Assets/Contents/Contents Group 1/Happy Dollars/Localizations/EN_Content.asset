    value: "<b><size=24>\n<color=#ffea00>20000</style>\n<color=#ffea00>15000</style>\n<color=#ffea00>10000</style></b>\n\r\n<size=22><color=#FFFFFF>1200</color>\n<color=#FFFFFF>1100</color>\n<color=#FFFFFF>1000</color>\n<color=#FFFFFF>900</color>\n<color=#FFFFFF>800</color>\n<color=#FFFFFF>700</color>\n<color=#FFFFFF>600</color>\n<color=#FFFFFF>500</color>\n</size>"
  - key: PAYTABLE_NUMBER_DESCRIPTION_PAGE_2_3
