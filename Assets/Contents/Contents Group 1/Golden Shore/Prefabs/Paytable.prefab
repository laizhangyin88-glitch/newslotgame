  m_RaycastTarget: 0
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "- Base Game consists of 3 levels. Each level has a different symbol set
    with different\n   values and features.\r\n- Each spin, player goes down along
    the progression bar and uses oxygen        .     \r\n- Oxygen can be obtained
    from Oxygen symbol on reels.\r\n- The current amount of oxygen is shown on           (beware
    red zone).\n- Once oxygen runs out, the adventure ends.\r\n- Each denomination
    consists of Base Bet and Extra Bet and the below % indicates\n   the % of Extra
    Bet to the Base Bet:\r\n     Denomination 1: 10% with chance to win up to 3 oxygen
    per oxygen symbol   \r\n     Denomination 2: 20% with chance to win up to 4 oxygen
    per oxygen symbol   \r\n     Denomination 3: 50% with chance to win up to 5 oxygen
    per oxygen symbol   \r\n- Progressive jackpot is available on denomination 3 only.\r"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 5316d286fa94a894888ee12767189de0, type: 2}
  m_sharedMaterial: {fileID: 21000010116884160, guid: 5316d286fa94a894888ee12767189de0,
    type: 2}
  m_fontSharedMaterials: []
