      m_Calls: []
  m_text: "<size=20>- A full stack of 3 Mystery symbols on reel 3 triggers Hold &
    Re-Spin.\n\n- Reel 3 will lock in place, while the remaining reels re-spin once.
    \n\n- If any additional lock symbol appears in any position, lock them in place\n
    \  too and award 1 additional re-spin.\n\n- Re-spins continue until no additional
    lock symbol appears, or if the screen\n   gets filled with the lock symbol.\n\n-
    Player is awarded for any wins formed at the end of re-spins.</size>"
  m_isRightToLeft: 0
