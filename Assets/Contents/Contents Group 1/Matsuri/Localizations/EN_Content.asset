  - key: PAYTABLE_SPECIAL_SYMBOL_NAME_FORMAT
    value: <style=title><size=32>{0:Symbol;Upper}</size></style>
  - key: PAYTABLE_SPECIAL_SYMBOL_SCATTER_HYBRID
    value: '<style=title><size=32>SCATTER &

      HYBRID WILD</size></style>'
  - key: PAYTABLE_SPECIAL_SYMBOL_WILD_HYBRID
    value: '<style=title><size=32>WILD &

      HYBRID WILD</size></style>'
  - key: PAYTABLE_SYMBOL_DESCRIPTION_0
    value: "<size=16>- Wild substitutes for all symbols \nexcept Scatter.\n<size=15>-
      Hybrid Wild acts as both Scatter and Wild.</size>"
  - key: PAYTABLE_SCATTER_SYMBOL_PAYOUT_FORMAT
    value: '<b><size=24>5 <style=coinColor>{2:CommaNumber}</style>

      4 <style=coinColor>{1:CommaNumber}</style>

      3 <style=coinColor>{0:CommaNumber}</style></size></b>'
  - key: PAYTABLE_SPECIAL_SYMBOL_PAYOUT_FORMAT
    value: '<b><size=24>5 <style=coinColor>{3:CommaNumber}</style>

      4 <style=coinColor>{2:CommaNumber}</style>

      3 <style=coinColor>{1:CommaNumber}</style>

      2 <style=coinColor>{0:CommaNumber}</style></size></b>'
  - key: PAYTABLE_ROYAL_SYMBOL_PAYOUT_FORMAT
    value: '<b><size=24>5 <style=coinColor>{2:CommaNumber}</style>

      4 <style=coinColor>{1:CommaNumber}</style>

      3 <style=coinColor>{0:CommaNumber}</style></size></b>'
  - key: PAYTABLE_TITLE_FIRECRACKER_FEATURE
    value: <style=title><size=42>FIRECRACKER FEATURE</size></style>
  - key: PAYTABLE_DESCRIPTION_FIRECRACKER_FEATURE
    value: "<size=24>- The Firecracker feature is triggered at random during base
      and free games.\n- When triggered, fireworks will turn random symbols on the
      reel set to Wild. \n- At random, multipliers may be applied to the total win
      amount from the \n  Firecracker feature.\n</size>"
  - key: PAYTABLE_TITLE_FREE_GAMES
    value: <style=title><size=42>FREE GAMES</size></style>
  - key: PAYTABLE_DESCRIPTION_FREE_GAMES
    value: "<size=24>- 3 or more Scatters in any position triggers Free Games. \n-
      When Wild symbols from the Firecracker feature overlaps with Scatter, \n  the
      symbol will change to a Hybrid Wild that acts as both a Wild and Scatter.\n\n-
      Probability of Firecracker feature is increased during Free Games. \n- During
      Free Games, 3 or more Scatters in any position awards additional\n  Free Games.
      </size>"
  - key: PAYTABLE_WAY_INFO
    value: <size=24><color=#00eaff>40 LINES</color></size>
  - key: PAYTABLE_BET_INFO
    value: '<size=24><color=#00eaff>Bet Per Line: 1</color></size>'
  - key: BUTTON_FREE_SPIN_START
    value: START
  - key: PAYTABLE_TITLE_LINES
    value: <style=title><size=42>LINES</size></style>
  - key: PAYTABLE_TITLE_JACKPOTS
    value: <style=title><size=42>GRAND & MEGA JACKPOTS</size></style>
  - key: PAYTABLE_DESCRIPTION_JACKPOTS
    value: '<size=24>- Each spin provides the user an opportunity to win the Jackpot.

      - After each spin, either a GRAND or MEGA JACKPOT may be awarded.'
  - key: CONTENTS_GAME_TITLE
    value: Matsuri
  - key: PAYTABLE_TITLE_EXTRA_BET
    value: <style=title><size=42>EXTRA BET</size></style>
  - key: PAYTABLE_DESCRIPTION_EXTRA_BET
    value: <size=24>- 50% of Line Bet is added as Extra Bet to activate the Firecracker
      Feature.</size>
