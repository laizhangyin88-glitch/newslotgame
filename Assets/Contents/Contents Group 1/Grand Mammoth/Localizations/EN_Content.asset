  - key: PAYTABLE_BET_INFO
    value: '<size=24><color=#e5ccdc>Bet Per Line: 1</color></size>'
  - key: PAYTABLE_TITLE_1
    value: <style=title><color=#f17ccf><size=32>NUDGING WILD</color>
  - key: PAYTABLE_DESCRIPTION_1
    value: '<size=23>Appears on all reels.

      Substitutes for all symbols

      except           and          .

      Wild nudges the reel up or down

      to create a full stack.'
  - key: PAYTABLE_TITLE_2
    value: "<style=title><color=#f17ccf><size=32>WOOLLY WILD \nFREE GAMES</color>"
  - key: PAYTABLE_DESCRIPTION_2
    value: '<size=23>3 or more           anywhere on reels

      triggers Free Games.


      <color=#56fbff>3 Scatters</color> - <color=#56fbff>5 Free Games</color>

      <color=#56fbff>4 Scatters</color> - <color=#56fbff>10 Free Games</color>

      <color=#56fbff>5 Scatters</color> - <color=#56fbff>15 Free Games</color>


      During Free Games, Nudging Wild

      can appear with <color=#56fbff>X2</color>, <color=#56fbff>X3</color> or <color=#56fbff>X4</color>

      multiplier on them.


      Free Games can be re-triggered

      the same as in Base Games. '
  - key: PAYTABLE_SPECIAL_SYMBOL_PAYOUT_FORMAT
    value: '<b><size=32>5 <color=#56fbff>{2:CommaNumber}</color>

      4 <color=#56fbff>{1:CommaNumber}</color>

      3 <color=#56fbff>{0:CommaNumber}</color></size></b>'
  - key: PAYTABLE_SYMBOL_PAYOUT_FORMAT
    value: '<b><size=24>5 <color=#56fbff>{2:CommaNumber}</color>

      4 <color=#56fbff>{1:CommaNumber}</color>

      3 <color=#56fbff>{0:CommaNumber}</color></size></b>'
  - key: PAYTABLE_TITLE_3
    value: <style=title><color=#f17ccf><size=42>AMBER BONUS</color>
  - key: PAYTABLE_DESCRIPTION_3
    value: '<size=23>3           symbols anywhere on reels triggers <color=#56fbff>Amber
      Bonus</color>.

      Each pick, choose one of available multipliers

      and then apply it to the prize won.'
  - key: PAYTABLE_TITLE_LINES
    value: <style=title><color=#f17ccf><size=42>LINES</style></size></color>
