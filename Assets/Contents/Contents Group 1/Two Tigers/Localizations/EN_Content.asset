  - key: PAYTABLE_SYMBOL_NAME_FREE_BONUS
    value: <style=title><size=32><b>BONUS IN FREE GAMES</style>
  - key: PAYTABLE_SYMBOL_DESCRIPTION_FREE_BONUS_0
    value: "<size=19>- 5 consecutive Bonus Symbols from Left to Right\n   or from
      Right to Left awards 20x the Total Bet.</size>"
  - key: PAYTABLE_SYMBOL_DESCRIPTION_FREE_BONUS_1
    value: "<size=19>    - This symbol does not trigger Free Games.\n    -              turns
      to              during Free Games.</size>"
  - key: PAYTABLE_SYMBOL_NAME_WILD
    value: <style=title><size=32><b>WILD</style>
  - key: PAYTABLE_SYMBOL_DESCRIPTION_WILD
    value: "<size=19>- Appears on reels 2, 3, and 4 only.\n- Wild substitutes for
      all symbols except Bonus\n   symbol.</size>"
  - key: PAYTABLE_SYMBOL_NAME_DUAL
    value: <style=title><size=32><b>DUAL</style>
  - key: PAYTABLE_SYMBOL_DESCRIPTION_DUAL_01
    value: <size=19>- Appears on reels 2, 3, and 4 only.</size>
  - key: PAYTABLE_SYMBOL_DESCRIPTION_DUAL_02
    value: "<size=19>- Dual symbol substitutes for               and    \n   symbols
