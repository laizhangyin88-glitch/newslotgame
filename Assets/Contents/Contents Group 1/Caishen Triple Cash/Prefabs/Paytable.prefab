      m_Calls: []
  m_text: "<size=16>\nOnce triggered, awards 5 Free Spins. \r\nOnly Cash and Free
    Spin symbols appear during the Pay Up Bonus.\r\nFree Spin Symbol awards extra
    spins, once landed.\r\nAll landed Cash Symbols gets locked.\r\nPay Up Feature
    may be triggered at the end of each spin, increasing the payout for a random
    number of  Cash  Symbols on the reels.\r\nFree Spin Symbol awards extra spins,
    once landed.\r\nCover all 15 spots with Cash Symbols to win GRAND.\r\n</size>"
