    value: <style=title><size=42>WILD</size></style>
  - key: PAYTABLE_SYMBOL_NAME_1
    value: <style=title><size=42>H1</size></style>
  - key: PAYTABLE_SYMBOL_DESCRIPTION_0
    value: "<size=22>Wild substitutes for all symbols \nexcept Rich Hits symbol"
  - key: PAYTABLE_SYMBOL_PAYOUT_FORMAT
    value: '<b><size=24>5 <style=coinColor>{2:CommaNumber}</style>

      4 <style=coinColor>{1:CommaNumber}</style>

      3
      <style=coinColor>{0:CommaNumber}</style></size></b>'
  - key: PAYTABLE_TITLE_PAGE_2
    value: <style=title><size=42>RICH HITS JACKPOT</size></style>
  - key: PAYTABLE_DESCRIPTION_PAGE_2
    value: <size=24>Rich Hits symbols award Scatter Pay.
  - key: PAYTABLE_DESCRIPTION_RICH_HITS_AWARDS
    value: '<size=24>Any 9 RICH HITS symbols awards <style=coinColor><b>500x total
      bet</b></style>

      Any 8 RICH HITS symbols awards  <style=coinColor><b>400x
      total bet</b></style>

      Any 7 RICH HITS symbols awards  <style=coinColor><b>300x
      total bet</b></style>

      Any 6 RICH HITS symbols awards  <style=coinColor><b>200x
      total bet</b></style>

      Any 5 RICH HITS symbols awards  <style=coinColor><b>100x
      total bet</b></style>

      Any 4 RICH HITS symbols awards  <style=coinColor><b>50x
      total bet</b></style>

      Any 3 RICH HITS symbols awards  <style=coinColor><b>10x
      total bet</b></style>'
  - key: PAYTABLE_TITLE_PAGE_3
    value: <style=title><size=42>PARTY BONUS TRIGGER</size></style>
  - key: PAYTABLE_DESCRIPTION_PAGE_3
    value: "<size=22>- Rich Hits symbols are collected and used to increase the \n
      <b>Party Bonus Gauge</b> and <b>Party Bonus Bet.</b>\n- The higher the bet
      level, the more the Party Bonus bet increases.\n- All users in the room collect
      together towards the Bonus Gauge.\n- Party Bonus is triggered when the Bonus
      Gauge is full."
  - key: PAYTABLE_TITLE_PAGE_4
    value: <style=title><size=42>PARTY BONUS</size></style>
  - key: PAYTABLE_DESCRIPTION_PAGE_4
    value: "<size=22>- When triggered, all users in the room play 7 Free Spins together.\n-
      Mini reels of 6 other users are shown above my slot reel.\n- In reels 1 through
      4, only Rich Hits symbols appear.\n- Any Rich Hits symbols that land in reels
      1 through 4 in other users' mini reels are\n  copied over to my reel in the
      same location.\n- In reel 5, the following symbols can appear: Rich Hits and
      Multipliers (2x, 3x, and 5x).\n- If a multiplier appears in the center of reel
      5, it is applied towards the total Party \n  Jackpot award."
  - key: PAYTABLE_TITLE_PAGE_5
    value: <style=title><size=42>PARTY JACKPOT</size></style>
  - key: PAYTABLE_DESCRIPTION_PAGE_5
    value: "<size=22>- Party Jackpot is awarded based on the total number of Rich
      Hits\n  symbols (minimum 5) in my slot reel after all symbols have been\n 
      copied over. Multiplier will be applied accordingly if applicable."
  - key: PAYTABLE_DESCRIPTION_RICH_HITS_AWARDS_PAGE_5
    value: '<size=24>Any 12+ RICH HITS symbols awards <style=coinColor><b>500x total
      bet</b></style>

      Any 11 RICH HITS symbols awards  <style=coinColor><b>400x
      total bet</b></style>

      Any 10 RICH HITS symbols awards  <style=coinColor><b>300x
      total bet</b></style>

      Any 9 RICH HITS symbols awards  <style=coinColor><b>200x
      total bet</b></style>

      Any 8 RICH HITS symbols awards  <style=coinColor><b>100x
      total bet</b></style>

      Any 7 RICH HITS symbols awards  <style=coinColor><b>50x
      total bet</b></style>

      Any 6 RICH HITS symbols awards  <style=coinColor><b>25x
      total bet</b></style>

      Any 5 RICH HITS symbols awards  <style=coinColor><b>10x
      total bet</b></style>'
  - key: PAYTABLE_WAY_INFO
    value: <size=24><color=#00eaff>30 LINES</color></size>
  - key: PAYTABLE_BET_INFO
    value: '<size=24><color=#00eaff>Bet Per Line: 1</color></size>'
  - key: PAYTABLE_TITLE_LINES
    value: <style=title><size=42>LINES</size></style>
  - key: CONTENTS_GAME_TITLE
    value: Rich Hits Platinum
