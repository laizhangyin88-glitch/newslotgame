  - key: PAYTABLE_LINE_INFO
    value: <size=24><color=#00eaff>30 LINES</color></size>
  - key: PAYTABLE_BET_INFO
    value: '<size=24><color=#00eaff>BET PER LINE: 1</color></size>'
  - key: CONTENTS_GAME_TITLE
    value: Heat of Cleopatra
  - key: BUTTON_FREE_SPIN_START
    value: START
  - key: PAYTABLE_WILD_SYMBOL
    value: <style=title><size=32>WILD SYMBOL</size></style>
  - key: PAYTABLE_WILD_DESCRIPTION
    value: "<size=16>\n Wild Symbol can appear on all reels and always lands above
      the stacks of Sphinx Symbols. \n Once landed, Wild Symbol turns all adjacent
      Sphinx Symbols into Wild Symbols. \n Wild Symbol does not turn Sphinx Symbols,
      which landed diagonally or too far from the Wild Symbol.\n</size>"
  - key: PAYTABLE_SCATTER_SYMBOL
    value: <style=title><size=32>SCATTER SYMBOL</size></style>
  - key: PAYTABLE_SCATTER_DESCRIPTION
    value: "<size=16>\n Appears on reels 1, 3 and 5 in a Game 1 only. \n 3 Scatter
      Symbols on reels triggers Wheel Bonus. \n</size>"
  - key: PAYTABLE_WHEEL_BONUS
    value: <style=title><size=32>WHEEL BONUS</size></style>
  - key: PAYTABLE_WHELL_BONUS_DESCRIPTION
    value: "<size=16>\n Wheel Bonus awards either Jackpot (Grand, Mega, Major, Minor,
      Mini) or Free Game (with or without ALL WIN Multiplier). \n Once triggered,
      1 Wheel Spin is awarded. \n</size>"
  - key: PAYTABLE_FREE_GAME
    value: <style=title><size=32>FREE GAME</size></style>
  - key: PAYTABLE_FREE_GAME_DESCRIPTION
    value: "<size=16>\n Once triggered, enter Free Game with the number of Free Spins
      & ALL WINs Multiplier awarded in a Wheel Bonus. \n ALL WINs Multiplier gets
      applied to the total win at the end.\n During Free Games, the Wild Copy Feature
      works as follows:\n  : Wild Symbol turns all Sphinx Symbols beneath to Wilds.
      \n  : Then, during the spin, these newly created Full Wilds gets copied to
      the same spots in the following games.\n During Free Games, 3 Scatter Symbols
      on reels 1, 3 and 5 in a Game 1 awards the same number of Free Spins previously
      awarded from Wheel Bonus.\n</size>"
  - key: PAYTABLE_LINES
    value: <style=title><size=32>LINES</size></style>
  - key: 
    value: 
  - key: PAYTABLE_SYMBOL_PAYOUT_FORMAT
    value: '<b><size=24>

      5 <style=coinColor>{2:CommaNumber}</style>

      4
      <style=coinColor>{1:CommaNumber}</style>

      3 <style=coinColor>{0:CommaNumber}</style>

      </size></b>'
