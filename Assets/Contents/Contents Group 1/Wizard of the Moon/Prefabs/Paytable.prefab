  m_RaycastTarget: 0
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<size=18>\r\n-  Whenever a Wild Symbol appears, Lock & Re-Spin Feature
    is triggered\r\n   after awarding Symbol Win pays.\r\n-  Lock & Re-Spin Feature
    locks triggering Wilds and awards 1 re-spin.\r\n-  Another re-spin is given if
    additional Wild symbols appear.\r\n-  All existing Wilds remain locked in place
    during consecutive re-spins.\r\n-  Lock & Re-Spin Feature ends when no additional
    Wild Symbol appears.\r\n   Free Games end when no free spins remain.\r\n-  Re-spins
    are not counted towards free spins."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 5316d286fa94a894888ee12767189de0, type: 2}
