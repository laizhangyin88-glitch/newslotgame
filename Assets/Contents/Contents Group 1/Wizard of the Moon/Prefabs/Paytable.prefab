  m_RaycastTarget: 0
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<size=18>\n-  3 or more Scatter Symbols anywhere on reels triggers Choose
    Your Bonus Games.\n-  Each Scatter awards 3 Free Games.\n         <size=15>5 Scatter
    Symbols  =  <style=coinColor><b>15</b>  Free Games</style>\n           <size=15>4
    Scatter Symbols  =  <style=coinColor><b>12</b>  Free Games</style>\n           <size=15>3
    Scatter Symbols  =  <style=coinColor><b>9</b>  Free Games</style>\n-  There are
    two Bonus Games to choose from.\n           -  Lock & Re-Spin Free Games\n           -
    \ Expanding Wilds Free Games"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 5316d286fa94a894888ee12767189de0, type: 2}
