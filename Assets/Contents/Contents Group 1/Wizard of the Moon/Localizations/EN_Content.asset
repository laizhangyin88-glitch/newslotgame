  - key: PAYTABLE_PAGE_TITLE_4_1
    value: <style=title><size=32>Re-Trigger</style>
  - key: PAYTABLE_SYMBOL_DESCRIPTION_0
    value: '<size=18>5  <style=coinColor>15  Free Games</style>

      <size=18>4  <style=coinColor>12  Free Games</style>

      <size=18>3  <style=coinColor>9  Free Games</style>'
  - key: PAYTABLE_SYMBOL_DESCRIPTION_1
    value: '<size=15>3 or more Scatter Symbols anywhere on

      reels triggers Bonus Games.

'
  - key: PAYTABLE_SYMBOL_DESCRIPTION_1_1
    value: '<size=15>During Free Games, Wild Symbol

      appears on reels 2, 3 and 4 only.'
  - key: PAYTABLE_SYMBOL_DESCRIPTION_1_2
    value: "<size=15>Award Symbol appears on reel 5 only.\r\nAward Symbol on reel
      5 becomes a random\nsymbol except Scatter and Wild Symbols.\r\n"
  - key: PAYTABLE_SYMBOL_DESCRIPTION_2
    value: "<size=18>\n-  Award Symbol appears on reel 5 only. \n-  Award Symbol appears
      with Value which is proportional to player's Total Bet.\n-  Award Symbol on
      reel 5 becomes a random symbol except Scatter and Wild Symbols.\n-  5 of a kind
      win with Award Symbol(s) on reel 5 pays the Value on Award Symbol(s). "
  - key: PAYTABLE_SYMBOL_DESCRIPTION_2_1
    value: "<size=18>\n-  3 or more Scatter Symbols anywhere on reels triggers Choose
      Your Bonus Games.\n-  Each Scatter awards 3 Free Games.\n         <size=15>5
      Scatter Symbols  =  <style=coinColor><b>15</b>  Free Games</style>\n           <size=15>4
      Scatter Symbols  =  <style=coinColor><b>12</b>  Free Games</style>\n           <size=15>3
      Scatter Symbols  =  <style=coinColor><b>9</b>  Free Games</style>\n-  There
      are two Bonus Games to choose from.\n           -  Lock & Re-Spin Free Games\n
      \          -  Expanding Wilds Free Games"
  - key: PAYTABLE_SYMBOL_DESCRIPTION_3
    value: "<size=18>\r\n-  Whenever a Wild Symbol appears, Lock & Re-Spin Feature
      is triggered\r\n   after awarding Symbol Win pays.\r\n-  Lock & Re-Spin Feature
      locks triggering Wilds and awards 1 re-spin.\r\n-  Another re-spin is given
      if additional Wild symbols appear.\r\n-  All existing Wilds remain locked in
      place during consecutive re-spins.\r\n-  Lock & Re-Spin Feature ends when no
      additional Wild Symbol appears.\r\n   Free Games end when no free spins remain.\r\n-
      \ Re-spins are not counted towards free spins."
  - key: PAYTABLE_SYMBOL_DESCRIPTION_3_1
    value: "<size=18>\n-  During Lock & Re-Spin Free Games, 3 or more Scatter Symbols
      anywhere on reels re-triggers and awards\n   additional Free Games.  \r\n-  Each
      Scatter awards 3 Free Games.\n         <size=15>5 Scatter Symbols  =  <style=coinColor><b>15</b>
      \ Free Games</style>\n           <size=15>4 Scatter Symbols  =  <style=coinColor><b>12</b>
      \ Free Games</style>\n           <size=15>3 Scatter Symbols  =  <style=coinColor><b>9</b>
      \ Free Games</style>"
  - key: PAYTABLE_SYMBOL_DESCRIPTION_4
    value: "<size=18>\n-  Whenever a Wild Symbol appears on a reel, that Wild Symbol
      expands to create a full Wild Reel \n   and then awards pays."
  - key: PAYTABLE_SYMBOL_DESCRIPTION_4_1
    value: "<size=18>\n-  During Expanding Wilds Free Games, 3 or more Scatter Symbols
      anywhere on reels re-triggers and awards\n   additional Free Games. \r\n-  Each
      Scatter Symbol awards 3 Free Games. \n         <size=15>5 Scatter Symbols  =
      \ <style=coinColor><b>15</b>  Free Games</style>\n           <size=15>4 Scatter
      Symbols  =  <style=coinColor><b>12</b>  Free Games</style>\n           <size=15>3
      Scatter Symbols  =  <style=coinColor><b>9</b>  Free Games</style>"
  - key: PAYTABLE_SYMBOL_PAYOUT_FORMAT
    value: '<b><size=24><b>4 <style=coinColor>{1:CommaNumber}</style>

      3 <style=coinColor>{0:CommaNumber}</style></size></b>'
