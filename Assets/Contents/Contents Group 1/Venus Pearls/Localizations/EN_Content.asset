  - key: PAYTABLE_BET_INFO
    value: '<size=24><color=#00eaff>Base Bet: 100

      </color></size>'
  - key: PAYTABLE_WAY_INFO
    value: '<size=24><color=#00eaff>720 WAYS

      </color></size>'
  - key: PAYTABLE_SYMBOL_PAYOUT_FORMAT
    value: '<b><size=24>5 <style=coinColor>{2:CommaNumber}</style>

      4 <style=coinColor>{1:CommaNumber}</style>

      3 <style=coinColor>{0:CommaNumber}</style></size></b>'
  - key: PAYTABLE_SYMBOL_PAYOUT_FORMAT_1
    value: '<b><size=20>5 <style=coinColor>{2:CommaNumber}</style>

      4 <style=coinColor>{1:CommaNumber}</style>

      3 <style=coinColor>{0:CommaNumber}</style></size></b>'
  - key: PAYTABLE_SYMBOL_NAME_BONUS
    value: "<style=title><size=32><b>Pink Seashell\r\n</style>"
  - key: PAYTABLE_SYMBOL_DESCRIPTION_BONUS
    value: "<size=18>- Pink Seashell may appear behind A, K, Q, J, 10, or 9\n   symbols
      on reels 1 and 5. \r\n\n- The Wheel Bonus Game is triggered when 2 Pink\n   Seashells
      appear on reels 1 and 5.\r\n</size>"
  - key: PAYTABLE_SYMBOL_NAME_SCATTER
    value: <style=title><size=32><b>SCATTER</style>
  - key: PAYTABLE_SYMBOL_DESCRIPTION_SCATTER
    value: "<size=18>- 3 or more Scatters from the leftmost reels awards\n   Scatter
      pay.\n\n- Wild can substitute for Scatter only if Wild appears\n   with at least
      one Scatter.</size>"
  - key: PAYTABLE_TITLE_PAGE_2
    value: <style=title><size=32><b>Re-Spin Feature</size></style>
  - key: PAYTABLE_PAGE_DESCRIPTION_2
    value: "<size=21>- Wild symbol appears on reels 2, 3 and 4 only.\r\n\n- Whenever
      Wilds appear as a full stack, the Re-Spin feature\n   is triggered.\r\n\n- Full
      stack of Wilds get locked onto the reels, and the remaining\n   reels re-spin
      once.\r\n\n- If additional Wilds appear as full stacks, Re-Spin feature is\n
      \  triggered again.\r\n\n- Re-Spin feature ends when no more Wild full stacks
      appear.</size>"
  - key: PAYTABLE_TITLE_PAGE_3_1
    value: <style=title><size=32><b>Wheel Bonus Games</size></style>
  - key: PAYTABLE_PAGE_DESCRIPTION_3_1
    value: "<size=20>- Wheel Bonus Game is triggered when 2 Pink Seashells appear
      on reels 1 and 5.\n- Player may win Free Games, Mega Free Games, Grand Jackpot
      on the wheel.\n- The wheel consists of the following Free and Mega Free Games:\n
      \     - Free Games: 10, 15, 20 or 30 spins\n      - Mega Free Games: 10, 15,
      or 25 spins\n- Wheel Bonus ends once the wheel marker lands on a prize and the
      prize is awarded to the player.</size>"
  - key: PAYTABLE_TITLE_PAGE_3_2
    value: <style=title><size=32><b>Free Games</size></style>
  - key: PAYTABLE_PAGE_DESCRIPTION_3_2
    value: "<size=20>- Player may enter Free Games from winning the Free Games prize
      in the Wheel Bonus.\r\n- The same amount of Free Games as initially awarded
      is re-triggered if 2 Pink Seashells land on\n   reels 1 and 5.\r\n- Whenever
      Wilds appear as full stacks, the Re-Spin feature is triggered.\r\n- Free Games
      ends when there is no more spins remaining.</size>"
  - key: PAYTABLE_TITLE_PAGE_4_1
    value: <style=title><size=32><b>Mega Free Games</size></style>
  - key: PAYTABLE_PAGE_DESCRIPTION_4_1
    value: "<size=20>- Player may enter Mega Free Games from winning the Mega Free
      Games prize in the Wheel Bonus.\n- The same amount of Mega Free Games as initially
      awarded is re-triggered if 2 Pink Seashells land\n   on reels 1 and 5.\n- During
      Mega Free Games, whenever a Wild symbol appears on the reels, the Wild Nudge
      feature\n   is triggered. Mega Free Games ends when there is no more spins remaining.</size>"
  - key: PAYTABLE_TITLE_PAGE_4_2
    value: <style=title><size=32><b>Wild Nudge Feature</size></style>
  - key: PAYTABLE_PAGE_DESCRIPTION_4_2
    value: "<size=20>- Wild Nudge feature is triggered during Mega Free Games whenever
      a Wild symbol appears\n   on reels.\r\n- When 1 or more Wild appears on reels
      2, 3 and 4, the reel with the Wild will nudge up or down to\n   create a full
      stack of Wilds.\r\n- Changed reels with full stack of Wilds will trigger the
      Re-Spin feature.</size>"
  - key: PAYTABLE_TITLE_PAGE_5
    value: <style=title><size=32><b>Grand Jackpot</size></style>
  - key: PAYTABLE_PAGE_DESCRIPTION_5
    value: "<size=20>- Player may win Grand Jackpot from the Wheel Bonus.\r\n- Once
      Grand Jackpot is awarded, the prize amount will be re-set to its initial amount.</size>"
