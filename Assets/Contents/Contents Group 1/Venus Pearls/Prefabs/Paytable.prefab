      m_Calls: []
  m_text: "<size=20>- Player may enter Free Games from winning the Free Games prize
    in the Wheel Bonus.\r\n- The same amount of Free Games as initially awarded is
    re-triggered if 2 Pink Seashells land on\n   reels 1 and 5.\r\n- Whenever Wilds
    appear as full stacks, the Re-Spin feature is triggered.\r\n- Free Games ends
    when there is no more spins remaining.</size>"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 3213cb5827671c24ab232a2885ba7954, type: 2}
