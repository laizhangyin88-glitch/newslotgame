  m_RaycastTarget: 0
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<size=20>- Wild Nudge feature is triggered during Mega Free Games whenever
    a Wild symbol appears\n   on reels.\r\n- When 1 or more Wild appears on reels
    2, 3 and 4, the reel with the Wild will nudge up or down to\n   create a full
    stack of Wilds.\r\n- Changed reels with full stack of Wilds will trigger the Re-Spin
    feature.</size>"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 3213cb5827671c24ab232a2885ba7954, type: 2}
