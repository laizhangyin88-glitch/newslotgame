      m_Calls: []
  m_text: "<size=21>- Wild symbol appears on reels 2, 3 and 4 only.\r\n\n- Whenever
    Wilds appear as a full stack, the Re-Spin feature\n   is triggered.\r\n\n- Full
    stack of Wilds get locked onto the reels, and the remaining\n   reels re-spin
    once.\r\n\n- If additional Wilds appear as full stacks, Re-Spin feature is\n   triggered
    again.\r\n\n- Re-Spin feature ends when no more Wild full stacks appear.</size>"
  m_isRightToLeft: 0
