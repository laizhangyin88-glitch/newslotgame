  - key: CONTENTS_GAME_TITLE
    value: Midas Gold
  - key: PAYTABLE_SYMBOL_PAYOUT_FORMAT
    value: '<b><size=32>5 <style=coinColor>{2:CommaNumber}</style>

      4 <style=coinColor>{1:CommaNumber}</style>

      3 <style=coinColor>{0:CommaNumber}</style></size></b>'
  - key: PAYTABLE_TITLE_PAGE_2
    value: <style=title><size=42>KING MIDAS WILD
  - key: PAYTABLE_DESCRIPTION_PAGE_2_1
    value: "<size=32><style=coinColor>WILD SUBSTITUTES \nFOR ALL SYMBOLS\nEXCEPT SCATTER"
  - key: PAYTABLE_DESCRIPTION_PAGE_2_2
    value: "<size=26><color=#cddeff>WHEN KING MIDAS LANDS, HE TURNS A RANDOM \nNUMBER
      OF OTHER SYMBOLS</color> <style=coinColor>WILD</style><color=#cddeff>, AS WELL
      AS \nHIMSELF FOR THAT SPIN.</color>"
  - key: PAYTABLE_DESCRIPTION_PAGE_2_3
    value: '<size=26><color=#fc9109>ADDITIONALLY, IF HE LANDS DURING BONUS FREE SPINS,

      HE ALSO TURNS A WHOLE REEL INTO A</color> <style=coinColor>STACKED WILD</style>'
  - key: PAYTABLE_TITLE_PAGE_3
    value: <style=title><size=42>MIDAS GOLD SCATTER
  - key: PAYTABLE_SYMBOL_DESCRIPTION_10_0
    value: '<size=26><color=#cddeff>ANY SCATTER WIN ACTIVATES THE FREE SPINS BONUS.

      ANY SCATTER WIN DURING FREE SPINS TRIGGERS MORE FREE SPINS.'
  - key: PAYTABLE_SYMBOL_DESCRIPTION_10_1
    value: "<size=26><color=#fc9109>SCATTERS WIN WHEN <style=coinColor>3</style> OR
      MORE LAND ANYWHERE ON \nADJACENT REELS FROM THE LEFTMOST REEL, BUT NOT \nNECESSARILY
      ON A PLAYED LINE."
  - key: PAYTABLE_SYMBOL_DESCRIPTION_10_2
    value: <size=18><color=#6cabff>SCATTER WINS ARE MULTIPLIED BY THE TOTAL WAGER.
      PAYS SHOWN WITH A WAGER OF 1 COIN
  - key: PAYTABLE_TITLE_PAGE_4
    value: <style=title><size=42>GAME RULES
  - key: PAYTABLE_SCATTER_SYMBOL_SUB_TITLE
    value: <b><size=24><color=#fc9109>PAYS   FREE SPINS
  - key: PAYTABLE_SCATTER_SYMBOL_PAYOUT_FORMAT_TEXT
    value: '<b><size=32>5

      4

      3'
  - key: PAYTABLE_SCATTER_SYMBOL_PAYOUT_FORMAT
    value: '<b><size=32><style=coinColor>{2:CommaNumber}</style>

      <style=coinColor>{1:CommaNumber}</style>

      <style=coinColor>{0:CommaNumber}</style></size></b>'
  - key: PAYTABLE_SCATTER_SYMBOL_PAYOUT_FREE_SPINS
    value: '<b><size=32><style=coinColor> 20</style>

      <style=coinColor> 15</style>

      <style=coinColor> 10</style></size></b>'
  - key: PAYTABLE_DESCRIPTION_PAGE_4_0
    value: "<size=32><color=#cddeff>ALL WINS PAY \nLEFT TO RIGHT ON ADJACENT REELS,
      \nBEGINNING WITH LEFTMOST REEL."
  - key: PAYTABLE_DESCRIPTION_PAGE_4_1
    value: "<size=32><color=#fc9109>ALL WINS ARE PAID ON LINES PLAYED,\n EXCEPT SCATTER.
      HIGHEST WIN PAID \nON ANY PLAYED LINE."
  - key: PAYTABLE_DESCRIPTION_PAGE_4_2
    value: "<size=32><color=#6cabff>ALL WINS ARE MULTIPLIED BY THE \nNUMBER OF COINS
      BET PER LINE."
  - key: PAYTABLE_TITLE_LINES
    value: <style=title><size=42>LINES
  - key: PAYTABLE_WAY_INFO
    value: <size=24><color=#00eaff>25 LINES</color></size>
  - key: PAYTABLE_BET_INFO
    value: '<size=24><color=#00eaff>Bet Per Line: 1</color></size>'
