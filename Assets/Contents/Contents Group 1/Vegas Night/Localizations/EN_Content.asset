  - key: PAYTABLE_SYMBOL_DESCRIPTION_SELECT_01
    value: '<size=20>Select one of 4 Vegas Night characters.

      Chosen character can be changed anytime.'
  - key: PAYTABLE_SYMBOL_DESCRIPTION_SELECT_02
    value: <size=20>Selected symbol awards 3x the pay.
  - key: PAYTABLE_SYMBOL_DESCRIPTION_0
    value: <size=20>Appears on reels 2, 3, 4 and 5.
  - key: PAYTABLE_SYMBOL_PAYOUT_FORMAT
    value: '<b><size=24>5 <style=coinColor>{2:CommaNumber}</style>

      4 <style=coinColor>{1:CommaNumber}</style>

      3 <style=coinColor>{0:CommaNumber}</style></size></b>'
  - key: PAYTABLE_TITLE_PAGE_2
    value: <style=title><size=42>VEGAS NIGHT PARTY BONUS
  - key: PAYTABLE_TITLE_PAGE_3
    value: <style=title><size=42>VEGAS NIGHT PARTY BONUS
  - key: PAYTABLE_DESCRIPTION_PAGE_2
    value: "<size=32>  <b>ENTER THE BONUS</b>\n<size=24>- Wild symbols appear with
      Bonus Points. \n- Bonus Points get accumulated in the meter to trigger \n   the
      Vegas Night bonus.\n- Increasing bet level increases overall Bonus Points.\n-
      If one player in the slot room triggers the bonus, \n  everyone enters the bonus
      together."
  - key: PAYTABLE_DESCRIPTION_PAGE_3
    value: "<size=32>  <b>VEGAS NIGHT BONUS</b>\n<size=24>- Players enter and play
      the bonus game together.\n- There are 3 rounds of bonus games and at maximum
      8 rooms to collect \n   multipliers from.\n- 2 rooms with\"?\" signs will have
      the lowest and highest multipliers of that round. \n- Players are randomly awarded
      multipliers from rooms they move to.\n- Multiplier increases if more users hit
      the same room. \n- Multipliers also increase as the bonus rounds progress.\n-
      1-3 rooms get closed after each bonus round. "
  - key: PAYTABLE_TITLE_LINES
    value: <style=title><size=42>LINES</size></style>
  - key: CONTENTS_GAME_TITLE
    value: Vegas Night
