    value: <b><style=title><size=32>LUCKY STAR FEATURE</style></b>
  - key: PAYTABLE_TITLE_4
    value: <b><style=title><size=32>MAGIC BALL FREE GAMES</style></b>
  - key: PAYTABLE_TITLE_5
    value: <b><style=title><size=32>LINES</style></b>
  - key: 
    value: 
  - key: 
