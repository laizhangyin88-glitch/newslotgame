  - key: CONTENTS_GAME_TITLE
    value: Treasure Riches Deluxe
  - key: BUTTON_FREE_SPIN_START
    value: START
  - key: "PAYTABLE_\bWILD"
    value: <style=title><size=32>WILD SYMBOL</size></style>
  - key: PAYTABLE_WILD_DESCRIPTION
    value: '<size=14>

      Wild Symbol can appear on all reels in stacks and can
      substitute for all symbols except Jackpot and Scatter Symbols.

      </size>'
  - key: PAYTABLE_JACKPOT
    value: <style=title><size=32>JACKPOT SYMBOL</size></style>
  - key: 
    value: 
  - key: PAYTABLE_JACKPOT_DESCRIPTION
    value: '<size=16>

      Jackpot Symbol can appear on reels 1 and 5 only, and
      Jackpot Symbols on both reels 1 and 5 awards a Jackpot type on Jackpot Symbol
      on reel 5.

      </size>'
  - key: PAYTABLE_SCATTER
    value: <style=title><size=32>SCATTER SYMBOL</size></style>
  - key: PAYTABLE_SCATTER_DESCRIPTION_1
    value: "<size=16>\n<b>       Treasure Prize </b>\n 5 Full Stacks - Total Bet
      x 3\n 4 Full Stacks - Total Bet x 2\n 3 Full Stacks - Total Bet\n\n</size>"
  - key: PAYTABLE_SCATTER_DESCRIPTION_2
    value: "<size=16>\n Scatter Symbol can appear on all reels in stacks and 3 or
      more \n FULL Stacks of Scatter Symbols accumulate Treasure Prize \n on a random
      empty spot.\n The more the Full Stacks of Scatter Symbols, the bigger the\n
      Treasure Prize. \n</size>"
  - key: PAYTABLE_TREASURE
    value: <style=title><size=32>TREASURE PRIZE & TREASURE SPOT</size></style>
  - key: PAYTABLE_TREASURE_DESCRIPTION
    value: "<size=16>\n There are 24 Treasure Spots in total.\n Each Treasure Spot
      displays User Profile and Treasure Prize.\n Accumulated Treasure Prizes on
      Treasure Spots can be won during Treasure Bonus. \n</size>"
  - key: PAYTABLE_TREASURE_BONUS
    value: <style=title><size=32>TREASURE BONUS</size></style>
  - key: PAYTABLE_TREASURE_BONUS_DESCRIPTION
    value: "<size=16>\n Once ALL 24 Treasure Spots accumulate Treasure Prizes, then
      Treasure Bonus is triggered.\n Treasure Bonus consists of 6 Rounds:\n  - Round
      1: 2 Frames with x3\n  - Round 2: 2 Frames with x4\n  - Round 3: 2 Frames with
      x5\n  - Round 4: 1 Frame with x10\n  - Round 5: 1 Frame with x15\n  - Final
      Round: 2 Frames, each with x20 and x50\n Every Round, each User wins the sum
      of Teasue Prizes on one's own Treasure Spots overlapped \n with the Frame(s)
      and round multiplier(s) is applied to the pays.\n Once Treasure Prize has been
      paid out, that Treasure Spot is no longer active for further Rounds. \n When
      Treasure Bonus ends, Treasure Spots get reset.\n</size>"
  - key: PAYTABLE_LINES
    value: <style=title><size=32>LINES</size></style>
  - key: PAYTABLE_SYMBOL_PAYOUT_FORMAT
    value: '<b><size=24>5 <style=coinColor>{2:CommaNumber}</style>

      4 <style=coinColor>{1:CommaNumber}</style>

      3
      <style=coinColor>{0:CommaNumber}</style></size></b>'
