      m_Calls: []
  m_text: "<size=20>\n-  3                        symbols in a winning line triggers
    the Prime Bucks feature.\n\n-  Prime Bucks awards a random amount of credit prize
    with the 3 following options:\n\n       -  Take Offer: Take offer and end the
    Bonus.\n\n       -  Try Again: Try again for a different credit prize.\n\n       -
    \ Gamble: Gamble for a chance to make the credit prize win even bigger!\n\n-  Player
    may Try Again up to 3 times. The 4th credit prize cannot be refreshed anymore.\n\n-
    \ Gamble may only be exercised when the player has a multiplier activated from
    Base Game.\n\n-  If player chooses to Gamble, begin the Prime Bucks Gamble Wheel."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 5316d286fa94a894888ee12767189de0, type: 2}
