  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 0
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<size=22>- 3 or more Scatters anywhere on reels triggers Free Games.\n 
    - 3 Scatters awards 5 Free Games by default.\n   - After 3 Scatters, each additional
    Scatter awards +1 free spin to the default amount\n     of Free Games.\n- All
    triggering Scatters on reels get locked in positions and turn into Sticky Wilds
    for \n   the remaining spins.\n- During Free Games, any additional Scatter awards
    +1 free spin.\n   - Any additional Scatters appearing on reels during Free Games
    get locked and turn\n     into Sticky Lamp Wilds for the remaining spins.\n-
    The bet per line and the active pay lines remain the same as the spin that triggered\n 
    Free Games.\n- Carpet Wild and Sticky Wild are WILDs for all symbols except Scatter.\n</size>"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 5316d286fa94a894888ee12767189de0, type: 2}
  m_sharedMaterial: {fileID: 21000010116884160, guid: 5316d286fa94a894888ee12767189de0,
