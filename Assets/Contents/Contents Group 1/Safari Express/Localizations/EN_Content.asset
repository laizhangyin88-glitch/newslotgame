  - key: PAYTABLE_WAY_INFO
    value: <size=24><color=#ffffff>1024 WAYS</size></color>
  - key: PAYTABLE_BET_INFO
    value: '<size=24><color=#ffffff>Base Bet: 100</size></color>'
  - key: PAYTABLE_TITLE_1
    value: <style=title><color=#ffd800><size=34>WILD</style></color></size>
  - key: PAYTABLE_DESCRIPTION_1
    value: 'Appears on reels <b>2</b>, <b>3</b> and <b>4</b> and substitutes for
      all symbols except the following symbols:'
  - key: PAYTABLE_SYMBOL_PAYOUT_FORMAT
    value: '<b><size=24>5 <color=#ffd800>{2:CommaNumber}</color>

      4 <color=#ffd800>{1:CommaNumber}</color>

      3
      <color=#ffd800>{0:CommaNumber}</color></size></b>'
  - key: PAYTABLE_TITLE_2
    value: <style=title><color=#ffd800><size=34>TRAIN FEATURE</style></color></size>
  - key: PAYTABLE_DESCRIPTION_2
    value: "<size=18>-          is a <b>Cash Symbol</b> that appears on reels <b>1</b>-<b>4</b>.\n-         
      ,          ,          and          are <b>Colored Train Symbols</b> that appear
      on reels <b>1</b>-<b>4</b>.\n-          ,          and          are <b>Trigger
      Symbols</b> that appear on reel <b>5</b> only and each spin,\n   one of such
      symbols can appear.\n- <b>Train Feature</b> is triggered when there is at least
      one <b>Cash</b> or <b>Colored Train Symbol</b> on reels <b>1</b>-<b>4</b>\n  
      and one of the <b>Trigger Symbols</b> on reel <b>5</b>. \n- Each <b>Feature</b>
      awards the below prizes when triggered:</size>"
  - key: PAYTABLE_TITLE_3
    value: <style=title><size=16><color=#ffffff>Feature</style></size></color>
  - key: PAYTABLE_TITLE_4
    value: <style=title><size=16><color=#ffffff>Prize</style></size></color>
  - key: PAYTABLE_DESCRIPTION_3
    value: "<size=14><color=#2f2b2b>  10-100 Purple carriages with 25-2500 coins
      and chance to win Grand Jackpot at the end\n  10-100 Red carriages with 15-2000
      coins and chance to win Major Jackpot at the end\n  10-100 Blue carriages with
      10-1000 coins and chance to win Minor Jackpot at the end\n  10-100 Green carriages
      with 5-100 coins and chance to win Mini Jackpot at the end\n  <b>Depending
      on Cash/Colored Train Symbols on reels, Colored Train Features and Sum of Cash
      Symbols</b>\n  3-10 Golden carriages <b>with sum of previous Train Features
      and Cash Symbols as a carriage value</b>\n  8-15 Platinum carriages <b>with
      sum of previous Train Features and Cash Symbols as a carriage value</b></color></size>"
  - key: PAYTABLE_DESCRIPTION_4
    value: "<size=18>- Depending on the combinations of <b>Cash</b>, <b>Colored Train</b>
      and <b>Trigger Symbols</b> on reels,\n   below is awarded."
  - key: PAYTABLE_TITLE_5
    value: <style=title><size=18><color=#ffffff>Combinations</style></size></color>
  - key: PAYTABLE_TITLE_6
    value: <style=title><size=16><color=#ffffff>Reels 1-4</style></size></color>
  - key: PAYTABLE_TITLE_7
    value: <style=title><size=16><color=#ffffff>Reel 5</style></size></color>
  - key: PAYTABLE_TITLE_8
    value: <style=title><size=16><color=#ffffff>Prize</style></size></color>
  - key: PAYTABLE_DESCRIPTION_5
    value: "<size=14><color=#2f2b2b>  Sum of the values on Cash Symbols\n  Colored
      Train Feature(s) and Sum of the values on Cash Symbols\n  Colored Train Feature(s)\n 
      Golden Train Feature and Sum of the values on Cash Symbols\n  Colored Train
      Feature(s), Golden Train Feature and Sum of the values on Cash Symbols\n  Colored
      Train Feature(s) and Golden Train Feature\n  Platinum Train Feature and Sum
      of the values on Cash Symbols\n  Colored Train Feature(s), Platinum Train Feature
      and Sum of the values on Cash Symbols\n  Colored Train Feature(s) and Platinum
      Train Feature</color></size>"
  - key: PAYTABLE_TITLE_9
    value: <style=title><color=#ffd800><size=34>CHOOSE YOUR FEATURE</style></color></size>
  - key: PAYTABLE_DESCRIPTION_6
    value: '<b>3</b> or more           symbols on any reels triggers <b><color=#ffd800>CHOOSE
      YOUR FEATURE</b></color>.


      or'
  - key: PAYTABLE_DESCRIPTION_7
    value: "<size=18>- If              is selected, award <b>10 Free Games</b>.\n-
      During <b>Free Games</b>, over spins, more <b>Wilds</b>\n   are added to reels
      <b>2</b>-<b>4</b>.\n- <b>3</b> or more         re-triggers <b>+5 Free Games</b>.\n-                                                                      
      do <b>NOT</b> appear\n   during <b>Free Games</b>.</size>"
  - key: PAYTABLE_DESCRIPTION_8
    value: "<size=18>- If              is selected, <b>Safari Express Bonus</b>\n  
      is triggered.\n- <b>Safari Express Bonus</b> is one spin of random\n   <b>Train
      Feature</b> with at least one          on reels\n   <b>1</b>-<b>4</b> and one        
      ,         or         on reel <b>5</b>.\n-         ,         ,         and        
      can appear on reels <b>1</b>-<b>4</b>.</size>"
