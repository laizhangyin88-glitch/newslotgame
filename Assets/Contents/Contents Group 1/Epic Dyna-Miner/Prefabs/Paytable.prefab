      m_Calls: []
  m_text: "<size=17>\n-  During Base Game, 3x5 Bonus Reels above Base Reels are played.
    \n\n-  Progress of Bonus Reels is saved per bet level.\n\n-  Bonus Reels are
    individual spinning reels.\n\n-  When empty Bonus Reels are played, a random
    combination of <br>   3           ,           , or            is guaranteed with
    the first spin.\n\n-  Landed symbols on the Bonus Reels are locked and carried
    to the Epic Bonus Feature.\n\n-  During Base Game, 1 to 3           ,          
    ,  or           on Bonus Reels can be upgraded randomly.\n\n-  After an Epic
    Bonus Feature, the Bonus Reels are reset to empty.\n"
  m_isRightToLeft: 0
