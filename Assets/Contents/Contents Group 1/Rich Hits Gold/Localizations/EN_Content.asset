  - key: INGAME_LEFT_BOTTOM_FREE_SPIN_COUNT_0
    value: '<b><size=36><color=#ffea00>{0}</color></size>

      <size=20>FREE GAME PLAYED</size></b>'
  - key: INGAME_LEFT_BOTTOM_FREE_SPIN_COUNT_1
    value: '<b><size=36><color=#ffea00>{0}</color></size>

      <size=20>FREE GAMES PLAYED</size></b>'
  - key: BUTTON_FREE_SPIN_START
    value: START
  - key: PAYTABLE_SYMBOL_NAME_0
    value: <style=title><size=32>WILD</size></style>
  - key: PAYTABLE_SYMBOL_DESCRIPTION_0
    value: "<size=22>Wild substitutes for all symbols \nexcept Rich Hit symbol"
  - key: PAYTABLE_SYMBOL_PAYOUT_FORMAT
    value: '<b><size=24>5 <style=coinColor>{2:CommaNumber}</style>

      4 <style=coinColor>{1:CommaNumber}</style>

      3 <style=coinColor>{0:CommaNumber}</style></size></b>'
  - key: PAYTABLE_TITLE_PAGE_2
    value: <style=title><size=42>RICH HITS JACKPOT</size></style>
  - key: PAYTABLE_DESCRIPTION_PAGE_2
    value: '<size=22>

      Rich Hits symbols award Scatter Pay.


      Any 9 RICH HITS symbols awards <style=coinColor><b>1000x total bet</b></style>

      Any 8 RICH HITS symbols awards  <style=coinColor><b>500x total bet</b></style>

      Any 7 RICH HITS symbols awards  <style=coinColor><b>75x total bet</b></style>

      Any 6 RICH HITS symbols awards  <style=coinColor><b>30x total bet</b></style>

      Any 5 RICH HITS symbols awards  <style=coinColor><b>8x total bet</b></style>

      Any 4 RICH HITS symbols awards  <style=coinColor><b>3x total bet</b></style>

      Any 3 RICH HITS symbols awards  <style=coinColor><b>1x total bet</b></style>'
  - key: PAYTABLE_TITLE_PAGE_3
    value: <style=title><size=42>PARTY BONUS TRIGGER</size></style>
  - key: PAYTABLE_DESCRIPTION_PAGE_3
    value: "<size=22>- Rich Hits symbols are collected and used to increase \n  the
      <b>Party Bonus Gauge</b> and <b>Party Bonus Bet</b>. \n- The higher the bet
      level, the more the Party Bonus bet increases.\n   Party Bonus Bet is the base
      bet in the Party Bonus. \n- All users in the room collect together towards the
      Bonus Gauge.\n- Party Bonus is triggered when the Bonus Gauge is full. "
  - key: PAYTABLE_TITLE_PAGE_4
    value: <style=title><size=42>PARTY BONUS</size></style>
  - key: PAYTABLE_DESCRIPTION_PAGE_4
    value: "<size=22>- When Party Bonus is triggered, all users in the room begin
      the Bonus together \n  and share their screens. Bonus lasts 8 Free Spins. \n-
      In Party Bonus, Super Symbols appear in reels 2 to 4.\n- In Party Bonus, <b>all
      Rich Hits symbols</b> are converted to <b>Rich Wild symbols.</b> \n  Rich Wild
      is a Super Symbol and acts as both Rich Hits and Wild."
  - key: PAYTABLE_TITLE_PAGE_5
    value: <style=title><size=42>PARTY JACKPOT</size></style>
  - key: PAYTABLE_DESCRIPTION_PAGE_5_1
    value: "<size=22>\n- Rich Wild acts as both Rich Hits and Wild.\n- Rich Wild Jackpot
      Pay is awarded for 3 or more Rich Wild symbols \n  that land collectively in
      the seven users in the room. "
  - key: PAYTABLE_DESCRIPTION_PAGE_5_2
    value: '<size=22>Any 7 RICH WILD symbols awards  <style=coinColor><b>200x Party
      bonus bet</b></style>

      Any 6 RICH WILD symbols awards  <style=coinColor><b>100x Party bonus bet</b></style>

      Any 5 RICH WILD symbols awards  <style=coinColor><b>50x Party bonus bet</b></style>

      Any 4 RICH WILD symbols awards  <style=coinColor><b>10x Party bonus bet</b></style>

      Any 3 RICH WILD symbols awards  <style=coinColor><b>3x Party bonus bet</b></style>'
  - key: PAYTABLE_WAY_INFO
    value: <size=24><color=#00eaff>30 LINES</color></size>
  - key: PAYTABLE_BET_INFO
    value: '<size=24><color=#00eaff>Bet Per Line: 1</color></size>'
  - key: PAYTABLE_TITLE_LINES
    value: <style=title><size=42>LINES</size></style>
  - key: CONTENTS_GAME_TITLE
    value: Rich Hits Gold
