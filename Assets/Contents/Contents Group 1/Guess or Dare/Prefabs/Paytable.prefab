  m_RaycastTarget: 0
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "- Fully filled progression bar triggers <b>Bonus Mode</b> with <b>7</b>
    re-spins.\n- During <b>Bonus Mode</b>, only <b>Bonus Symbols</b>             landing
    on reels are valid.\n- Any <b>Bonus Symbols</b>             that appear during
    <b>Bonus Mode</b> get locked\n  until there are no remaining re-spins.\n     -
    Each re-spin, one or more             on reels awards <b>+1</b> spin.\n     -
    If all <b>15</b> spots are filled with             during <b>Bonus Mode</b>, <b>Guess
    or Dare Bonus</b>\n       is triggered right away.\n- Once <b>Bonus Mode</b> ends,
    <b>Bonus Game</b> starts right away.\n- Player's position on <b>Bonus ladder</b>
    depends on the amount of <b>Bonus Symbols</b> on reels\n  when entering <b>Guess
    or Dare Bonus</b>."
  m_isRightToLeft: 0
