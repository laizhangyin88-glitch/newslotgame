  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "- There is a progression bar that contains <b>8</b> steps.\n- These steps
    represent <b>Symbols</b> in <b>Base Games</b>.\n- Player can fill any of these
    steps regardless of the order.\n- Each time when player has a win line, <b>PORTION</b>
    of the relevant step will be filled.\n     -<b>Wild</b> can be part of a win.\n-
    Once player fills all steps, <b>Bonus Mode</b> will be activated."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: a37185139d8ca414a97098cdfcb88355, type: 2}
