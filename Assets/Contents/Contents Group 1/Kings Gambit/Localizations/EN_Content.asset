  - key: SYMBOL_NAME_10
    value: Black Knights
  - key: SYMBOL_NAME_11
    value: Black Pawns
  - key: PAYTABLE_SYMBOL_NAME_0
    value: <style=title><size=32>KING WILD</style>
  - key: PAYTABLE_SYMBOL_NAME_2
    value: <style=title><size=32>QUEEN</style>
  - key: PAYTABLE_SYMBOL_NAME_4
    value: <style=title><size=32>ROOK</style>
  - key: PAYTABLE_SYMBOL_NAME_6
    value: <style=title><size=32>BISHOP</style>
  - key: PAYTABLE_SYMBOL_NAME_8
    value: <style=title><size=32>KNIGHT</style>
  - key: PAYTABLE_SYMBOL_NAME_10
    value: <style=title><size=32>PAWN</style>
  - key: PAYTABLE_DESCRIPTION_PAGE_1_0
    value: '<size=32><color=red>BLACK & WHITE KINGS</size>

      <size=22><color=#e9c86e>ARE ALWAYS <color=#ffff00><size=30>WILD</size></color>
      AND

      SUBSTITUTE FOR ALL SYMBOLS.


      OPPOSING SIDE KINGS ALSO TRIGGER

      <color=#ffff00><size=30>THE CHECKMATE BONUS</size></color>

      IF TAKEN BY ONE OF YOUR PIECES

      DURING THE WILD MOVE FEATURE.'
  - key: PAYTABLE_DESCRIPTION_PAGE_1_1
    value: '<size=22><color=#e9c86e>ACTIVATE <color=#ffff00><size=30>WILD MOVE</size></color>
      FEATURE

      WITH A <color=red><size=30>QUEEN</size></color> TO DOUBLE ALL

      WINS FOR THAT SPIN.'
  - key: PAYTABLE_SYMBOL_DESCRIPTION_11
    value: "<size=16>SCATTERS trigger \nfeature in any position."
  - key: PAYTABLE_SYMBOL_DESCRIPTION_0
    value: "<size=16>WILDS substitute for all symbols, except \nSCATTERS. When one
      or more WILDS\nsubstitute in a win, highest win is paid."
  - key: PAYTABLE_SYMBOL_PAYOUT_FORMAT
    value: '<b><size=32>5 <style=coinColor>{2:CommaNumber}</style>

      4 <style=coinColor>{1:CommaNumber}</style>

      3 <style=coinColor>{0:CommaNumber}</style></size></b>'
  - key: PAYTABLE_TITLE_PAGE_3
    value: <style=title><size=42>WILD MOVE FEATURE</style>
  - key: PAYTABLE_DESCRIPTION_PAGE_3_0
    value: '<size=24><color=#fffff3>THE <color=red>WILD MOVE</color> FEATURE CHANGES

      ALL SYMBOLS IN THE HIGHLIGHTED

      POSITIONS ON THE BOARD TO <color=red>WILDS.</color>'
  - key: PAYTABLE_DESCRIPTION_PAGE_3_1
    value: '<size=18><color=#e9c86e>TO ACTIVATE IT, LAND THE CORRESPONDING PIECE OF
      YOUR CHOSEN

      SIDE AT EITHER END OF A <color=#e8fb28>ROOK, BISHOP</color> OR <color=#e8fb28>KNIGHT</color>
      MOVE, WHICH IS

      HIGHLIGHTED ON THE BOARD DURING EVERY SPIN IN THE BASE GAME.


      FOR EXAMPLE, IF YOUR CHOSEN SIDE IS <color=#e8fb28>BLACK,</color>  AND A <color=#e8fb28>KNIGHT</color>  MOVE
      IS

      HIGHLIGHTED DURING THE SPIN, A <color=#e8fb28>BLACK KNIGHT</color>  NEEDS TO
      LAND IN

      EITHER OF THE 2 POSITIONS SURROUNDED BY FLAMES TO ACTIVATE THE FEATURE.


      ADDITIONALLY, IF THE <color=#e8fb28>QUEEN</color> OF YOUR CHOSEN SIDE LANDS
      AT EITHER END

      OF A MOVE, SHE ALSO TRIGGERS THE FEATURE FOR ANY HIGHLIGHTED MOVE

      AND ALL WINS FOR THAT SPIN ARE <color=#e8fb28>DOUBLED.</color>


      YOU CAN CHANGE SIDES BEFORE EVERY SPIN.'
  - key: PAYTABLE_TITLE_PAGE_4
    value: <style=title><size=42>CHECKMATE BONUS</style>
  - key: PAYTABLE_DESCRIPTION_PAGE_4_0
    value: '<size=24><color=#fffff3>TRIGGER THE <color=red>CHECKMATE BONUS</color>

      BY TAKING THE OPPOSING SIDE''S KING

      IN A <color=red>WILD MOVE</color> DURING THE BASE GAME.'
  - key: PAYTABLE_DESCRIPTION_PAGE_4_1
    value: '<size=18><color=#e9c86e>BONUS AWARDS <color=#e8fb28>5</color> FREE SPINS
      AND INCLUDES THE <color=#e8fb28>WILD MOVE</color>

      FEATURE, WHICH ACTIVATES DIFFERENTLY TO THE BASE GAME.


      ANY <color=#e8fb28>QUEEN, ROOK, BISHOP</color> OR <color=#e8fb28>KNIGHT</color>
      OF YOUR CHOSEN SIDE THAT

      LANDS WILL BE CHOSEN AT RANDOM TO EXECUTE A <color=#e8fb28>WILD MOVE</color>

      DURING THE BONUS.


      WINS ARE STILL DOUBLED IF THE <color=#e8fb28>WILD MOVE</color> IS EXECUTED BY
      A <color=#e8fb28>QUEEN,</color>

      AND <color=#e8fb28>5</color> EXTRA FREE SPINS ARE AWARDED FOR TAKING THE OPPOSING

      SIDES <color=#e8fb28>KING</color> IN ANY <color=#e8fb28>WILD MOVE.</color>


      YOU CAN ALSO CHANGE SIDES BEFORE EVERY FREE SPIN.'
  - key: PAYTABLE_TITLE_PAGE_5
    value: <style=title><size=42>ALL PAYS</style>
  - key: PAYTABLE_DESCRIPTION_PAGE_5_0
    value: '<size=60>1024 DIFFERENT

      WAYS TO WIN!'
  - key: PAYTABLE_DESCRIPTION_PAGE_5_1
    value: '<size=32><color=#e9c86e>SYMBOLS ON ADJACENT REELS PAY FROM

      LEFT TO RIGHT WITHOUT ANY SPECIFIC

      LINE CONFIGURATIONS.'
  - key: PAYTABLE_WAY_INFO
    value: <size=24><color=#00eaff>1024 WAYS</color></size>
  - key: PAYTABLE_BET_INFO
    value: '<size=24><color=#00eaff>Base Bet: 65</color></size>'
  - key: CONTENTS_GAME_TITLE
    value: KingsGambit
