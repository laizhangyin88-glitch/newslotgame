    value: '{0} {1} wins {2:CommaNumber}X{3} = {4:CommaNumber} (X{5})'
  - key: SIGN_BOARD_WIN_DESCRIPTION_1
    value: '{0} {1} wins {2:CommaNumber}X{3} = {4:CommaNumber}'
