      m_Calls: []
  m_text: "<size=24>- 3 Scatter symbols triggers Free Games.\n- Select one of 3 Free
    Game bonuses to play for 5 free spins.\n\n        <style=highlight 1>- Instant
    Crush:</style> Bonus adds Wild symbols. Added Wilds disappear after \n          the
    spin and new Wilds are added every spin.\n        <style=highlight 1>- Locker
    Room:</style> Bonus adds Wild symbols that stay locked until the end \n          of
    Free Games.\n        <style=highlight 1>- Stretch Me:</style> Bonus adds expanding
    Wild symbols that stay locked until \n          the end of Free Games. "
