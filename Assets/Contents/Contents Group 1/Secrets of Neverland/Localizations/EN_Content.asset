  - key: PAYTABLE_SYMBOL_NAME_0
    value: <style=title><size=32><style=coinColor>WILD
  - key: PAYTABLE_SPECIAL_SYMBOL_PAYOUT_FORMAT
    value: '<b><size=24>5 <style=coinColor>{3:CommaNumber}</style>

      4 <style=coinColor>{2:CommaNumber}</style>

      3 <style=coinColor>{1:CommaNumber}</style>

      </size></b>'
  - key: PAYTABLE_SYMBOL_DESCRIPTION_0
    value: '<size=20>Substitutes all symbols

      except Scatter'
  - key: PAYTABLE_SYMBOL_NAME_1
    value: <style=title><size=32><style=coinColor>SCATTER
  - key: PAYTABLE_SYMBOL_DESCRIPTION_1
    value: '<size=24>Scatters appear

      on reels 2, 3 and 4.'
  - key: PAYTABLE_SYMBOL_PAYOUT_FORMAT
    value: '<b><size=24>5 <style=coinColor>{2:CommaNumber}</style>

      4 <style=coinColor>{1:CommaNumber}</style>

      3 <style=coinColor>{0:CommaNumber}</style></size></b>'
  - key: PAYTABLE_WAY_INFO
    value: <size=24><style=coinColor>50 LINES</color></size>
  - key: PAYTABLE_BET_INFO
    value: '<size=24><style=coinColor>Bet Per Line: 1</color></size>'
  - key: PAYTABLE_TITLE_PAGE_2
    value: <style=title><size=42><style=coinColor>Surprize Peter Feature</size></style>
  - key: PAYTABLE_DESCRIPTION_PAGE_2
    value: '<size=30>Surprise Wild appears on reels 2 and 4 only.

      When Surprise Wild fully covers the reel,

      then one of the following is triggered:

      <style=coinColor>- Next reel becomes Wild

      - Characters become Wild

      - Crossing Wild'
  - key: PAYTABLE_TITLE_PAGE_3
    value: '<style=title><size=42><style=coinColor>Glorious Adventure

      Progression Feature</size></style>'
  - key: PAYTABLE_DESCRIPTION_PAGE_3
    value: "<size=30>Player has a chance to get progression points for 3 different
      \nBonuses from collecting <style=coinColor>Compass Sub-Symbols</style> \nduring
      Base Games.\nWatch for <style=coinColor>Platinum Compass</style> that completes
      random progression \nimmediately!\nIn order to unlock Peter's Wheel Bonus, player
      should\ncollect <style=coinColor>3</style>           from 3 different Bonuses."
  - key: PAYTABLE_TITLE_PAGE_4
    value: <style=title><size=42><style=coinColor>Free Games</size></style>
  - key: PAYTABLE_DESCRIPTION_PAGE_4
    value: "<size=30>3 Scatters trigger 8 Free Games and pay x2 total bet.\nDuring
      Free Games, Scatters appear on reels 2 and 4.\nEach Scatter awards extra 2 Free
      Games.\nSurprise Peter Pan Feature occurs more often \nduring Free Games."
