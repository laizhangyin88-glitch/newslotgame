  - key: PAYTABLE_SYMBOL_PAYOUT_FORMAT
    value: '<b><size=28>5 <style=coinColor>{2:CommaNumber}</style>

      4 <style=coinColor>{1:CommaNumber}</style>

      3
      <style=coinColor>{0:CommaNumber}</style></size></b>'
  - key: PAYTABLE_TITLE_PAGE_1
    value: <style=title><size=30>BONUS
  - key: PAYTABLE_SYMBOL_DESCRIPTION_1
    value: "<size=18>\n-  Bonus Symbol on a reel awards the prize on the\n   Prize
      Table that is on the same reel as where\n   Bonus Symbol landed.</size>"
  - key: PAYTABLE_SYMBOL_DESCRIPTION_1_1
    value: "<size=18>\n-  Wild substitute for every symbol except Bonus\n   symbol.\n- 
      Wild appears on reels 2, 3, 4 and 5.</size>"
  - key: PAYTABLE_TITLE_PAGE_1_1
    value: <style=title><size=30>WILD
  - key: PAYTABLE_TITLE_PAGE_2
    value: <style=title><size=42>PRIZE TABLE
  - key: PAYTABLE_DESCRIPTION_PAGE_2
    value: "<size=26>\n-  There is a Prize Table with prizes above the reel set.\n\n- 
      Award the Prize that is on the same reel as where                 landed. \n\n- 
      Prizes are either Credit amounts or Free Games.\n      -  Award the Credit
      amounts if player wins Credit from the Prize Table.\n      -  Award 10 Free
      Spins if player wins Free Games from the Prize Table.\n\n-  Winning two Free
      Games in a spin awards 20 Free Spins."
  - key: PAYTABLE_DESCRIPTION_PAGE_3
    value: "<size=22>\n-  During Free Games, 'All Wins Multiplier' is activated.\n\n- 
      In Free Games, 'All Wins Multiplier' starts with x2.\n\n-  In Free Games, Credit
      amount from the Prize Table or Symbol wins will be\n   multiplied with \"All
      Wins Multiplier\".\n\n-  During Free Games, Prize Table has 3 types of Prizes:
      Credit, Extra Games and Multiplier.\n      -  Award the Credit amounts if player
      wins Credit from the Prize Table.\n      -  Award one additional spin if player
      wins Extra Games from the Prize Table.\n      -  Award wins x 'All Wins Multiplier
      +1' if player wins Multiplier from the Prize Table.\n"
  - key: PAYTABLE_DESCRIPTION_PAGE_4
    value: '<size=22>

      -  87.5% of Line Bet is added as Extra Bet to activate
      the Prize Table Bonus.'
  - key: PAYTABLE_TITLE_PAGE_3
    value: <style=title><size=42>FREE GAMES
  - key: PAYTABLE_SYMBOL_DESCRIPTION_10_0
    value: '<size=26><color=#cddeff>ANY SCATTER WIN ACTIVATES THE FREE SPINS BONUS.

      ANY
      SCATTER WIN DURING FREE SPINS TRIGGERS MORE FREE SPINS.'
  - key: PAYTABLE_SYMBOL_DESCRIPTION_10_1
    value: "<size=26><color=#fc9109>SCATTERS WIN WHEN <style=coinColor>3</style>
      OR MORE LAND ANYWHERE ON \nADJACENT REELS FROM THE LEFTMOST REEL, BUT NOT \nNECESSARILY
      ON A PLAYED LINE."
  - key: PAYTABLE_SYMBOL_DESCRIPTION_10_2
    value: <size=18><color=#6cabff>SCATTER WINS ARE MULTIPLIED BY THE TOTAL WAGER.
      PAYS SHOWN WITH A WAGER OF 1 COIN
  - key: PAYTABLE_TITLE_PAGE_4
    value: <style=title><size=42>EXTRA BET
  - key: PAYTABLE_SCATTER_SYMBOL_SUB_TITLE
    value: <b><size=24><color=#fc9109>PAYS   FREE SPINS
  - key: PAYTABLE_SCATTER_SYMBOL_PAYOUT_FORMAT_TEXT
    value: '<b><size=32>5

      4

      3'
  - key: PAYTABLE_SCATTER_SYMBOL_PAYOUT_FORMAT
    value: '<b><size=32><style=coinColor>{2:CommaNumber}</style>

      <style=coinColor>{1:CommaNumber}</style>

      <style=coinColor>{0:CommaNumber}</style></size></b>'
  - key: PAYTABLE_SCATTER_SYMBOL_PAYOUT_FREE_SPINS
    value: '<b><size=32><style=coinColor> 20</style>

      <style=coinColor> 15</style>

      <style=coinColor>
      10</style></size></b>'
  - key: PAYTABLE_DESCRIPTION_PAGE_4_0
    value: "<size=32><color=#cddeff>ALL WINS PAY \nLEFT TO RIGHT ON ADJACENT REELS,
      \nBEGINNING WITH LEFTMOST REEL."
  - key: PAYTABLE_DESCRIPTION_PAGE_4_1
    value: "<size=32><color=#fc9109>ALL WINS ARE PAID ON LINES PLAYED,\n EXCEPT SCATTER.
      HIGHEST WIN PAID \nON ANY PLAYED LINE."
  - key: PAYTABLE_DESCRIPTION_PAGE_4_2
    value: "<size=32><color=#6cabff>ALL WINS ARE MULTIPLIED BY THE \nNUMBER OF COINS
      BET PER LINE."
  - key: PAYTABLE_TITLE_LINES
    value: <style=title><size=42>LINES
  - key: PAYTABLE_WAY_INFO
    value: <size=24><color=#00eaff>40 LINES</color></size>
  - key: PAYTABLE_BET_INFO
    value: '<size=24><color=#00eaff>Bet Per Line: 1</color></size>'
