  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 0
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<size=17>\n-  Bingo Feature is triggered when one or more Bingo Lines are
    completed on the Bingo Card.\n\n-  Progress of a Bingo Card is saved per bet level.\n\n-
    \ If one or more filled Bingo lines include Wheel symbol, one spin of Wheel Bonus
    is awarded.\n\n     -  During Wheel Bonus, the Wheel Bonus prize can be Credit,
    Mini Jackpot,\n        Minor Jackpot, Major Jackpot, Mega Jackpot, or Grand Jackpot.\n
    \    \n     -  Range of Credit Prizes can be from at least 8x Total Bet up to
    \n        110x Total Bet during Wheel Bonus.\n     \n     -  The Wheel Bonus prize
    will replace the Wheel symbol and will be used \n        when Bingo prize is calculated.\n\n-
    \ At the end of the Bingo Feature, for each filled Bingo line, all prizes are
    added and awarded.\n\n     -  If the same Progressive Jackpot is added multiple
    times, progressive amount is awarded only once.\n\n-  Bingo Card resets after
    the completion of Bingo Feature.\n\n-  When Bingo Card is reset, 2 to 3 random
    positions on the Bingo Card are filled with Mini Jackpots, Minor Jackpots, or
    Major Jackpots."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 5316d286fa94a894888ee12767189de0, type: 2}
