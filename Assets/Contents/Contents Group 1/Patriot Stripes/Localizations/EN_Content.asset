  - key: PAYTABLE_TITLE_RICH_HITS_JACKPOT
    value: <style=title><size=42>RICH HITS JACKPOT</size></style>
  - key: PAYTABLE_DESCRIPTION_RICH_HITS_JACKPOT
    value: '<size=24>- Rich Hits is Scatter and also awards progressives.

      -
      Progressives are awarded for 5 to 9 Rich Hits symbols.'
  - key: PAYTABLE_DESCRIPTION_RICH_HITS_AWARDS
    value: '<size=24>Any 9+ RICH HITS symbols awards <style=coinColor><b>1000x total
      bet</b></style>

      Any 8 RICH HITS symbols awards  <style=coinColor><b>500x
      total bet</b></style>

      Any 7 RICH HITS symbols awards  <style=coinColor><b>75x
      total bet</b></style>

      Any 6 RICH HITS symbols awards  <style=coinColor><b>30x
      total bet</b></style>

      Any 5 RICH HITS symbols awards  <style=coinColor><b>8x
      total bet</b></style>

      Any 4 RICH HITS symbols awards  <style=coinColor><b>3x
      total bet</b></style>

      Any 3 RICH HITS symbols awards  <style=coinColor><b>1x
      total bet</b></style>'
  - key: PAYTABLE_TITLE_FREE_GAMES
    value: <style=title><size=42>FREE GAMES</size></style>
  - key: PAYTABLE_DESCRIPTION_FREE_GAMES
    value: '<size=24>- 3 Free Games symbols in reels 1, 3 and 5 triggers 15 Free
      Games.

      - During Free Games, Wild acts as both the Wild and Rich Hits
      symbols.</size>'
  - key: PAYTABLE_TITLE_WHEEL_BONUS
    value: <style=title><size=42>WHEEL BONUS</size></style>
  - key: PAYTABLE_DESCRIPTION_WHEEL_BONUS
    value: "<size=24>- 3 Wheel Bonus symbols in reels 2, 3 and 4 starts the Wheel
      Bonus.\n- Collect credit or Rich Hits symbols on the Wheel. \n- Receive Scatter
      pay or progressives for Rich Hit symbols collected.</size>"
  - key: PAYTABLE_WAY_INFO
    value: <size=24><color=#ccc5f5>9 LINES</color></size>
  - key: PAYTABLE_BET_INFO
    value: '<size=24><color=#ccc5f5>BET PER LINE: 1</color></size>'
