  - key: PAYTABLE_SYMBOL_PAYOUT_FORMAT
    value: '<b><size=24>5 <style=coinColor>{2:CommaNumber}</style>

      4 <style=coinColor>{1:CommaNumber}</style>

      3
      <style=coinColor>{0:CommaNumber}</style></size></b>'
  - key: PAYTABLE_TITLE_PAGE_1
    value: <style=title><size=32>TWIN REELS</style>
  - key: PAYTABLE_DESCRIPTION_PAGE_1
    value: <size=24>Play on both slots 1 & 2
  - key: PAYTABLE_TITLE_PAGE_2_1
    value: <style=title><size=42>CHESHIRE CAT JACKPOT
  - key: PAYTABLE_TITLE_PAGE_2_2
    value: <style=title><size=42>QUEEN OF HEARTS WILD
  - key: PAYTABLE_DESCRIPTION_PAGE_2_1
    value: "<size=24>- 6 or more in any position on either reel sets wins \n  an
      instant CHESHIRE CAT JACKPOT!\n<size=18>        - Any 10 symbols awards <style=coinColor>500x
      total bet</style>\n        - Any 9 symbols awards <style=coinColor>250x total
      bet</style>\n        - Any 8 symbols awards <style=coinColor>100x total bet</style>\n      
      - Any 7 symbols awards <style=coinColor>50x total bet</style>\n        - Any
      6 symbols awards <style=coinColor>10x total bet</style>"
  - key: PAYTABLE_DESCRIPTION_PAGE_2_2
    value: "<size=24>- Queen of Hearts may appear randomly to turn \n  one or more
      reels to Wild.\n- Wild substitutes for all symbols except Scatter and Jackpots. "
  - key: PAYTABLE_TITLE_PAGE_3
    value: <style=title><size=42>BONUS GAMES
  - key: PAYTABLE_DESCRIPTION_PAGE_3
    value: "<size=20>- Scatter appears on reels 1, 3 and 5 only. 3 Scatters in a
      single reel set triggers Bonus Games. \n- The 3rd Scatter determines one of
      3 Bonus Games available."
  - key: PAYTABLE_TITLE_BOOSTED
    value: '<style=title><size=24>BOOSTED REELS

      FREE GAMES'
  - key: PAYTABLE_DESCRIPTION_BOOSTED
    value: '<size=18>- 5 Free Games

      - Reel expands during each spin.

      -
      Walking Alice is Wild!

      - 1st Spin: Reel 5 is Wild

      - 2nd Spin:
      Reel 4 is Wild

      - 3rd Spin: Reel 3 is Wild

      - 4th Spin: Reel 2
      is Wild

      - 5th Spin: Reel 1 is Wild'
  - key: PAYTABLE_TITLE_MIRRORED
    value: '<style=title><size=24>MIRRORED WILD

      FREE GAMES'
  - key: PAYTABLE_DESCRIPTION_MIRRORED
    value: '<size=18>- 3 Free Games

      - Alice and moving mirror are Wild!

      -
      1st Spin:  Reels 2, 3 are Wild

      - 2nd Spin: Reels 2, 3, 4 are Wild

      -
      3rd Spin: Reels 2, 3, 4, 5 are Wild'
  - key: PAYTABLE_TITLE_HEART
    value: '<style=title><size=24>RED HEART

      BONUS'
  - key: PAYTABLE_DESCRIPTION_HEART
    value: "<size=18>- Pick any red heart! \n- Picking \"Next Stage\" initiates \n
      a Wheel Bonus\n- Pick up to 4 friends to help \n  upgrade the Wheel Bonus \n 
      with multipliers "
  - key: PAYTABLE_TITLE_LINES
    value: <style=title><size=42>LINES</size></style>
  - key: PAYTABLE_DESCRIPTION_LINES
    value: <style=coinColor><size=20>The 2 reel sets have the same pay lines.
  - key: PAYTABLE_WAY_INFO
    value: <size=24><color=#00eaff>40 LINES</color></size>
  - key: PAYTABLE_BET_INFO
    value: '<size=24><color=#00eaff>Bet Per Line: 1</color></size>'
