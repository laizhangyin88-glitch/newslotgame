    value: <style=title><size=32>WILD</style>
  - key: PAYTABLE_SYMBOL_NAME_11
    value: <style=title><size=32>SCATTER</style>
  - key: PAYTABLE_SYMBOL_PAYOUT_FORMAT
    value: '<b><size=24>5 <style=coinColor>{2:CommaNumber}</style>

      4 <style=coinColor>{1:CommaNumber}</style>

      3 <style=coinColor>{0:CommaNumber}</style></size></b>'
  - key: PAYTABLE_TITLE_PAGE_1
    value: <style=title><size=42>GAME RULES</style>
  - key: PAYTABLE_DESCRIPTION_PAGE_1
    value: "<size=24>All wins pay LEFT to RIGHT on adjacent reels, \nbeginning with
      leftmost reel, except scatters. \nAll wins are paid on lines played, except
      scatters, \nwhich are added to line wins. \nHighest win paid on any played line,
      except scatters. \nAll wins are multiplied by the number of coins bet per line,
      \nexcept scatters."
  - key: PAYTABLE_TITLE_PAGE_2_1
    value: <style=title><size=42>SCATTER PAYS</style>
  - key: PAYTABLE_TITLE_PAGE_2_2
    value: <style=title><size=42>SUBSTITUTION PAYS</style>
  - key: PAYTABLE_DESCRIPTION_PAGE_2_1
    value: '<size=24>SCATTER symbols pay in any position.

      SCATTER wins are multiplied by total bet.'
  - key: PAYTABLE_DESCRIPTION_PAGE_2_2
    value: "<size=24>WILDS substitute for all symbols, except SCATTERS. \nWhen one
      or more WILDS substitute in a win, highest win is paid."
  - key: PAYTABLE_TITLE_PAGE_4
    value: <style=title><size=42>BONUS WIN</style>
  - key: PAYTABLE_DESCRIPTION_PAGE_4
    value: '<b><size=32><style=coinColor>GOLDEN CUB SPINS</size></style></b>

      <size=24>BEAR CUB LOCKED WILD Free Spin Feature:

      3, 4 or 5 SCATTER Symbols triggers 5, 8 or 12 Free Spins.

      <size=10>

      </size>Player will be presented with 3 bear cubs to choose from. Chosen Bear
      Cub

      will turn WILD for all Free Spins. Any WILD appearing anywhere in the

      Reel Window will Lock into place and remain WILD for rest of Free Spin

      Series. Free Spins cannot be re-triggered.'
  - key: PAYTABLE_TITLE_LINES
    value: <style=title><size=42>LINES</size></style>
  - key: PAYTABLE_WAY_INFO
    value: <size=24><color=#00eaff>50 LINES</color></size>
  - key: PAYTABLE_BET_INFO
    value: '<size=24><color=#00eaff>Bet Per Line: 1</color></size>'
  - key: CONTENTS_GAME_TITLE
    value: Bear Cubs
