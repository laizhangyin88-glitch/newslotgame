  m_RaycastTarget: 0
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<size=23>- At the beginning of Every spin of Base Games and Free Games,
    Active Reel Set \n  Feature is triggered for 3 spins at most. \n- If there is
    any win, active 4x5 Reel Set sifts to right by 1 reel.\r\n- In this way, the feature
    continues until there is no win.\r\n- As it shifts, the multiplier increases from
    x1 to x3.\r\n     - During Free Games, the multiplier begins with x1 and increases
    by 2 whenever\n        Active Reel Set shits to right by 1 reel. \r\n- If any
    win occurs at the 3rd spin of the feature, then it triggers Bonus Reel Feature.</size>"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 6a1ffa1e6bf7b5c4e9ddebf30cb094e1, type: 2}
