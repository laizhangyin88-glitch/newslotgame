  - key: PAYTABLE_SYMBOL_PAYOUT_FORMAT
    value: '<b><size=24>5 <style=coinColor>{2:CommaNumber}</style>

      4 <style=coinColor>{1:CommaNumber}</style>

      3 <style=coinColor>{0:CommaNumber}</style></size></b>'
  - key: PAYTABLE_TITLE_WILD
    value: <style=title><size=35>WILD</style>
  - key: PAYTABLE_DESCRIPTION_WILD
    value: "<size=18>- Wild substitutes for all symbols.\r\n\n- All Wild Symbols get
      locked during\n   Active Reel Set Feature.</size>"
  - key: PAYTABLE_TITLE_JACKPOT
    value: <style=title><size=35>JACKPOT</style>
  - key: PAYTABLE_DESCRIPTION_GRAND
    value: '<size=16>PROGRESSIVE

      OR

      <style=coinColor>1000 x TOTAL BET</style>

      </size>'
  - key: PAYTABLE_DESCRIPTION_MEGA
    value: '<size=16>PROGRESSIVE

      OR

      <style=coinColor>500 x TOTAL BET</style>

      </size>'
  - key: PAYTABLE_DESCRIPTION_MAJOR
    value: '<size=16>PROGRESSIVE

      OR

      <style=coinColor>100 x TOTAL BET</style>

      </size>'
  - key: PAYTABLE_DESCRIPTION_MINOR
    value: '<size=16>PROGRESSIVE

      OR

      <style=coinColor>30 x TOTAL BET</style>

      </size>'
  - key: PAYTABLE_TITLE_PAGE_2
    value: <style=title><size=35>ACTIVE REEL SET FEATURE</style>
  - key: PAYTABLE_DESCRIPTION_PAGE_2
    value: "<size=23>- At the beginning of Every spin of Base Games and Free Games,
      Active Reel Set \n  Feature is triggered for 3 spins at most. \n- If there is
      any win, active 4x5 Reel Set shifts to right by 1 reel.\n- In this way, the
      feature continues until there is no win.\n- As it shifts, the multiplier increases
      from x1 to x3.\n     - During Free Games, the multiplier begins with x1 and
      increases by 2 whenever\n        Active Reel Set shifts to right by 1 reel.
      \n- If any win occurs at the 3rd spin of the feature, then it triggers Bonus
      Reel Feature.</size>"
  - key: PAYTABLE_TITLE_PAGE_3
    value: <style=title><size=35>BONUS REEL FEATURE</style>
  - key: PAYTABLE_DESCRIPTION_PAGE_3
    value: '<size=23>- Bonus Reel spins when there is any win on the 3rd spin of Active
      Reel Set Feature.

      - Bonus Reel randomly awards Coins, Free Games, or Progressive Jackpots.

      - Bonus Reel Feature ends after winning a bonus.

      - During Free Games, same rule applies.</size>'
  - key: PAYTABLE_TITLE_PAGE_4
    value: <style=title><size=35>FREE GAMES</size>
  - key: PAYTABLE_DESCRIPTION_PAGE_4_1
    value: <size=23>- Bonus symbol on Bonus Reel triggers 10 Free Games.</size>
  - key: PAYTABLE_DESCRIPTION_PAGE_4_2
    value: "<size=23>- During Free Games, the multiplier begins with x1 and increases
      by 2 whenever Active\n   Reel Set shifts to right by 1 reel. </size>"
  - key: PAYTABLE_TITLE_LINES
    value: <style=title><size=35>LINES</size>
  - key: PAYTABLE_WAY_INFO
    value: <size=24><color=#00eaff>20 LINES</color></size>
  - key: PAYTABLE_BET_INFO
    value: '<size=24><color=#00eaff>Bet Per Line: 1</color></size>'
