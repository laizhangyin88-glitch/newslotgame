--- !u!114 &6661009996178409276
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1990648959027731735}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 0
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<size=21>- There is no limit on the number of spins during Free Games.\n\n-
    In Free Games, when a More Beer Symbol appears on a reel, a\n   spot is added
    to that reel, extending the height of the reel by 1.\n\n- More Beer Symbols appear
    on all reels and can expand the\n   height of the reels up to 6.\n\n- There are
    3 kinds Oak Barrels above reels, displaying prizes.\n\n- When a reel expands to
    a height of 6, award the prize on the\n   Oak Barrel of the very same reel.\n\n-
    Golden Oak Barrel awards Grand Jackpot and then ends Free\n   Games.\n   - Grand
    Jackpot can be unlocked at a certain bet or higher.\r\n   - Winning Grand Jackpot
    when locked, award the total bet X100.\r\n\n- Green Oak Barrel\_ awards the prize
    on it, resets the whole reel\n   size to 3x5 and game continues.\n\n- Red Oak
    Barrel awards the prize on it and then ends Free\n   Games.\n\n- Winning Red Oak
    Barrel along with either Green or Golden Oak\n   Barrel awards the prizes accordingly
    and then ends Free Games.</size>"
  m_isRightToLeft: 0
