  - key: PAYTABLE_SYMBOL_DESCRIPTION_11
    value: '<b><size=24>5 <style=coinColor>12 Free Games</style>

      4 <style=coinColor>10 Free Games</style>

      3 <style=coinColor>8 Free Games</style></size></b>'
  - key: PAYTABLE_SYMBOL_DESCRIPTION_0
    value: "<size=17>-  Bonus symbol appears on reels 2 and 4.\n\n-  Bonus symbols
      are collected towards\n   one of the 3 re-spin bonuses.\n\n-  During Free Games
      and Mega Free\n   Games, Bonus symbol awards +1 free\n   spin."
  - key: PAYTABLE_SYMBOL_PAYOUT_FORMAT_1
    value: '<b><size=20>5 <style=coinColor>{3:CommaNumber}</style>

      4 <style=coinColor>{2:CommaNumber}</style>

      3 <style=coinColor>{1:CommaNumber}</style>

      2 <style=coinColor>{0:CommaNumber}</style></size></b>'
  - key: PAYTABLE_SYMBOL_PAYOUT_FORMAT_2
    value: '<b><size=20>5 <style=coinColor>{2:CommaNumber}</style>

      4 <style=coinColor>{1:CommaNumber}</style>

      3 <style=coinColor>{0:CommaNumber}</style></size></b>'
  - key: PAYTABLE_TITLE_PAGE_1
    value: <style=title><size=27>BONUS SYMBOL
  - key: PAYTABLE_DESCRIPTION_PAGE_1_1
    value: "<size=20>Stacks of 3                  pay in any \n                                        position"
  - key: PAYTABLE_DESCRIPTION_PAGE_1_2
    value: <size=20><b>5 stacks of 3                 <color=#FFFF00>4</color>
  - key: PAYTABLE_DESCRIPTION_PAGE_1_3
    value: <size=20><b>4 stacks of 3                 <color=#FFFF00>2</color>
  - key: PAYTABLE_DESCRIPTION_PAGE_1_4
    value: <size=20><b>3 stacks of 3                 <color=#FFFF00>1</color>
  - key: PAYTABLE_DESCRIPTION_PAGE_1_5
    value: <size=20>or                  does not pay.
  - key: PAYTABLE_TITLE_PAGE_2_1
    value: <style=title><size=27>BASE MEGA STACK FEATURE
  - key: PAYTABLE_DESCRIPTION_PAGE_2_1_1
    value: '<size=19>- Every spin of Base Games, one symbol is randomly selected and
      it appears as a full stack on reels.

      - A stack is when a symbol occurs consecutively on the same reel. '
  - key: PAYTABLE_TITLE_PAGE_2_2
    value: <style=title><size=27>BONUS SYMBOL
  - key: PAYTABLE_DESCRIPTION_PAGE_2_2_1
    value: '<size=19>- Bonus symbols always appear only in full stacks on every reel.

      - 3 or more full stacks of Bonus symbols anywhere on reels triggers Choose Your
      Bonus.'
  - key: PAYTABLE_TITLE_PAGE_3
    value: <style=title><size=27>CHOOSE YOUR BONUS
  - key: PAYTABLE_DESCRIPTION_PAGE_3_1
    value: "<size=16>- Free Games is awarded with 3 or more stacks of 3 Bonus Symbols.\n-
      A second screen will appear displaying 5 Free Game options. \n- Choose a symbol
      to be added to the reels during Free Games. \n- The number of Free Games awarded
      is determined by the selected symbol, as shown in the table below :"
  - key: PAYTABLE_DESCRIPTION_PAGE_3_2
    value: <size=14>3 stacks of 3
  - key: PAYTABLE_DESCRIPTION_PAGE_3_3
    value: <size=14>4 stacks of 3
  - key: PAYTABLE_DESCRIPTION_PAGE_3_4
    value: <size=14>5 stacks of 3
  - key: PAYTABLE_DESCRIPTION_PAGE_3_5
    value: <size=13>Awards <color=#FFFF00>5</color> Free Games
  - key: PAYTABLE_DESCRIPTION_PAGE_3_6
    value: <size=13>Awards <color=#FFFF00>10</color> Free Games
  - key: PAYTABLE_DESCRIPTION_PAGE_3_7
    value: <size=13>Awards <color=#FFFF00>20</color> Free Games
  - key: PAYTABLE_DESCRIPTION_PAGE_3_8
    value: <size=13>Awards <color=#FFFF00>12</color> Free Games
  - key: PAYTABLE_DESCRIPTION_PAGE_3_9
    value: <size=13>Awards <color=#FFFF00>24</color> Free Games
  - key: PAYTABLE_DESCRIPTION_PAGE_3_10
    value: <size=13>Awards <color=#FFFF00>48</color> Free Games
  - key: PAYTABLE_DESCRIPTION_PAGE_3_11
    value: <size=13>Awards <color=#FFFF00>15</color> Free Games
  - key: PAYTABLE_DESCRIPTION_PAGE_3_12
    value: <size=13>Awards <color=#FFFF00>30</color> Free Games
  - key: PAYTABLE_DESCRIPTION_PAGE_3_13
    value: <size=13>Awards <color=#FFFF00>60</color> Free Games
  - key: PAYTABLE_DESCRIPTION_PAGE_3_14
