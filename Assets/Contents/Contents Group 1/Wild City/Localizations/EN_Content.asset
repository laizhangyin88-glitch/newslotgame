  - key: PAYTABLE_TITLE_1
    value: <style=title><size=42>WILD REPLICATE</size></style>
  - key: PAYTABLE_DESCRIPTION_1
    value: "<size=24>- Wild symbol replicates, randomly traveling around reels 2-4,
      \n  in one snake-like motion.\n- Wild symbol does not travel toward an existing
      Wild.\n- Wild symbol replicates at most 11 times in base game and 20 times\n
      \ in free games.</size>"
  - key: PAYTABLE_TITLE_2
    value: <style=title><size=42>FREE GAMES</size></style>
  - key: PAYTABLE_DESCRIPTION_2
    value: "<size=24>- 8 or more Scatter symbols in any position triggers 12 Free
      Games.\n- Every 3 Free Games expands reel set by 1 row.\n- Reel set expands
      at most up to 7x5 with 16807 ways.\n- During Free Games, 8 or more Scatter symbols
      awards 3 additional \n  Free Games.</size>"
  - key: PAYTABLE_WAY_INFO
    value: <size=24><color=#00eaff>1024 WAYS</color></size>
