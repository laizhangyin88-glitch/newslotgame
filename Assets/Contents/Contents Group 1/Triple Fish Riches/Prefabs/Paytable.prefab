      m_Calls: []
  m_text: "<size=24><b>- During <color=#3de306>Green</color> & <color=#ffc600>Gold</color>
    Fish <style=coinColor>Combo Free Games</style>:</b>\n     - Any landed <b>Wild</b>
    awards <b>+1</b>, <b>+2 Free Spins</b>\n        or <b>Coin Prize</b>.\n     -
    Each spin, <b>2x</b>, <b>3x</b> or <b>5x multiplier</b> gets applied\n       
    to all line wins.\n<b>- During <color=#ffc600>Gold</color> & <color=#eb3619>Red</color>
    Fish <style=coinColor>Combo Free Games</style>:</b>\n     - Any landed <b>Wild</b>
    gets <b>locked on a spot</b> and\n        awards <b>+1</b>, <b>+2 Free Spins</b>
    or <b>Coin Prize</b>.\n<b>- During <color=#3de306>Green</color> & <color=#eb3619>Red</color>
    Fish <style=coinColor>Combo Free Games</style>:</b>\n     - Each spin <b>2x</b>,
    <b>3x</b> or <b>5x multiplier</b> gets applied\n        to all line wins.\n    
    - Any landed <b>Wild</b> gets <b>locked on a spot</b> during\n        Free Games.</size>"
