  m_GameObject: {fileID: 7660827486945071342}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 0
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<size=24>- <b>3 Wild Progressions</b> are available during both\n   Base
    Game & Free Game. \n\n- <b>Wild Progressions</b> are presented as Wilds and\n  
    come in 3 colors:\n   <color=#3de306><b>Green</b></color>       , <color=#ffc600><b>Gold</b></color>       
    & <color=#eb3619><b>Red</b></color>       . \n\n- When any <b>Wild</b> appears,
    it gets collected onto\n   the <b>Wild Progression</b> of the same color.\n\n-
    Whenever <b>Wild</b> lands, there is a chance it may\n   trigger relevant <style=coinColor><b>Free
    Games</b></style>:\n    -       triggers <color=#3de306><b>Green Fish Free Games</b></color>.
    \n    -       triggers <color=#ffc600><b>Gold Fish Free Games</b></color>.\n   
    -       triggers <color=#eb3619><b>Red Fish Free Games</b></color>. \n\n- Trigger
    <b>ANY TWO</b> for <style=coinColor><b>Combo Free Games</b></style>.\n\n- Trigger
    <b>ALL Three</b> for <color=#e400ff><b>Super Free Games</b></color>."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 5316d286fa94a894888ee12767189de0, type: 2}
