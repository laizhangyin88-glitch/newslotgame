  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<size=24>- During <color=#3de306><b>Green Fish Free Games</b></color>,
    each spin, <b>2x</b>, <b>3x</b>\n   or <b>5x multiplier</b> gets applied to all
    line wins.\n\n- During <color=#ffc600><b>Gold Fish Free Games</b></color>, any
    landed <b>Wild</b>\n   awards <b>+1</b>, <b>+2 Free Spins</b> or <b>Coin Prize</b>.\n\n-
    During <color=#eb3619><b>Red Fish Free Games</b></color>, any landed <b>Wild</b>\n  
    gets <b>locked on a spot</b> during Free Games."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 5316d286fa94a894888ee12767189de0, type: 2}
  m_sharedMaterial: {fileID: 21000010116884160, guid: 5316d286fa94a894888ee12767189de0,
