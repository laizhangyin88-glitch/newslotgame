  - key: PAYTABLE_TITLE_1
    value: '<style=title><color=#ff06a6><size=34>WILD SYMBOL

      </style></color>'
  - key: PAYTABLE_TITLE_2
    value: '<style=title><color=#ff06a6><size=34>RED HEART SYMBOL & HEART FLOATING
      SPIN

      </style></color>'
  - key: PAYTABLE_TITLE_3
    value: '<style=title><color=#ff06a6><size=34>HEART BONUS & GOLD HEART SYMBOL

      </style></color>'
  - key: PAYTABLE_TITLE_4
    value: '<style=title><color=#ff06a6><size=34>SCATTER & FREE GAMES

      </style></color>'
  - key: PAYTABLE_TITLE_5
    value: <style=title><color=#ff06a6><size=34>LINES</style></color>
  - key: PAYTABLE_DESCRIPTION_1
    value: '- appears on reels 2-5 only.

      - Substitutes for all symbols except
      Heart and Scatter symbols.'
  - key: PAYTABLE_DESCRIPTION_2
    value: " - Red Heart symbol appears on reels 1-4 only.\n - It can appear with
      Major, Minor, Mini Jackpots or Credit.\n - Red Heart symbol on a reel triggers
      Heart Floating Spin for that reel. \n - The reel with Heart Floating Spin moves
      down by one spot each spin until Red Heart symbol is not visible. "
  - key: PAYTABLE_DESCRIPTION_3
    value: " - 6 or more Red Heart symbols triggers Heart Bonus.\r\n - Triggering
      Red Heart symbols get locked and a fully filled row activates Demoness Reel.
      \r\n - From Demoness Reel, only Gold Heart Symbol appears. \r\n - Gold Heart
      Symbol appears with Grand, Mega Jackpots, Credit or Multiplier.\r\n - Gold
      Heart Symbol with a Multiplier applies that Multiplier to the Red Heart Symbols
      on the same row where Gold Heart Symbol with Multiplier appeared."
  - key: PAYTABLE_DESCRIPTION_4
    value: " - One Scatter can appear per reel. \n - 3 or more Scatters anywhere
      on reels triggers Free Games.\n - During Free Games, Heart Bonus is more likely
      to get triggered.\n - During Free Games, 3 or more Scatters re-triggers Free
      Games."
  - key: PAYTABLE_DESCRIPTION_5
    value: '5 - 15 free spins

      4 - 10 free spins

      3 - 6 free spins'
  - key: PAYTABLE_WAY_INFO
    value: <style=title><color=#ff06a6><size=24>50 LINES</style></color>
  - key: PAYTABLE_BET_INFO
    value: '<size=24><color=#ff06a6>Bet Per Line: 1</color></size>'
  - key: PAYTABLE_SYMBOL_PAYOUT_FORMAT
    value: '<b>5 <style=coinColor>{2:CommaNumber}</style>

      4 <style=coinColor>{1:CommaNumber}</style>

      3
      <style=coinColor>{0:CommaNumber}</style></b>'
