  m_RaycastTarget: 0
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<size=22>- 5 or more Bonus symbols in any position triggers the Rapid Link
    Bonus.\n- Number of initial Bonus symbols determines the number of free spins
    played.\n- All initial Bonus symbols get locked, while remaining spots spin individually.\n-
    Any new Bonus symbols will also get locked while remaining spots spin \n  for
    remaining spins.\n- When no more spins remain, Pick a Shield bonus may be triggered
    randomly to award \n  extra free spins.\n- Rapid Link Bonus ends when there are
    no more spins remaining. \n- Award the total sum value of all coin amounts on
    the Bonus symbols, including any \n  Jackpot amounts.\n- If all 20 spots are filled
    with Bonus symbols, multiply the total sum value \n   by x2, x3, or x5. \n"
