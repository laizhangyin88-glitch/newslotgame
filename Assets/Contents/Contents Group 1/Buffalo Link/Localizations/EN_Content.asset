  - key: PAYTABLE_SYMBOL_NAME_12
    value: <style=title><size=32>SCATTER</style>
  - key: PAYTABLE_SYMBOL_NAME_0
    value: <style=title><size=32>WILD</style>
  - key: PAYTABLE_SYMBOL_DESCRIPTION_0
    value: "<size=15>- Bonus symbols display \n  coin amounts.\n- Beyond a certain
      bet \n   level, higher coin \n   amounts are awarded.\n- 5 or more Bonus \n
      \ symbols triggers\n  the Rapid Link Bonus.\n"
  - key: PAYTABLE_SYMBOL_DESCRIPTION_12
    value: <size=19>3 or more Scatters triggers Free Games.
  - key: PAYTABLE_SYMBOL_DESCRIPTION_13
    value: '<size=16>Wild substitutes for all symbols except Scatter and appears on
      reels 2, 3, and 4 only.

'
  - key: PAYTABLE_SCATTER_SYMBOL_PAYOUT_FORMAT
    value: '<b><size=24></style>5 <style=coinColor>50 x total bet</style>

      </style>4 <style=coinColor>10 x total bet</style>

      </style>3 <style=coinColor>5 x total bet</style></size></b>'
  - key: PAYTABLE_SYMBOL_PAYOUT_FORMAT
    value: '<b><size=24>5 <style=coinColor>{2:CommaNumber}</style>

      4 <style=coinColor>{1:CommaNumber}</style>

      3 <style=coinColor>{0:CommaNumber}</style></size></b>'
  - key: PAYTABLE_TITLE_PAGE_2_1
    value: '<style=title><size=42>RAPID LINK BONUS

      </style>'
  - key: PAYTABLE_TITLE_PAGE_2_2
    value: <style=title><size=42>FREE GAMES</style>
  - key: PAYTABLE_DESCRIPTION_PAGE_2_1
    value: "<size=22>- 5 or more Bonus symbols in any position triggers the Rapid
      Link Bonus.\n- Number of initial Bonus symbols determines the number of free
      spins played.\n- All initial Bonus symbols get locked, while remaining spots
      spin individually.\n- Any new Bonus symbols will also get locked while remaining
      spots spin \n  for remaining spins.\n- When no more spins remain, Pick a Shield
      bonus may be triggered randomly to award \n  extra free spins.\n- Rapid Link
      Bonus ends when there are no more spins remaining. \n- Award the total sum value
      of all coin amounts on the Bonus symbols, including any \n  Jackpot amounts.\n-
      If all 20 spots are filled with Bonus symbols, multiply the total sum value
      \n   by x2, x3, or x5. \n"
  - key: PAYTABLE_DESCRIPTION_PAGE_2_2
    value: '<size=22>- 3 or more Scatters triggers Free Games.

      - Within Free Games, if 2 or more Scatters appear, award additional free spins.

      - If 5 or more Bonus symbols appear in Free Games, trigger the Rapid Link bonus.

'
  - key: PAYTABLE_WAY_INFO
    value: <size=24><color=#00eaff>1024 WAYS</color></size>
  - key: PAYTABLE_BET_INFO
    value: '<size=24><color=#00eaff>Base Bet: 50</color></size>'
  - key: PAYTABLE_SYMBOL_DESCRIPTION_12_FREE_COUNT
    value: '<size=24><b>5 <style=coinColor>1000</style></b>  <size=15>Pay, </size><style=coinColor>20</style></b>
      <size=15>Free Games</size>

      <b>4 <style=coinColor>500</style></b>     <size=15>Pay, </size><style=coinColor>15</style></b>
      <size=15>Free Games</size>

      <b>3 <style=coinColor>100</style></b>     <size=15>Pay, </size><style=coinColor>8</style></b>
      <size=15>Free Games</size>'
  - key: PAYTABLE_SYMBOL_NAME_13
    value: <style=title><size=32>BONUS SYMBOL</style>
  - key: PAYTABLE_TITLE_PAGE_3_1
    value: '<style=title><size=42>MULTIPLIER WILD FEATURE


      </style>'
  - key: PAYTABLE_DESCRIPTION_PAGE_3_1
    value: "<size=22>- Within Free Games, if there is a win including Wild, Wild becomes
      Multiplier Wild. \n- Multiplier Wild will multiply x2, x3, or x4 to the win
      amount.\n"
  - key: PAYTABLE_TITLE_EXTRA_BET
    value: <style=title><size=42>BONUS SYMBOL FEATURE</size></style>
  - key: PAYTABLE_DESCRIPTION_EXTRA_BET_1
    value: "<size=22>- Bonus symbols change color and status depending on the bet
      level.\n- Depending on Bonus status, they award different pays and require different
      amounts\n   for Extra Bet.</size>"
  - key: PAYTABLE_DESCRIPTION_EXTRA_BET_2
    value: "<size=22>Bet Level: Lv 1 to Lv 6\r\nPay: As Stated\r\nExtra Bet: 20% of
      Base Bet\n</size>"
  - key: PAYTABLE_DESCRIPTION_EXTRA_BET_3
    value: "<size=22>Bet Level: Lv 7 to Lv 9\r\nPay:         Pay x2 \r\nExtra Bet:
      40% of Base Bet\n</size>"
  - key: PAYTABLE_DESCRIPTION_EXTRA_BET_4
    value: "<size=22>Bet Level: Lv 10 ~ \r\nPay:         Pay x3\r\nExtra Bet: 60%
      of Base Bet\n</size>"
