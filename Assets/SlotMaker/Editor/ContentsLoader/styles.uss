.unity-scroll-view {
    flex:1 0 0;
}

.unity-box {
    flex:1 0 0;
    margin-top: 10px;
    margin-bottom: 10px;
    margin-right: 10px;
    margin-left: 10px;
}

.unity-popup-window {
    padding-left: 10px;
    padding-right: 10px;
    padding-bottom: 12px;
}

.element {
    flex: 1 1 100px;
    background-color: #555555;
    border-bottom-width: 1px;
    border-color: white;
    justify-content: center;
    align-items: center;
}

.element Label {
    background-color: #000000;
    color: #999999;
    -unity-text-align: middle-center;
    flex: 0 0 auto;
}

#labelSplash {
    -unity-background-image-tint-color: #94E7E7;
}

#labelFSM {
    -unity-background-image-tint-color: #94E7E7;
}

#labelBlackboard {
    -unity-background-image-tint-color: #7472F3;
}

#labelBase {
    -unity-background-image-tint-color: #65FF64;
}

#labelSlotMachine {
    -unity-background-image-tint-color: #FFBD00;
}

#gameTitle {
    margin-left: 4px;
    margin-top: 2px;
    margin-right: 4px;
    margin-bottom: 2px;
    border-color: #E4E4E4;
    border-width: 1px;
    border-radius: 5px;
    color: #E4E4E4;
    font-size: 9px;
    align-self: flex-start;
    -unity-text-align: middle-center;
}

#Develop {
    margin-left: 4px;
    margin-top: 2px;
    margin-right: 4px;
    margin-bottom: 2px;
    border-color: #FF1493;
    border-width: 1px;
    border-radius: 5px;
    color: #FF1493;
    font-size: 9px;
    align-self: flex-start;
    -unity-text-align: middle-center;
}

