  lane :get_latest_testflight_build_number do |options|
    versionNumber=get_version_number()
    UI.message "Version number is #{versionNumber}"

    latestBuildNumber = latest_testflight_build_number(
      app_identifier: "com.bagelcode.slots1",
      version: versionNumber
    )
    UI.message "Latest version is #{latestBuildNumber}"
  end

  lane :get_next_testflight_build_number do |options|
    versionNumber=get_version_number()
    UI.message "Version number is #{versionNumber}"

    nextBuildNumber = next_testflight_build_number(
      app_identifier: "com.bagelcode.slots1",
      version: versionNumber
    )
    UI.message "Next version is #{nextBuildNumber}"
  end

  lane :get_wait_for_build do |options|
    build = wait_for_build(
      app_identifier: "com.bagelcode.slots1",
      version: '22.1.3',
      version_number: 2
    )
    UI.message "wait_for_build returned:"
    UI.message build
  end

  desc "Hotfix Unity bug: modify Info.plist (CBFundleURLTypes for FacebookSDK)"
  lane :hotfix do
    facebook_plist_hotfix(
      plist_path: "Info.plist"
    )
  end

  desc "Runs all the tests"
  lane :test do
    scan
  end

  after_all do |lane|
    # This block is called, only if the executed lane was successful

    # slack(
    #   message: "Successfully deployed new App Update."
    # )
  end

  error do |lane, exception|
    # slack(
    #   message: exception.message,
    #   success: false
    # )
  end
end


