  lane :build_team do
    # Build
    my_build_app(
      # Certificate type
      match_type: "adhoc",
      codesign_identity: "iPhone Distribution", # "iPhone Developer",
      # Set the app id
      app_identifier: "com.bagelcode.v3proto",
      # Not a production release, so add build number to the icons
      release: false,
      # Change the app name
      app_name: "Club Vegas Team",
      # the projectname, this is the name of the .xcodeproj file and the folder containing your code in the project
